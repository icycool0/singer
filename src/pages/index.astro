---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>

			<!-- HERO -->
			<section class="hero">

				<img
					src="/images/hero live 3.jpg"
					alt="Roushan performing live"
					class="hero-image"
				/>

				<div class="hero-gradient"></div>

				<div class="hero-top">
					<span>ROUSHAN</span>
					<span>LIVE PERFORMANCE</span>
				</div>

				<div class="hero-content">

					<p class="eyebrow">
						SINGER • LIVE PERFORMER
					</p>

					<h1>
						ROUSHAN
					</h1>

					<p class="hero-description">
						Live music that becomes part of the memory.
					</p>

					<div class="hero-actions">
						<a href="#booking" class="button primary">
							BOOK ROUSHAN
						</a>

						<a href="#experience" class="watch-link">
							<span class="play">▶</span>
							<span>EXPLORE THE EXPERIENCE</span>
						</a>
					</div>

				</div>

				<div class="hero-bottom">
					<span>PATNA, INDIA</span>

					<span class="scroll">
						SCROLL TO EXPLORE
						<span class="line"></span>
					</span>
				</div>

			</section>


			<!-- INTRO -->
			<section class="intro" id="experience">

				<div class="intro-label">
					<span>01</span>
					<span>THE ARTIST</span>
				</div>

				<div class="intro-main">

					<h2>
						More than
						<br />
						<span>music.</span>
					</h2>

					<div class="intro-copy">

						<p class="lead">
							Roushan is a singer and live performer
							based in Patna, creating memorable
							musical experiences for weddings,
							celebrations and private events.
						</p>

						<p>
							From an intimate gathering to a large
							celebration, every performance is shaped
							around the atmosphere, audience and
							moment.
						</p>

						<a href="#booking" class="text-link">
							PLAN YOUR EVENT
							<span>→</span>
						</a>

					</div>

				</div>

			</section>


			<!-- LARGE FEATURE -->
			<section class="feature">

				<div class="feature-image">
					<img
						src="/images/hero live2.jpg"
						alt="Roushan performing live"
						loading="lazy"
					/>

					<div class="image-number">
						02 / LIVE
					</div>
				</div>

				<div class="feature-content">

					<p class="eyebrow">
						THE LIVE EXPERIENCE
					</p>

					<h2>
						Every event
						<br />
						deserves its
						<br />
						own soundtrack.
					</h2>

					<p>
						Live vocals, energy and an atmosphere
						built around your celebration.
					</p>

				</div>

			</section>


			<!-- SERVICES -->
			<section class="services">

				<div class="section-header">

					<div>
						<p class="eyebrow">03 / EVENTS</p>

						<h2>
							For moments
							<br />
							worth remembering.
						</h2>
					</div>

					<p class="section-intro">
						Choose the performance experience
						that fits your occasion.
					</p>

				</div>


				<div class="event-list">

					<a href="#booking" class="event-item">
						<span class="event-number">01</span>

						<div>
							<h3>Weddings</h3>
							<p>
								Sangeet, receptions and unforgettable
								wedding moments.
							</p>
						</div>

						<span class="event-arrow">↗</span>
					</a>


					<a href="#booking" class="event-item">
						<span class="event-number">02</span>

						<div>
							<h3>Private Events</h3>
							<p>
								Personalised live entertainment for
								private celebrations.
							</p>
						</div>

						<span class="event-arrow">↗</span>
					</a>


					<a href="#booking" class="event-item">
						<span class="event-number">03</span>

						<div>
							<h3>Birthdays</h3>
							<p>
								Make the celebration feel personal,
								energetic and memorable.
							</p>
						</div>

						<span class="event-arrow">↗</span>
					</a>


					<a href="#booking" class="event-item">
						<span class="event-number">04</span>

						<div>
							<h3>Corporate & Events</h3>
							<p>
								Professional live entertainment
								for special gatherings.
							</p>
						</div>

						<span class="event-arrow">↗</span>
					</a>

				</div>

			</section>


			<!-- VISUAL MOMENT -->
			<section class="visual-moment">

				<img
					src="/images/hero event.jpeg"
					alt="Roushan performing at an event"
					loading="lazy"
				/>

				<div class="visual-overlay"></div>

				<div class="visual-text">
					<p>LIVE • ENERGY • EMOTION</p>

					<h2>
						Feel the
						<br />
						moment.
					</h2>
				</div>

			</section>


			<!-- GALLERY -->
			<section class="gallery">

				<div class="gallery-header">

					<div>
						<p class="eyebrow">04 / GALLERY</p>

						<h2>
							On stage.
							<br />
							In the moment.
						</h2>
					</div>

					<p>
						A glimpse into Roushan's
						live performances and
						journey as an artist.
					</p>

				</div>


				<div class="gallery-grid">

					<div class="gallery-item gallery-large">
						<img
							src="/images/hero event standing.jpeg"
							alt="Roushan performing on stage"
							loading="lazy"
						/>
					</div>

					<div class="gallery-item">
						<img
							src="/images/hero standinf close.jpg"
							alt="Roushan portrait"
							loading="lazy"
						/>
					</div>

					<div class="gallery-item">
						<img
							src="/images/hero standing 2.jpg"
							alt="Roushan"
							loading="lazy"
						/>
					</div>

					<div class="gallery-item">
						<img
							src="/images/hero casula standing.jpeg"
							alt="Roushan portrait"
							loading="lazy"
						/>
					</div>

					<div class="gallery-item gallery-sofa">
						<img
							src="/images/hero sitting sofa.jpg"
							alt="Roushan portrait"
							loading="lazy"
						/>
					</div>

				</div>

			</section>


			<!-- VIDEO -->
			<section class="video-section">

				<div class="video-inner">

					<p class="eyebrow">
						05 / WATCH ROUSHAN
					</p>

					<h2>
						See him
						<br />
						<span>live.</span>
					</h2>

					<p>
						Performance videos coming soon.
					</p>

					<div class="video-placeholder">

						<div class="play-button">
							▶
						</div>

						<span>
							LIVE PERFORMANCE
						</span>

					</div>

				</div>

			</section>


			<!-- BOOKING -->
			<section class="booking" id="booking">

				<div class="booking-number">
					06 / BOOKING
				</div>

				<div class="booking-content">

					<p class="eyebrow">
						LET'S CREATE THE MOMENT
					</p>

					<h2>
						Have an event?
						<br />
						<span>Let's talk.</span>
					</h2>

					<p>
						Tell us your event date, location
						and occasion. We'll help you plan
						the right performance.
					</p>

					<div class="booking-actions">

						<a
							href="tel:+91955275669"
							class="button primary large"
						>
							CALL ROUSHAN
						</a>

						<a
							href="https://wa.me/91955275669"
							class="button whatsapp large"
						>
							WHATSAPP
						</a>

					</div>

				</div>

			</section>

		</main>

		<Footer />

	</body>
</html>


<style>

	/* ================================
	   BASE
	================================ */

	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		background: #090909;
		color: #f4f1eb;
		font-family:
			Inter,
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	:global(a) {
		color: inherit;
	}


	/* ================================
	   HEADER OVERRIDE
	================================ */

	:global(header) {
		position: absolute !important;
		top: 0;
		left: 0;
		right: 0;
		z-index: 20;
		background: transparent !important;
		box-shadow: none !important;
		color: white;
	}

	:global(header nav) {
		max-width: 1400px;
		margin: auto;
		padding: 25px 40px;
	}

	:global(header h2 a) {
		color: white !important;
		font-size: 15px !important;
		letter-spacing: .18em;
		text-transform: uppercase;
	}

	:global(header nav a) {
		color: rgba(255,255,255,.8) !important;
		border: 0 !important;
		font-size: 11px;
		letter-spacing: .12em;
		text-transform: uppercase;
	}

	:global(header .social-links) {
		display: none !important;
	}


	/* ================================
	   HERO
	================================ */

	.hero {
		position: relative;
		height: 100vh;
		min-height: 680px;
		overflow: hidden;
		display: flex;
		align-items: center;
	}

	.hero-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		transform: scale(1.03);
		animation: heroZoom 14s ease-out forwards;
	}

	@keyframes heroZoom {
		from {
			transform: scale(1.08);
		}
		to {
			transform: scale(1.02);
		}
	}

	.hero-gradient {
		position: absolute;
		inset: 0;

		background:
			linear-gradient(
				90deg,
				rgba(0,0,0,.88) 0%,
				rgba(0,0,0,.48) 48%,
				rgba(0,0,0,.12) 100%
			),
			linear-gradient(
				0deg,
				rgba(0,0,0,.72) 0%,
				transparent 55%
			);
	}

	.hero-top,
	.hero-bottom {
		position: absolute;
		left: 40px;
		right: 40px;
		display: flex;
		justify-content: space-between;
		font-size: 10px;
		letter-spacing: .18em;
		color: rgba(255,255,255,.65);
	}

	.hero-top {
		top: 100px;
	}

	.hero-bottom {
		bottom: 30px;
	}

	.hero-content {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: 1400px;
		margin: auto;
		padding: 100px 40px 60px;
	}

	.eyebrow {
		margin: 0 0 24px;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: .24em;
		color: #d4b06a;
		text-transform: uppercase;
	}

	.hero h1 {
		margin: 0;
		font-size: clamp(90px, 14vw, 210px);
		line-height: .78;
		font-weight: 800;
		letter-spacing: -.075em;
	}

	.hero-description {
		max-width: 500px;
		margin: 35px 0 0;
		font-size: clamp(18px, 2vw, 25px);
		line-height: 1.4;
		color: rgba(255,255,255,.8);
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 30px;
		margin-top: 40px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 16px 25px;
		text-decoration: none;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: .15em;
		text-transform: uppercase;
		transition:
			transform .3s ease,
			background .3s ease;
	}

	.button:hover {
		transform: translateY(-3px);
	}

	.primary {
		background: #d4b06a;
		color: #111;
	}

	.primary:hover {
		background: #ebcb8c;
	}

	.watch-link {
		display: flex;
		align-items: center;
		gap: 12px;
		text-decoration: none;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: .13em;
	}

	.play {
		width: 34px;
		height: 34px;
		border: 1px solid rgba(255,255,255,.5);
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-size: 9px;
		padding-left: 2px;
	}

	.scroll {
		display: flex;
		align-items: center;
		gap: 15px;
	}

	.line {
		width: 60px;
		height: 1px;
		background: rgba(255,255,255,.4);
	}


	/* ================================
	   INTRO
	================================ */

	.intro {
		max-width: 1400px;
		margin: auto;
		padding: 150px 40px;
	}

	.intro-label {
		display: flex;
		gap: 20px;
		font-size: 10px;
		letter-spacing: .2em;
		color: #777;
	}

	.intro-main {
		display: grid;
		grid-template-columns: 1.1fr .9fr;
		gap: 100px;
		margin-top: 70px;
	}

	.intro h2,
	.feature h2,
	.services h2,
	.gallery h2,
	.video-section h2,
	.booking h2 {
		margin: 0;
		font-size: clamp(55px, 7vw, 105px);
		line-height: .9;
		letter-spacing: -.06em;
		font-weight: 700;
	}

	.intro h2 span,
	.video-section h2 span,
	.booking h2 span {
		color: #d4b06a;
	}

	.intro-copy {
		max-width: 520px;
		padding-top: 10px;
	}

	.intro-copy p {
		margin: 0 0 28px;
		color: #8f8f8f;
		font-size: 17px;
		line-height: 1.8;
	}

	.intro-copy .lead {
		color: #dedbd4;
		font-size: 20px;
		line-height: 1.65;
	}

	.text-link {
		display: inline-flex;
		gap: 18px;
		margin-top: 15px;
		color: #d4b06a;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: .16em;
		text-decoration: none;
	}

	.text-link span {
		font-size: 16px;
	}


	/* ================================
	   FEATURE
	================================ */

	.feature {
		display: grid;
		grid-template-columns: 1.35fr .65fr;
		min-height: 750px;
		background: #111;
	}

	.feature-image {
		position: relative;
		overflow: hidden;
	}

	.feature-image img {
		width: 100%;
		height: 100%;
		min-height: 700px;
		object-fit: cover;
		transition: transform 1s ease;
	}

	.feature:hover .feature-image img {
		transform: scale(1.025);
	}

	.image-number {
		position: absolute;
		left: 30px;
		bottom: 30px;
		font-size: 10px;
		letter-spacing: .18em;
		color: rgba(255,255,255,.65);
	}

	.feature-content {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 80px;
	}

	.feature-content h2 {
		font-size: clamp(48px, 5vw, 75px);
		margin-bottom: 35px;
	}

	.feature-content > p:last-child {
		max-width: 400px;
		color: #888;
		font-size: 16px;
		line-height: 1.8;
	}


	/* ================================
	   SERVICES
	================================ */

	.services {
		max-width: 1400px;
		margin: auto;
		padding: 150px 40px;
	}

	.section-header {
		display: grid;
		grid-template-columns: 1fr 350px;
		gap: 80px;
		align-items: end;
	}

	.services h2 {
		font-size: clamp(50px, 6vw, 85px);
	}

	.section-intro {
		margin: 0;
		color: #777;
		font-size: 15px;
		line-height: 1.7;
	}

	.event-list {
		margin-top: 80px;
		border-top: 1px solid #282828;
	}

	.event-item {
		display: grid;
		grid-template-columns: 90px 1fr 60px;
		align-items: center;
		gap: 30px;
		padding: 38px 10px;
		border-bottom: 1px solid #282828;
		text-decoration: none;
		transition: padding .35s ease;
	}

	.event-item:hover {
		padding-left: 25px;
		padding-right: 25px;
	}

	.event-number {
		font-size: 10px;
		letter-spacing: .15em;
		color: #d4b06a;
	}

	.event-item h3 {
		margin: 0 0 8px;
		font-size: 30px;
		font-weight: 500;
	}

	.event-item p {
		margin: 0;
		color: #777;
		font-size: 14px;
	}

	.event-arrow {
		text-align: right;
		color: #d4b06a;
		font-size: 20px;
	}


	/* ================================
	   VISUAL MOMENT
	================================ */

	.visual-moment {
		position: relative;
		height: 80vh;
		min-height: 600px;
		overflow: hidden;
	}

	.visual-moment img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.visual-overlay {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				0deg,
				rgba(0,0,0,.8),
				transparent 65%
			);
	}

	.visual-text {
		position: absolute;
		left: 40px;
		bottom: 50px;
	}

	.visual-text p {
		margin: 0 0 20px;
		font-size: 10px;
		letter-spacing: .25em;
		color: #d4b06a;
	}

	.visual-text h2 {
		margin: 0;
		font-size: clamp(70px, 10vw, 150px);
		line-height: .8;
		letter-spacing: -.07em;
	}


	/* ================================
	   GALLERY
	================================ */

	.gallery {
		max-width: 1400px;
		margin: auto;
		padding: 150px 40px;
	}

	.gallery-header {
		display: grid;
		grid-template-columns: 1fr 350px;
		gap: 80px;
		align-items: end;
	}

	.gallery-header > p {
		margin: 0;
		color: #777;
		font-size: 15px;
		line-height: 1.7;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: 1.25fr .75fr .75fr;
		grid-auto-rows: 310px;
		gap: 10px;
		margin-top: 80px;
	}

	.gallery-item {
		overflow: hidden;
		background: #111;
	}

	.gallery-item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform .8s cubic-bezier(.2,.7,.2,1);
	}

	.gallery-item:hover img {
		transform: scale(1.04);
	}

	.gallery-large {
		grid-row: span 2;
	}

	.gallery-sofa {
		grid-column: span 2;
	}


	/* ================================
	   VIDEO
	================================ */

	.video-section {
		background: #111;
		padding: 150px 40px;
	}

	.video-inner {
		max-width: 1200px;
		margin: auto;
	}

	.video-section h2 {
		font-size: clamp(65px, 9vw, 125px);
	}

	.video-section p:not(.eyebrow) {
		color: #777;
		margin: 30px 0 50px;
	}

	.video-placeholder {
		height: 500px;
		position: relative;
		display: grid;
		place-items: center;
		background:
			linear-gradient(
				135deg,
				#171717,
				#0c0c0c
			);
		border: 1px solid #282828;
	}

	.play-button {
		width: 80px;
		height: 80px;
		border: 1px solid rgba(255,255,255,.5);
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-size: 18px;
		padding-left: 4px;
		transition: transform .3s ease;
	}

	.video-placeholder:hover .play-button {
		transform: scale(1.1);
	}

	.video-placeholder span {
		position: absolute;
		left: 25px;
		bottom: 20px;
		font-size: 9px;
		letter-spacing: .2em;
		color: #777;
	}


	/* ================================
	   BOOKING
	================================ */

	.booking {
		position: relative;
		padding: 180px 40px;
		background: #d4b06a;
		color: #111;
	}

	.booking-number {
		position: absolute;
		top: 35px;
		left: 40px;
		font-size: 10px;
		letter-spacing: .2em;
		opacity: .55;
	}

	.booking-content {
		max-width: 1200px;
		margin: auto;
	}

	.booking .eyebrow {
		color: #111;
		opacity: .6;
	}

	.booking h2 {
		font-size: clamp(65px, 9vw, 130px);
	}

	.booking h2 span {
		color: #111;
		opacity: .45;
	}

	.booking-content > p:not(.eyebrow) {
		max-width: 520px;
		font-size: 18px;
		line-height: 1.7;
		margin: 40px 0;
		color: rgba(0,0,0,.65);
	}

	.booking-actions {
		display: flex;
		gap: 12px;
	}

	.booking .primary {
		background: #111;
		color: white;
	}

	.whatsapp {
		border: 1px solid rgba(0,0,0,.35);
		color: #111;
	}

	.large {
