---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Singer Roushan | Live Singer & Event Performer"
			description="Book Singer Roushan for weddings, birthdays, private parties, corporate events and live music performances in Patna and beyond."
		/>
	</head>

	<body>
		<Header />

		<main>
			<!-- HERO -->
			<section class="hero">
				<div class="hero-content">
					<p class="eyebrow">LIVE SINGER • EVENT PERFORMER</p>

					<h1>
						Make Your Event
						<span>Sound Unforgettable.</span>
					</h1>

					<p class="hero-text">
						Live music for weddings, birthdays, private parties,
						corporate events and special celebrations.
					</p>

					<div class="hero-actions">
						<a href="#booking" class="button primary">Book Roushan</a>
						<a href="#performances" class="button secondary">Watch Performance</a>
					</div>

					<p class="location">📍 Patna, Bihar • Available for Events</p>
				</div>

				<div class="hero-card">
					<div class="artist-placeholder">
						<div class="music-icon">♪</div>
						<p>ROUSHAN</p>
						<span>LIVE PERFORMANCE</span>
					</div>
				</div>
			</section>

			<!-- SERVICES -->
			<section class="section" id="services">
				<div class="section-heading">
					<p class="eyebrow">WHAT I DO</p>
					<h2>Live Music for Every Occasion</h2>
					<p>
						Choose the performance that fits your event.
						Custom arrangements are available for larger events.
					</p>
				</div>

				<div class="service-grid">
					<article class="service-card">
						<div class="icon">💍</div>
						<h3>Wedding Events</h3>
						<p>
							Live singing to create the right atmosphere
							for wedding celebrations and special moments.
						</p>
					</article>

					<article class="service-card">
						<div class="icon">🎂</div>
						<h3>Birthday Parties</h3>
						<p>
							Make birthdays more memorable with a live
							music performance for your guests.
						</p>
					</article>

					<article class="service-card">
						<div class="icon">🎉</div>
						<h3>Private Events</h3>
						<p>
							Entertainment for parties, family functions
							and private celebrations.
						</p>
					</article>

					<article class="service-card">
						<div class="icon">🏢</div>
						<h3>Corporate Events</h3>
						<p>
							Professional live entertainment for corporate
							gatherings and special occasions.
						</p>
					</article>

					<article class="service-card">
						<div class="icon">🎤</div>
						<h3>Live Performances</h3>
						<p>
							Solo singing and customised live performance
							options based on your event.
						</p>
					</article>

					<article class="service-card">
						<div class="icon">🎶</div>
						<h3>Special Events</h3>
						<p>
							Talk to us about your event and we'll suggest
							the most suitable performance setup.
						</p>
					</article>
				</div>
			</section>

			<!-- ABOUT -->
			<section class="about section">
				<div class="about-content">
					<p class="eyebrow">MEET ROUSHAN</p>
					<h2>Music That Connects With People</h2>

					<p>
						Singer Roushan is a performer and digital creator
						based in Patna, Bihar, offering live singing and
						event entertainment for different types of occasions.
					</p>

					<p>
						Whether you're planning an intimate celebration or
						a larger event, the performance can be discussed
						according to your venue, audience and requirements.
					</p>

					<a href="#booking" class="text-link">Plan Your Event →</a>
				</div>

				<div class="about-stat">
					<strong>ROUSHAN</strong>
					<span>SINGER & PERFORMER</span>
				</div>
			</section>

			<!-- PERFORMANCE -->
			<section class="section dark-section" id="performances">
				<div class="section-heading">
					<p class="eyebrow">PERFORMANCES</p>
					<h2>Hear the Artist</h2>
					<p>
						Watch performances and discover Roushan's music.
					</p>
				</div>

				<div class="video-placeholder">
					<div class="play">▶</div>
					<h3>Performance Videos</h3>
					<p>
						YouTube and social media performances will appear here.
					</p>
				</div>
			</section>

			<!-- PACKAGES -->
			<section class="section" id="packages">
				<div class="section-heading">
					<p class="eyebrow">BOOKING</p>
					<h2>Performance Packages</h2>
					<p>
						Every event is different. Tell us what you're planning
						and we'll help determine the right setup.
					</p>
				</div>

				<div class="package-grid">
					<article class="package-card">
						<p class="package-label">STARTING FROM</p>
						<h3>₹10,000</h3>
						<p>
							Solo singer performance. Final pricing depends
							on event requirements, location and duration.
						</p>
						<a href="#booking" class="button primary">Enquire Now</a>
					</article>

					<article class="package-card featured">
						<p class="package-label">CUSTOM EVENT</p>
						<h3>Need a Bigger Setup?</h3>
						<p>
							For weddings, large celebrations and full
							music setups, discuss your requirements directly.
						</p>
						<a href="#booking" class="button secondary">Get a Quote</a>
					</article>
				</div>
			</section>

			<!-- AI ADVISOR PLACEHOLDER -->
			<section class="advisor-section">
				<div>
					<p class="eyebrow">SMART BOOKING</p>
					<h2>Not Sure What You Need?</h2>
					<p>
						Our AI Booking Advisor can help you plan the right
						performance for your event.
					</p>
				</div>

				<button class="advisor-button" type="button">
					🤖 Ask the Booking Advisor
				</button>
			</section>

			<!-- BOOKING -->
			<section class="booking section" id="booking">
				<div class="section-heading">
					<p class="eyebrow">LET'S TALK</p>
					<h2>Planning an Event?</h2>
					<p>
						Tell us about your event and we'll get back to you
						with the best performance option.
					</p>
				</div>

				<div class="booking-actions">
					<a href="tel:+91955275669" class="button primary">
						📞 Call Roushan
					</a>

					<a
						href="https://wa.me/91955275669"
						class="button whatsapp"
						target="_blank"
						rel="noopener noreferrer"
					>
						💬 WhatsApp
					</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system,
			BlinkMacSystemFont, "Segoe UI", sans-serif;
		color: #171717;
		background: #faf9f7;
	}

	main {
		overflow: hidden;
	}

	.hero {
		min-height: 720px;
		padding: 90px 7vw;
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: 60px;
		align-items: center;
		background:
			radial-gradient(circle at 80% 30%, #f4d6b8 0, transparent 30%),
			linear-gradient(135deg, #fffaf5, #f4eee7);
	}

	.hero-content {
		max-width: 700px;
	}

	.eyebrow {
		margin: 0 0 18px;
		font-size: 13px;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: #9a5a32;
	}

	h1 {
		margin: 0;
		font-size: clamp(48px, 7vw, 88px);
		line-height: 0.98;
		letter-spacing: -0.055em;
	}

	h1 span {
		display: block;
		color: #9a5a32;
	}

	.hero-text {
		max-width: 600px;
		margin: 28px 0;
		font-size: 20px;
		line-height: 1.6;
		color: #555;
	}

	.location {
		margin-top: 25px;
		color: #666;
		font-size: 14px;
	}

	.hero-actions,
	.booking-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
	}

	.button {
		display: inline-block;
		padding: 15px 23px;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 750;
		transition: transform 0.2s ease;
	}

	.button:hover {
		transform: translateY(-2px);
	}

	.primary {
		background: #171717;
		color: white;
	}

	.secondary {
		border: 1px solid #bbb;
		color: #171717;
		background: white;
	}

	.whatsapp {
		background: #1f9d55;
		color: white;
	}

	.hero-card {
		min-height: 570px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.artist-placeholder {
		width: min(440px, 90%);
		aspect-ratio: 4 / 5;
		border-radius: 28px;
		background:
			linear-gradient(145deg, #242424, #080808);
		color: white;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		box-shadow: 0 30px 80px rgba(0, 0, 0, 0.22);
	}

	.music-icon {
		font-size: 90px;
		line-height: 1;
		margin-bottom: 20px;
	}

	.artist-placeholder p {
		margin: 0;
		font-size: 34px;
		font-weight: 900;
		letter-spacing: 0.08em;
	}

	.artist-placeholder span {
		margin-top: 8px;
		font-size: 12px;
		letter-spacing: 0.2em;
		color: #ccc;
	}

	.section {
		padding: 110px 7vw;
	}

	.section-heading {
		max-width: 720px;
		margin-bottom: 55px;
	}

	h2 {
		margin: 0 0 18px;
		font-size: clamp(36px, 5vw, 60px);
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.section-heading > p:last-child {
		color: #666;
		font-size: 18px;
		line-height: 1.6;
	}

	.service-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 18px;
	}

	.service-card {
		padding: 32px;
		background: white;
		border: 1px solid #e8e4df;
		border-radius: 20px;
	}

	.service-card .icon {
		font-size: 30px;
		margin-bottom: 25px;
	}

	.service-card h3 {
		margin: 0 0 12px;
		font-size: 21px;
	}

	.service-card p {
		margin: 0;
		color: #666;
		line-height: 1.6;
	}

	.about {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 80px;
		align-items: center;
		background: #eee9e3;
	}

	.about-content {
		max-width: 650px;
	}

	.about-content p:not(.eyebrow) {
		color: #555;
		line-height: 1.75;
		font-size: 17px;
	}

	.text-link {
		display: inline-block;
		margin-top: 15px;
		color: #9a5a32;
		font-weight: 800;
		text-decoration: none;
	}

	.about-stat {
		min-height: 350px;
		border-radius: 30px;
		background: #171717;
		color: white;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.about-stat strong {
		font-size: clamp(50px, 7vw, 90px);
		letter-spacing: -0.05em;
	}

	.about-stat span {
		margin-top: 10px;
		letter-spacing: 0.2em;
		color: #aaa;
		font-size: 12px;
	}

	.dark-section {
		background: #111;
		color: white;
	}

	.dark-section .section-heading > p:last-child {
		color: #aaa;
	}

	.video-placeholder {
		min-height: 420px;
		border-radius: 28px;
		border: 1px solid #333;
		background: #1c1c1c;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
	}

	.video-placeholder .play {
		width: 75px;
		height: 75px;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: white;
		color: #111;
		margin-bottom: 20px;
	}

	.video-placeholder h3 {
		font-size: 25px;
		margin: 0 0 8px;
	}

	.video-placeholder p {
		color: #aaa;
	}

	.package-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 20px;
	}

	.package-card {
		padding: 42px;
		border: 1px solid #ded9d2;
		border-radius: 24px;
		background: white;
	}

	.package-card.featured {
		background: #171717;
		color: white;
		border-color: #171717;
	}

	.package-label {
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.15em;
		color: #9a5a32;
	}

	.package-card h3 {
		font-size: 40px;
		margin: 15px 0;
	}

	.package-card > p:not(.package-label) {
		line-height: 1.7;
		color: #666;
		margin-bottom: 30px;
	}

	.featured > p:not(.package-label) {
		color: #bbb;
	}

	.advisor-section {
		padding: 70px 7vw;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 40px;
		background: #9a5a32;
		color: white;
	}

	.advisor-section .eyebrow {
		color: #f5d7c1;
	}

	.advisor-section h2 {
		margin-bottom: 12px;
	}

	.advisor-section p:last-child {
		margin: 0;
		color: #f4dfd0;
		font-size: 17px;
	}

	.advisor-button {
		border: 0;
		border-radius: 999px;
		padding: 17px 25px;
		font: inherit;
		font-weight: 800;
		background: white;
		color: #171717;
		cursor: pointer;
		white-space: nowrap;
	}

	.booking {
		text-align: center;
	}

	.booking .section-heading {
		margin-left: auto;
		margin-right: auto;
	}

	.booking-actions {
		justify-content: center;
	}

	@media (max-width: 850px) {
		.hero,
		.about {
			grid-template-columns: 1fr;
		}

		.hero {
			padding-top: 60px;
		}

		.hero-card {
			min-height: auto;
		}

		.service-grid {
			grid-template-columns: 1fr 1fr;
		}

		.package-grid {
			grid-template-columns: 1fr;
		}

		.advisor-section {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	@media (max-width: 550px) {
		.section,
		.hero {
			padding-left: 22px;
			padding-right: 22px;
		}

		.service-grid {
			grid-template-columns: 1fr;
		}

		.hero {
			min-height: auto;
		}

		.hero-card {
			display: none;
		}

		.hero-text {
			font-size: 17px;
		}

		.button {
			width: 100%;
			text-align: center;
		}
	}
</style>
