---
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="en">
<head>

	<BaseHead
		title="Roushan | Singer & Live Performer in Patna"
		description="Roushan is a singer and live performer in Patna, available for weddings, events, birthdays, corporate occasions and private celebrations."
	/>

	<style>

		/* =====================================================
		   DESIGN SYSTEM
		===================================================== */

		:root {
			--bg: #08090b;
			--surface: #101114;
			--surface-light: #16171b;

			--white: #f5f2eb;
			--muted: #aaa8a2;

			--gold: #d5b16f;
			--gold-light: #e5ca91;

			--line: rgba(255,255,255,.10);

			--max: 1280px;
		}


		/* =====================================================
		   RESET
		===================================================== */

		* {
			box-sizing: border-box;
		}

		html {
			scroll-behavior: smooth;
		}

		body {
			margin: 0;
			padding: 0;
			background: var(--bg);
			color: var(--white);

			font-family:
				Inter,
				Arial,
				Helvetica,
				sans-serif;

			-webkit-font-smoothing: antialiased;
		}

		a {
			color: inherit;
		}

		img {
			display: block;
			max-width: 100%;
		}


		/* =====================================================
		   NAVIGATION
		===================================================== */

		.nav {
			position: absolute;
			z-index: 50;

			top: 0;
			left: 0;

			width: 100%;

			padding: 28px 5vw;
		}

		.nav-inner {
			width: min(var(--max), 100%);
			margin: auto;

			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		.logo {
			text-decoration: none;

			font-size: 18px;
			font-weight: 800;

			letter-spacing: .15em;
		}

		.logo span {
			color: var(--gold);
		}

		.nav-links {
			display: flex;
			align-items: center;

			gap: 30px;
		}

		.nav-links a {
			text-decoration: none;

			font-size: 11px;
			font-weight: 700;

			letter-spacing: .14em;

			color: rgba(255,255,255,.82);

			transition:
				opacity .25s ease,
				background .25s ease,
				color .25s ease;
		}

		.nav-links a:hover {
			opacity: .6;
		}

		.nav-book {
			padding: 11px 17px;

			border: 1px solid rgba(255,255,255,.35);
		}


		/* =====================================================
		   HERO
		===================================================== */

		.hero {
			position: relative;

			height: 90vh;
			min-height: 680px;

			overflow: hidden;

			display: flex;
			align-items: center;
		}

		.hero-image {
			position: absolute;

			inset: 0;

			width: 100%;
			height: 100%;

			object-fit: cover;

			object-position: center 30%;

			transform: scale(1.015);
		}

		.hero-overlay {
			position: absolute;

			inset: 0;

			background:
				linear-gradient(
					90deg,
					rgba(4,5,7,.94) 0%,
					rgba(4,5,7,.72) 35%,
					rgba(4,5,7,.28) 70%,
					rgba(4,5,7,.35) 100%
				),

				linear-gradient(
					0deg,
					rgba(4,5,7,.86),
					transparent 60%
				);
		}

		.hero-content {
			position: relative;
			z-index: 5;

			width: min(var(--max), 90%);

			margin: 25px auto 0;
		}

		.eyebrow {
			margin: 0 0 20px;

			color: var(--gold);

			font-size: 10px;
			font-weight: 800;

			letter-spacing: .25em;
		}

		.hero h1 {
			margin: 0;

			max-width: 800px;

			font-size: clamp(80px, 12vw, 175px);

			line-height: .78;

			letter-spacing: -.075em;

			font-weight: 850;
		}

		.hero-subtitle {
			max-width: 570px;

			margin: 38px 0 0;

			color: rgba(255,255,255,.84);

			font-size: clamp(18px, 2vw, 24px);

			line-height: 1.5;
		}

		.hero-buttons {
			display: flex;

			gap: 12px;

			margin-top: 30px;
		}

		.button {
			display: inline-flex;

			align-items: center;
			justify-content: center;

			min-height: 48px;

			padding: 0 23px;

			text-decoration: none;

			font-size: 10px;
			font-weight: 800;

			letter-spacing: .15em;

			transition:
				transform .25s ease,
				background .25s ease,
				color .25s ease;
		}

		.button:hover {
			transform: translateY(-2px);
		}

		.button-primary {
			background: var(--gold);

			color: #111;
		}

		.button-primary:hover {
			background: var(--gold-light);
		}

		.button-outline {
			border: 1px solid rgba(255,255,255,.55);

			color: white;
		}

		.button-outline:hover {
			background: white;

			color: #111;
		}

		.hero-location {
			position: absolute;

			right: 5vw;
			bottom: 28px;

			z-index: 5;

			color: rgba(255,255,255,.52);

			font-size: 9px;
			letter-spacing: .2em;
		}


		/* =====================================================
		   COMMON SECTIONS
		===================================================== */

		.section {
			width: min(var(--max), 90%);

			margin: auto;

			padding: 125px 0;
		}

		.label {
			margin: 0 0 16px;

			color: var(--gold);

			font-size: 10px;
			font-weight: 800;

			letter-spacing: .25em;

			text-transform: uppercase;
		}

		.section-title {
			margin: 0;

			max-width: 850px;

			font-size: clamp(43px, 6vw, 78px);

			line-height: .95;

			letter-spacing: -.055em;

			font-weight: 750;
		}


		/* =====================================================
		   YOUTUBE / CINEMATIC VIDEO
		===================================================== */

		.cinematic {
			width: min(1180px, 90%);

			margin: auto;

			padding: 100px 0 125px;
		}

		.cinematic-header {
			display: flex;

			align-items: flex-end;
			justify-content: space-between;

			gap: 50px;

			margin-bottom: 32px;
		}

		.cinematic-note {
			max-width: 350px;

			margin: 0;

			color: var(--muted);

			font-size: 14px;

			line-height: 1.7;
		}

		.youtube-frame {
			position: relative;

			width: 100%;

			aspect-ratio: 16 / 9;

			overflow: hidden;

			background: #000;

			box-shadow:
				0 30px 90px rgba(0,0,0,.38);
		}

		.youtube-frame iframe {
			position: absolute;

			inset: 0;

			width: 100%;
			height: 100%;

			border: 0;
		}


		/* =====================================================
		   ARTIST INTRO
		===================================================== */

		.artist {
			display: grid;

			grid-template-columns: 1fr 1fr;

			gap: 100px;

			align-items: start;
		}

		.artist-copy {
			max-width: 560px;

			margin-left: auto;

			padding-top: 15px;
		}

		.artist-copy p {
			margin: 0;

			color: var(--muted);

			font-size: 18px;

			line-height: 1.8;
		}

		.artist-line {
			width: 70px;
			height: 1px;

			margin: 30px 0;

			background: var(--gold);
		}


		/* =====================================================
		   PERFORMANCE SECTION
		===================================================== */

		.experience-intro {
			display: grid;

			grid-template-columns: 1.3fr .7fr;

			gap: 80px;

			align-items: end;

			margin-bottom: 55px;
		}

		.experience-note {
			margin: 0;

			color: var(--muted);

			font-size: 15px;

			line-height: 1.7;
		}

		.performance-grid {
			display: grid;

			grid-template-columns: 1fr 1fr;

			gap: 2px;

			background: var(--line);
		}

		.performance-card {
			position: relative;

			min-height: 390px;

			overflow: hidden;

			background: var(--surface);
		}

		.performance-card img {
			position: absolute;

			inset: 0;

			width: 100%;
			height: 100%;

			object-fit: cover;

			opacity: .62;

			transition:
				transform .8s ease,
				opacity .6s ease;
		}

		.performance-card:hover img {
			transform: scale(1.045);

			opacity: .72;
		}

		.performance-card::after {
			content: "";

			position: absolute;

			inset: 0;

			background:
				linear-gradient(
					0deg,
					rgba(5,5,6,.96),
					rgba(5,5,6,.08) 75%
				);
		}

		.performance-content {
			position: absolute;

			z-index: 3;

			left: 30px;
			right: 30px;
			bottom: 28px;
		}

		.performance-number {
			display: block;

			margin-bottom: 15px;

			color: var(--gold);

			font-size: 10px;
			font-weight: 800;

			letter-spacing: .2em;
		}

		.performance-icon {
			position: absolute;

			z-index: 4;

			top: 25px;
			right: 27px;

			width: 44px;
			height: 44px;

			border: 1px solid rgba(255,255,255,.32);

			border-radius: 50%;

			display: grid;
			place-items: center;

			color: white;

			font-size: 17px;
		}

		.performance-card h3 {
			margin: 0 0 8px;

			font-size: 31px;

			letter-spacing: -.035em;
		}

		.performance-card p {
			max-width: 410px;

			margin: 0;

			color: rgba(255,255,255,.7);

			font-size: 14px;

			line-height: 1.65;
		}


		/* =====================================================
		   LIVE EXPERIENCE FEATURE
		===================================================== */

		.feature {
			display: grid;

			grid-template-columns: 1.2fr .8fr;

			min-height: 680px;
		}

		.feature-image {
			width: 100%;
			height: 100%;

			min-height: 620px;

			object-fit: cover;
		}

		.feature-copy {
			display: flex;

			flex-direction: column;

			justify-content: center;

			padding: 80px;

			background: var(--surface-light);
		}

		.feature-copy h2 {
			margin: 0 0 28px;

			font-size: clamp(43px, 5vw, 68px);

			line-height: .95;

			letter-spacing: -.055em;
		}

		.feature-copy p {
			margin: 0;

			color: var(--muted);

			font-size: 16px;

			line-height: 1.8;
		}

		.feature-link {
			margin-top: 30px;

			color: var(--gold);

			font-size: 11px;
			font-weight: 800;

			letter-spacing: .12em;

			text-decoration: none;
		}


		/* =====================================================
		   GALLERY
		===================================================== */

		.gallery-heading {
			margin-bottom: 45px;
		}

		.gallery-grid {
			display: grid;

			grid-template-columns: 1.5fr 1fr 1fr;

			grid-template-rows: 300px 300px;

			gap: 10px;
		}

		.gallery-item {
			overflow: hidden;

			background: var(--surface);
		}

		.gallery-item:first-child {
			grid-row: span 2;
		}

		.gallery-item img {
			width: 100%;
			height: 100%;

			object-fit: cover;

			transition: transform .8s ease;
		}

		.gallery-item:hover img {
			transform: scale(1.04);
		}


		/* =====================================================
		   BOOKING
		===================================================== */

		.booking {
			padding: 150px 20px 170px;

			text-align: center;

			border-top: 1px solid var(--line);
		}

		.booking .section-title {
			margin: auto;
		}

		.booking-text {
			max-width: 600px;

			margin: 28px auto 36px;

			color: var(--muted);

			font-size: 17px;

			line-height: 1.75;
		}

		.booking-actions {
			display: flex;

			justify-content: center;

			gap: 12px;
		}


		/* =====================================================
		   FOOTER
		===================================================== */

		.footer {
			border-top: 1px solid var(--line);

			padding: 30px 5vw;
		}

		.footer-inner {
			width: min(var(--max), 100%);

			margin: auto;

			display: flex;

			align-items: center;
			justify-content: space-between;

			gap: 25px;

			color: #707176;

			font-size: 10px;

			letter-spacing: .08em;
		}

		.footer-brand {
			color: white;

			font-weight: 800;

			letter-spacing: .16em;
		}


		/* =====================================================
		   TABLET / MOBILE
		===================================================== */

		@media (max-width: 800px) {

			.nav {
				padding: 20px 22px;
			}

			.nav-links {
				display: none;
			}

			.hero {
				height: 86vh;

				min-height: 650px;
			}

			.hero-content {
				width: calc(100% - 44px);

				margin-top: 30px;
			}

			.hero h1 {
				font-size: clamp(72px, 21vw, 120px);

				max-width: 100%;
			}

			.hero-subtitle {
				margin-top: 28px;

				font-size: 17px;
			}

			.hero-location {
				right: 22px;
				bottom: 20px;
			}

			.section {
				width: calc(100% - 44px);

				padding: 85px 0;
			}

			.cinematic {
				width: calc(100% - 44px);

				padding: 75px 0 90px;
			}

			.cinematic-header {
				display: block;
			}

			.cinematic-note {
				margin-top: 20px;
			}

			.youtube-frame {
				aspect-ratio: 16 / 9;
			}

			.artist {
				grid-template-columns: 1fr;

				gap: 35px;
			}

			.artist-copy {
				margin: 0;
			}

			.experience-intro {
				grid-template-columns: 1fr;

				gap: 25px;
			}

			.performance-grid {
				grid-template-columns: 1fr;
			}

			.performance-card {
				min-height: 360px;
			}

			.feature {
				grid-template-columns: 1fr;
			}

			.feature-image {
				min-height: 480px;
			}

			.feature-copy {
				padding: 60px 25px;
			}

			.gallery-grid {
				grid-template-columns: 1fr 1fr;

				grid-template-rows:
					250px
					250px
					250px;
			}

			.gallery-item:first-child {
				grid-row: span 1;
			}

			.booking {
				padding: 100px 22px 120px;
			}

			.booking-actions {
				flex-direction: column;

				align-items: stretch;

				max-width: 260px;

				margin: auto;
			}

			.footer-inner {
				flex-direction: column;

				align-items: flex-start;

				gap: 12px;
			}
		}


		/* =====================================================
		   SMALL MOBILE
		===================================================== */

		@media (max-width: 500px) {

			.hero-buttons {
				flex-direction: column;

				align-items: stretch;

				max-width: 235px;
			}

			.button {
				width: 100%;
			}

			.performance-card {
				min-height: 330px;
			}

			.gallery-grid {
				grid-template-columns: 1fr;

				grid-template-rows:
					repeat(5, 320px);
			}

			.gallery-item:first-child {
				grid-row: span 1;
			}

		}

	</style>

</head>


<body>


	<!-- =====================================================
	     NAVIGATION
	===================================================== -->

	<header class="nav">

		<div class="nav-inner">

			<a
				href="/"
				class="logo"
			>
				ROUSHAN<span>.</span>
			</a>

			<nav class="nav-links">

				<a href="#about">
					ABOUT
				</a>

				<a href="#experience">
					EXPERIENCE
				</a>

				<a href="#gallery">
					GALLERY
				</a>

				<a
					href="#booking"
					class="nav-book"
				>
					BOOK NOW
				</a>

			</nav>

		</div>

	</header>



	<main>


		<!-- =================================================
		     HERO
		================================================= -->

		<section class="hero">

			<img
				class="hero-image"
				src="/hero_live3.jpg"
				alt="Roushan performing live on stage"
				fetchpriority="high"
			/>

			<div class="hero-overlay"></div>


			<div class="hero-content">

				<p class="eyebrow">
					SINGER • LIVE PERFORMER • PATNA
				</p>

				<h1>
					ROUSHAN
				</h1>

				<p class="hero-subtitle">
					Live music for weddings, celebrations
					and unforgettable events.
				</p>


				<div class="hero-buttons">

					<a
						href="#booking"
						class="button button-primary"
					>
						BOOK ROUSHAN
					</a>

					<a
						href="#experience"
						class="button button-outline"
					>
						EXPLORE
					</a>

				</div>

			</div>


			<div class="hero-location">
				PATNA · BIHAR · INDIA
			</div>

		</section>



		<!-- =================================================
		     YOUTUBE VIDEO
		================================================= -->

		<section
			class="cinematic"
			id="video"
		>

			<div class="cinematic-header">

				<div>

					<p class="label">
						ROUSHAN LIVE
					</p>

					<h2 class="section-title">
						Feel the performance.
					</h2>

				</div>


				<p class="cinematic-note">
					Experience the voice, energy and
					atmosphere behind Roushan's live
					performance.
				</p>

			</div>


			<div class="youtube-frame">

				<iframe
					src="https://www.youtube-nocookie.com/embed/RrjtsRxXmGI?rel=0"
					title="Roushan Live Performance"
					loading="lazy"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					allowfullscreen
				></iframe>

			</div>

		</section>



		<!-- =================================================
		     ARTIST
		================================================= -->

		<section
			class="section artist"
			id="about"
		>

			<div>

				<p class="label">
					THE ARTIST
				</p>

				<h2 class="section-title">
					Music that makes
					the moment.
				</h2>

			</div>


			<div class="artist-copy">

				<p>
					Roushan is a singer and live performer
					based in Patna, bringing music, energy
					and a personal touch to weddings,
					events, birthdays, celebrations and
					private occasions.
				</p>


				<div class="artist-line"></div>


				<p>
					From intimate gatherings to energetic
					live events, every performance is shaped
					around the atmosphere of the occasion.
				</p>

			</div>

		</section>



		<!-- =================================================
		     PERFORMANCE TYPES
		================================================= -->

		<section
			class="section"
			id="experience"
		>

			<div class="experience-intro">

				<div>

					<p class="label">
						PERFORMANCES
					</p>

					<h2 class="section-title">
						Available for
						your special moments.
					</h2>

				</div>


				<p class="experience-note">
					Choose the kind of occasion and
					we'll shape the performance around
					the atmosphere you want.
				</p>

			</div>



			<div class="performance-grid">


				<!-- WEDDINGS -->

				<article class="performance-card">

					<img
						src="/hero_casula_standing.jpg"
						alt="Roushan available for wedding performances"
						loading="lazy"
					/>

					<div class="performance-icon">
						♡
					</div>

					<div class="performance-content">

						<span class="performance-number">
							01
						</span>

						<h3>
							Weddings
						</h3>

						<p>
							Live music for wedding celebrations,
							sangeet and unforgettable moments.
						</p>

					</div>

				</article>



				<!-- EVENTS -->

				<article class="performance-card">

					<img
						src="/hero_event.jpeg"
						alt="Roushan performing at an event"
						loading="lazy"
					/>

					<div class="performance-icon">
						♪
					</div>

					<div class="performance-content">

						<span class="performance-number">
							02
						</span>

						<h3>
							Events
						</h3>

						<p>
							Live performances for private,
							social and special events.
						</p>

					</div>

				</article>



				<!-- BIRTHDAYS -->

				<article class="performance-card">

					<img
						src="/hero_sitting_sofa.jpg"
						alt="Roushan portrait"
						loading="lazy"
					/>

					<div class="performance-icon">
						✦
					</div>

					<div class="performance-content">

						<span class="performance-number">
							03
						</span>

						<h3>
							Birthdays
						</h3>

						<p>
							Make birthdays and celebrations
							more memorable with live music.
						</p>

					</div>

				</article>



				<!-- CORPORATE -->

				<article class="performance-card">

					<img
						src="/hero_standinf_close.jpg"
						alt="Roushan available for corporate events"
						loading="lazy"
					/>

					<div class="performance-icon">
						◇
					</div>

					<div class="performance-content">

						<span class="performance-number">
							04
						</span>

						<h3>
							Corporate
						</h3>

						<p>
							Professional live entertainment
							for corporate events and gatherings.
						</p>

					</div>

				</article>


			</div>

		</section>



		<!-- =================================================
		     LIVE EXPERIENCE
		================================================= -->

		<section class="feature">

			<div>

