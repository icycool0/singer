---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
<head>

	<BaseHead
		title={SITE_TITLE}
		description={SITE_DESCRIPTION}
	/>

	<style>

		/* =====================================================
		   DESIGN SYSTEM
		===================================================== */

		:root {
			--black: #080809;
			--black-soft: #101012;
			--black-card: #121214;
			--white: #f5f2ec;
			--muted: #999691;
			--gold: #d6b477;
			--line: rgba(255,255,255,.10);
		}


		/* =====================================================
		   RESET
		===================================================== */

		*,
		*::before,
		*::after {
			box-sizing: border-box;
		}

		html {
			margin: 0;
			padding: 0;
			background: var(--black);
			scroll-behavior: smooth;
		}

		body {
			margin: 0 !important;
			padding: 0 !important;

			background: var(--black) !important;
			color: var(--white);

			font-family:
				Inter,
				-apple-system,
				BlinkMacSystemFont,
				"Segoe UI",
				Roboto,
				Arial,
				sans-serif;

			overflow-x: hidden;
		}

		main {
			width: 100% !important;
			max-width: none !important;
			margin: 0 !important;
			padding: 0 !important;
		}

		img {
			display: block;
			max-width: 100%;
		}

		a {
			color: inherit;
		}


		/* =====================================================
		   NAVIGATION
		===================================================== */

		.site-nav {
			position: absolute;
			top: 0;
			left: 0;
			right: 0;

			z-index: 50;

			background:
				linear-gradient(
					to bottom,
					rgba(0,0,0,.58),
					transparent
				);

			border-bottom: 1px solid rgba(255,255,255,.08);
		}

		.nav-inner {
			width: min(1380px, calc(100% - 70px));
			height: 82px;

			margin: auto;

			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		.logo {
			text-decoration: none;

			font-size: 20px;
			font-weight: 800;
			letter-spacing: .10em;
		}

		.logo span {
			color: var(--gold);
		}

		.nav-links {
			display: flex;
			align-items: center;
			gap: 32px;
		}

		.nav-links a {
			text-decoration: none;

			font-size: 10px;
			font-weight: 700;
			letter-spacing: .15em;

			color: rgba(255,255,255,.76);

			transition: color .25s ease;
		}

		.nav-links a:hover {
			color: white;
		}

		.nav-book {
			padding: 12px 18px;

			border: 1px solid rgba(214,180,119,.75);

			color: var(--gold) !important;
		}

		.nav-book:hover {
			background: var(--gold);
			color: #111 !important;
		}


		/* =====================================================
		   HERO
		===================================================== */

		.hero {
			position: relative;

			width: 100%;

			height: min(900px, 100vh);
			min-height: 680px;

			overflow: hidden;

			display: flex;
			align-items: center;
		}

		.hero-image {
			position: absolute;
			inset: 0;

			width: 100%;
			height: 100%;

			object-fit: cover;
			object-position: center 28%;

			transform: scale(1.01);
		}

		.hero-overlay {
			position: absolute;
			inset: 0;

			background:
				linear-gradient(
					90deg,
					rgba(0,0,0,.84) 0%,
					rgba(0,0,0,.52) 40%,
					rgba(0,0,0,.12) 100%
				),
				linear-gradient(
					0deg,
					rgba(0,0,0,.76) 0%,
					rgba(0,0,0,.04) 68%
				);
		}

		.hero-content {
			position: relative;
			z-index: 2;

			width: min(1380px, calc(100% - 70px));

			margin: -75px auto 0;
		}

		.eyebrow,
		.section-label {
			margin: 0;

			font-size: 10px;
			font-weight: 800;
			letter-spacing: .25em;

			text-transform: uppercase;

			color: var(--gold);
		}

		.hero h1 {
			margin: 20px 0 25px;

			font-size: clamp(80px, 12vw, 175px);
			line-height: .80;

			letter-spacing: -.065em;
			font-weight: 850;
		}

		.hero-subtitle {
			max-width: 570px;

			margin: 0;

			font-size: clamp(17px, 2vw, 23px);
			line-height: 1.5;

			color: rgba(255,255,255,.84);
		}

		.hero-actions {
			display: flex;
			gap: 13px;

			margin-top: 34px;
		}

		.button {
			display: inline-flex;
			align-items: center;
			justify-content: center;

			min-height: 48px;
			padding: 0 23px;

			text-decoration: none;

			font-size: 10px;
			font-weight: 800;
			letter-spacing: .16em;

			transition:
				transform .25s ease,
				background .25s ease,
				color .25s ease;
		}

		.button-primary {
			background: var(--gold);
			color: #111;
		}

		.button-primary:hover {
			background: #eed39c;
			transform: translateY(-2px);
		}

		.button-outline {
			border: 1px solid rgba(255,255,255,.55);
			color: white;
		}

		.button-outline:hover {
			background: white;
			color: #111;

			transform: translateY(-2px);
		}

		.hero-location {
			position: absolute;

			right: 35px;
			bottom: 32px;

			z-index: 3;

			font-size: 9px;
			font-weight: 700;
			letter-spacing: .18em;

			color: rgba(255,255,255,.52);
		}


		/* =====================================================
		   VIDEO SECTION
		===================================================== */

		.video-section {
			width: min(1380px, calc(100% - 70px));

			margin: auto;

			padding: 105px 0 125px;
		}

		.video-heading {
			display: flex;

			align-items: flex-end;
			justify-content: space-between;

			gap: 60px;

			margin-bottom: 45px;
		}

		.video-heading h2 {
			margin: 15px 0 0;

			font-size: clamp(42px, 5vw, 68px);
			line-height: .98;

			letter-spacing: -.045em;
		}

		.video-heading p {
			max-width: 390px;

			margin: 0;

			font-size: 14px;
			line-height: 1.75;

			color: var(--muted);
		}

		.cinematic-video {
			position: relative;

			width: 100%;

			aspect-ratio: 16 / 9;

			overflow: hidden;

			background: #111;
		}

		.cinematic-video img {
			width: 100%;
			height: 100%;

			object-fit: cover;

			filter: brightness(.58);

			transition: transform 1s ease;
		}

		.cinematic-video:hover img {
			transform: scale(1.025);
		}

		.video-vignette {
			position: absolute;
			inset: 0;

			background:
				linear-gradient(
					0deg,
					rgba(0,0,0,.65),
					transparent 65%
				);
		}

		.video-center {
			position: absolute;
			inset: 0;

			display: flex;
			align-items: center;
			justify-content: center;
		}

		.play-button {
			width: 82px;
			height: 82px;

			display: flex;
			align-items: center;
			justify-content: center;

			border: 1px solid rgba(255,255,255,.85);
			border-radius: 50%;

			color: white;

			font-size: 18px;

			padding-left: 4px;

			backdrop-filter: blur(5px);
		}

		.video-duration {
			position: absolute;

			right: 25px;
			bottom: 22px;

			font-size: 9px;
			font-weight: 700;
			letter-spacing: .16em;

			color: rgba(255,255,255,.75);
		}


		/* =====================================================
		   COMMON SECTION
		===================================================== */

		.section {
			width: min(1380px, calc(100% - 70px));

			margin: auto;

			padding: 125px 0;
		}

		.section-title {
			margin: 15px 0 0;

			font-size: clamp(42px, 5vw, 70px);
			line-height: .98;

			letter-spacing: -.045em;
			font-weight: 750;
		}


		/* =====================================================
		   ARTIST INTRO
		===================================================== */

		.artist-intro {
			display: grid;

			grid-template-columns: 1fr 1fr;

			gap: 110px;
		}

		.artist-intro-text {
			max-width: 570px;

			margin: 35px 0 0;

			font-size: 19px;
			line-height: 1.8;

			color: var(--muted);
		}


		/* =====================================================
		   PERFORMANCE INTRO
		===================================================== */

		.performance-header {
			text-align: center;

			max-width: 800px;

			margin: 0 auto 65px;
		}

		.performance-mark {
			width: 62px;
			height: 62px;

			margin: 0 auto 24px;

			display: flex;
			align-items: center;
			justify-content: center;

			border: 1px solid rgba(214,180,119,.65);
			border-radius: 50%;

			color: var(--gold);

			font-size: 21px;
		}

		.performance-brand {
			margin: 0 0 12px;

			font-size: 10px;
			font-weight: 800;

			letter-spacing: .28em;

			color: var(--gold);
		}

		.performance-heading {
			margin: 0;

			font-size: clamp(45px, 6vw, 78px);
			line-height: .95;

			letter-spacing: -.05em;
			font-weight: 750;
		}

		.performance-description {
			max-width: 510px;

			margin: 23px auto 0;

			font-size: 16px;
			line-height: 1.75;

			color: var(--muted);
		}


		/* =====================================================
		   PERFORMANCE CARDS
		===================================================== */

		.service-grid {
			display: grid;

			grid-template-columns: repeat(2, 1fr);

			gap: 18px;
		}

		.service-card {
			position: relative;

			display: grid;

			grid-template-columns: 44% 56%;

			min-height: 440px;

			overflow: hidden;

			background: var(--black-card);

			border: 1px solid var(--line);

			text-decoration: none;

			transition:
				transform .35s ease,
				border-color .35s ease;
		}

		.service-card:hover {
			transform: translateY(-4px);

			border-color:
				rgba(214,180,119,.48);
		}


		/* IMAGE */

		.service-image {
			position: relative;

			height: 100%;
			min-height: 440px;

			overflow: hidden;
		}

		.service-image img {
			width: 100%;
			height: 100%;

			object-fit: cover;

			transition:
				transform .8s cubic-bezier(.2,.7,.2,1);
		}

		.service-card:hover .service-image img {
			transform: scale(1.06);
		}

		.service-image::after {
			content: "";

			position: absolute;
			inset: 0;

			background:
				linear-gradient(
					90deg,
					transparent 50%,
					rgba(8,8,9,.70)
				);
		}


		/* CARD CONTENT */

		.service-info {
			position: relative;

			padding: 40px 34px;

			display: flex;
			flex-direction: column;
			justify-content: center;
		}

		.service-number {
			position: absolute;

			top: 28px;
			right: 30px;

			font-size: 10px;
			font-weight: 700;

			letter-spacing: .20em;

			color: var(--gold);
		}

		.service-icon {
			width: 43px;
			height: 43px;

			display: flex;
			align-items: center;
			justify-content: center;

			margin-bottom: 27px;

			border: 1px solid rgba(214,180,119,.65);
			border-radius: 50%;

			color: var(--gold);

			font-size: 17px;

			transition:
				background .3s ease,
				color .3s ease;
		}

		.service-card:hover .service-icon {
			background: var(--gold);
			color: #111;
		}

		.service-info h3 {
			margin: 0 0 15px;

			font-size: clamp(31px, 3vw, 44px);

			line-height: 1;

			letter-spacing: -.04em;
		}

		.service-info p {
			max-width: 330px;

			margin: 0 0 27px;

			font-size: 14px;
			line-height: 1.7;

			color: var(--muted);
		}

		.service-link {
			font-size: 9px;
			font-weight: 800;

			letter-spacing: .17em;

			color: var(--gold);
		}


		/* =====================================================
		   FEATURE
		===================================================== */

		.feature {
			width: 100%;

			display: grid;

			grid-template-columns: 1.15fr .85fr;

			background: var(--black-soft);
		}

		.feature-image {
			min-height: 700px;

			overflow: hidden;
		}

		.feature-image img {
			width: 100%;
			height: 100%;

			min-height: 700px;

			object-fit: cover;
		}

		.feature-content {
			padding: 90px 80px;

			display: flex;
			flex-direction: column;
			justify-content: center;
		}

		.feature-content h2 {
			margin: 18px 0 25px;

			font-size: clamp(42px, 5vw, 68px);
			line-height: .98;

			letter-spacing: -.045em;
		}

		.feature-content p:not(.section-label) {
			max-width: 500px;

			margin: 0;

			font-size: 16px;
			line-height: 1.8;

			color: var(--muted);
		}

		.feature-link {
			margin-top: 30px;

			font-size: 9px;
			font-weight: 800;

			letter-spacing: .18em;

			color: var(--gold);

			text-decoration: none;
		}


		/* =====================================================
		   GALLERY
		===================================================== */

		.gallery-heading {
			margin-bottom: 55px;
		}

		.gallery-grid {
			display: grid;

			grid-template-columns:
				1.35fr
				.8fr
				.8fr;

			grid-template-rows:
				300px
				300px;

			gap: 12px;
		}

		.gallery-item {
			overflow: hidden;

			background: #111;
		}

		.gallery-item:first-child {
			grid-row: span 2;
		}

		.gallery-item img {
			width: 100%;
			height: 100%;

			object-fit: cover;

			transition: transform .7s ease;
		}

		.gallery-item:hover img {
			transform: scale(1.04);
		}


		/* =====================================================
		   BOOKING
		===================================================== */

		.booking {
			text-align: center;

			padding-top: 145px;
			padding-bottom: 165px;
		}

		.booking-text {
			max-width: 600px;

			margin: 28px auto 35px;

			font-size: 16px;
			line-height: 1.8;

			color: var(--muted);
		}

		.booking-actions {
			display: flex;

			justify-content: center;

			gap: 12px;
		}


		/* =====================================================
		   FOOTER
		===================================================== */

		.site-footer {
			border-top: 1px solid var(--line);

			background: #070708;
		}

		.footer-inner {
			width: min(1380px, calc(100% - 70px));

			min-height: 130px;

			margin: auto;

			display: flex;

			align-items: center;
			justify-content: space-between;

			gap: 25px;
		}

		.footer-brand {
			font-size: 18px;
			font-weight: 800;

			letter-spacing: .09em;
		}

		.footer-info {
			margin: 0;

			font-size: 10px;
			letter-spacing: .08em;

			color: var(--muted);
		}


		/* =====================================================
		   TABLET
		===================================================== */

		@media (max-width: 950px) {

			.nav-inner,
			.hero-content,
			.video-section,
			.section,
			.footer-inner {
				width: calc(100% - 44px);
			}

			.nav-links {
				gap: 17px;
			}

			.nav-links a:not(.nav-book) {
				display: none;
			}

			.hero-content {
				margin-top: -40px;
			}

			.artist-intro {
				grid-template-columns: 1fr;
				gap: 25px;
			}

			.artist-intro-text {
				margin-top: 0;
			}

			.video-heading {
				display: block;
			}

			.video-heading p {
				margin-top: 20px;
			}

			.service-grid {
				grid-template-columns: 1fr;
			}

			.feature {
				grid-template-columns: 1fr;
			}

			.feature-image,
			.feature-image img {
				min-height: 550px;
			}

			.feature-content {
				padding: 75px 35px;
			}
		}


		/* =====================================================
		   MOBILE
		===================================================== */

		@media (max-width: 600px) {

			.nav-inner,
			.hero-content,
			.video-section,
			.section,
			.footer-inner {
				width: calc(100% - 36px);
			}

			.nav-inner {
				height: 72px;
			}

			.logo {
				font-size: 18px;
			}

			.nav-book {
				padding: 10px 13px;
			}

			.hero {
				height: 760px;
				min-height: 760px;
			}

			.hero-image {
				object-position: 58% center;
			}

			.hero-content {
				margin-top: -30px;
			}

			.hero h1 {
				font-size: clamp(65px, 19vw, 105px);
			}

			.hero-subtitle {
				font-size: 16px;
				max-width: 340px;
			}

			.hero-actions {
				flex-direction: column;
				align-items: flex-start;
			}

			.hero-location {
				display: none;
			}

			.video-section {
				padding-top: 80px;
				padding-bottom: 90px;
			}

			.video-heading h2 {
				font-size: 43px;
			}

			.cinematic-video {
				aspect-ratio: 16 / 10;
			}

			.play-button {
				width: 65px;
				height: 65px;
			}

			.performance-header {
				margin-bottom: 45px;
			}

			.performance-heading {
				font-size: 45px;
			}

			.performance-description {
				font-size: 15px;
			}

			.section {
				padding: 90px 0;
			}

			.section-title {
				font-size: 43px;
			}

			.service-card {
				grid-template-columns: 1fr;

				min-height: auto;
			}

			.service-image {
				height: 280px;
				min-height: 280px;
			}

			.service-info {
				min-height: 285px;

				padding: 35px 25px;
			}

			.service-number {
				top: 25px;
				right: 25px;
			}

			.feature-image,
			.feature-image img {
				min-height: 450px;
			}

			.feature-content {
				padding: 60px 22px;
			}

			.feature-content h2 {
				font-size: 43px;
			}

			.gallery-grid {
				grid-template-columns: 1fr 1fr;

				grid-template-rows:
					250px
					250px
					250px;
			}

			.gallery-item:first-child {
				grid-row: span 1;
			}

			.gallery-item:last-child {
				grid-column: span 2;
			}

			.booking {
				padding-top: 100px;
				padding-bottom: 110px;
			}

			.booking-actions {
				flex-direction: column;

				align-items: center;
			}

			.footer-inner {
				min-height: 160px;

				flex-direction: column;

				justify-content: center;

				text-align: center;
			}
		}

	</style>
</head>


<body>


	<!-- =====================================================
	     NAVIGATION
	===================================================== -->

	<header class="site-nav">

		<div class="nav-inner">

			<a href="/" class="logo">
				ROUSHAN<span>.</span>
			</a>

			<nav class="nav-links">

				<a href="#experience">
					EXPERIENCE
				</a>

				<a href="#gallery">
					GALLERY
				</a>

				<a href="#video">
					VIDEO
				</a>

				<a
					href="#booking"
					class="nav-book"
				>
					BOOK NOW
				</a>

			</nav>

		</div>

	</header>


	<main>


		<!-- =====================================================
		     HERO
		===================================================== -->

		<section class="hero">

			<img
				class="hero-image"
				src="/hero_live3.jpg"
				alt="Roushan performing live on stage"
				fetchpriority="high"
			/>

			<div class="hero-overlay"></div>

			<div class="hero-content">

				<p class="eyebrow">
					SINGER • LIVE PERFORMER • PATNA
				</p>

				<h1>
					ROUSHAN
				</h1>

				<p class="hero-subtitle">
					Live music for weddings, celebrations
					and unforgettable events.
				</p>

				<div class="hero-actions">

					<a
						href="#booking"
						class="button button-primary"
					>
						BOOK ROUSHAN
					</a>

					<a
						href="#experience"
						class="button button-outline"
					>
						EXPLORE
					</a>

				</div>

			</div>

			<div class="hero-location">
				PATNA · BIHAR · INDIA
			</div>

		</section>


		<!-- =====================================================
		     10 SECOND CINEMATIC VIDEO
		===================================================== -->

		<section
			class="video-section"
			id="video"
		>

			<div class="video-heading">

				<div>

					<p class="section-label">
						THE PERFORMANCE
					</p>

					<h2>
						See the artist.
					</h2>

