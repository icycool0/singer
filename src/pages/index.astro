<script>
const menu=document.querySelector(".menu");
menu?.addEventListener("click",()=>document.body.classList.toggle("menu-open"));
document.querySelectorAll(".mobile-menu a").forEach(a=>a.addEventListener("click",()=>document.body.classList.remove("menu-open")));

const observer=new IntersectionObserver(entries=>{
  entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add("visible")});
},{threshold:.08});
document.querySelectorAll(".reveal").forEach(el=>observer.observe(el));

/* Lazy-load the YouTube player only after the visitor chooses to watch. */
const poster=document.getElementById("videoPoster");
const shell=document.getElementById("videoShell");
function loadVideo(){
  if(shell.querySelector("iframe")) return;
  const iframe=document.createElement("iframe");
  iframe.src="https://www.youtube-nocookie.com/embed/RrjtsRxXmGI?autoplay=1&rel=0";
  iframe.title="Roushan Live Performance";
  iframe.allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
  iframe.allowFullscreen=true;
  shell.insertBefore(iframe,shell.firstChild);
  poster.remove();
}
poster?.addEventListener("click",loadVideo);
poster?.addEventListener("keydown",e=>{if(e.key==="Enter"||e.key===" ")loadVideo()});

/* Booking form -> WhatsApp enquiry. No backend required. */
document.getElementById("bookingForm")?.addEventListener("submit",e=>{
  e.preventDefault();
  const f=new FormData(e.currentTarget);
  const text=[
    "Hello Roushan, I would like to enquire about a live performance.",
    "",
    `Name: ${f.get("name")||""}`,
    `Phone/WhatsApp: ${f.get("phone")||""}`,
    `Event: ${f.get("type")||""}`,
    `Date: ${f.get("date")||"Not decided"}`,
    `Location: ${f.get("location")||""}`,
    `Guests: ${f.get("guests")||"Not specified"}`,
    `Message: ${f.get("message")||""}`
  ].join("\n");
  const url="https://wa.me/91955275669?text="+encodeURIComponent(text);
  window.open(url,"_blank","noopener");
  document.getElementById("formStatus").style.display="block";
  document.getElementById("formStatus").textContent="Opening WhatsApp with your enquiry…";
});
</script>
