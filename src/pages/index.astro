	<script>

		/* =================================================
		   WHATSAPP BOOKING
		================================================= */

		const bookingForm =
			document.getElementById("bookingForm");

		const formStatus =
			document.getElementById("formStatus");


		bookingForm?.addEventListener(
			"submit",
			(event) => {

				event.preventDefault();


				const data =
					new FormData(bookingForm);


				const message = [

					"Hello Roushan, I would like to enquire about a live performance.",

					"",

					`Name: ${data.get("name") || ""}`,

					`Phone/WhatsApp: ${data.get("phone") || ""}`,

					`Event: ${data.get("type") || ""}`,

					`Date: ${data.get("date") || "Not decided"}`,

					`Location: ${data.get("location") || ""}`,

					`Guests: ${data.get("guests") || "Not specified"}`,

					`Message: ${data.get("message") || ""}`

				].join("\n");


				const whatsappURL =
					"https://wa.me/91955275669?text=" +
					encodeURIComponent(message);


				window.open(
					whatsappURL,
					"_blank",
					"noopener"
				);


				if (formStatus) {

					formStatus.style.display =
						"block";

					formStatus.textContent =
						"Opening WhatsApp with your enquiry…";

				}

			}
		);

	</script>


