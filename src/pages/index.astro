---
const VIDEO_URL = "https://www.youtube.com/embed/YOUR_VIDEO_ID";

const services = [
  {
    number: "01",
    title: "Weddings",
    text: "Live music for wedding celebrations, intimate moments and unforgettable evenings.",
  },
  {
    number: "02",
    title: "Events",
    text: "Live performances for private, social and special events.",
  },
  {
    number: "03",
    title: "Birthdays",
    text: "Make birthdays and celebrations more memorable with live music.",
  },
  {
    number: "04",
    title: "Corporate",
    text: "Professional live entertainment for corporate events and gatherings.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Roushan — Singer & Live Performer</title>

    <meta
      name="description"
      content="Roushan — singer and live performer for weddings, events, birthdays and corporate occasions."
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>

    <div class="grain"></div>

    <!-- =========================
         HEADER
    ========================== -->

    <header class="header">

      <a href="/" class="logo">
        <span class="logo-mark">
          R
        </span>

        <span class="logo-name">
          ROUSHAN
        </span>
      </a>


      <nav class="desktop-nav">
        <a href="#about">ABOUT</a>
        <a href="#performance">PERFORMANCES</a>
        <a href="#live">LIVE</a>
        <a href="#contact">CONTACT</a>
      </nav>


      <a href="#contact" class="header-button">
        BOOK ROUSHAN
      </a>


      <button
        class="menu-toggle"
        aria-label="Open menu"
      >
        <span></span>
        <span></span>
      </button>

    </header>


    <!-- =========================
         MOBILE MENU
    ========================== -->

    <div class="mobile-menu">

      <a href="#about">ABOUT</a>
      <a href="#performance">PERFORMANCES</a>
      <a href="#live">LIVE</a>
      <a href="#contact">CONTACT</a>

    </div>


    <main>

      <!-- =========================
           HERO
      ========================== -->

      <section class="hero">

        <div class="hero-copy">

          <div class="eyebrow">
            <span></span>
            SINGER · LIVE PERFORMER
          </div>


          <h1>
            Bring the
            <br />
            <em>music.</em>
          </h1>


          <p>
            Live music for weddings, celebrations,
            events and special occasions.
          </p>


          <div class="hero-actions">

            <a
              href="#performance"
              class="button button-primary"
            >
              <span>▶</span>
              WATCH PERFORMANCE
            </a>

            <a
              href="#contact"
              class="button button-secondary"
            >
              BOOK ROUSHAN
              <span>↗</span>
            </a>

          </div>


          <div class="hero-location">
            <span></span>
            Patna, Bihar · Available for events
          </div>

        </div>


        <!-- Hero image -->

        <div class="hero-image">

          <img
            src="/images/roushan-hero.jpg"
            alt="Roushan — singer and live performer"
          />

          <div class="hero-image-shade"></div>


          <div class="hero-image-info">

            <strong>
              ROUSHAN
            </strong>

            <span>
              SINGER / LIVE PERFORMER
            </span>

          </div>


          <div class="hero-image-number">
            01
          </div>

        </div>


        <!-- Graphic identity -->

        <div class="hero-graphic">

          <div class="graphic-ring">

            <span class="graphic-r">
              R
            </span>

            <span class="graphic-note">
              ♪
            </span>

          </div>

          <span class="graphic-text">
            LIVE · MUSIC · PERFORMANCE
          </span>

        </div>

      </section>


      <!-- =========================
           INTRO
      ========================== -->

      <section
        class="intro"
        id="about"
      >

        <div class="section-number">
          01 / ABOUT
        </div>


        <div class="intro-content">

          <span class="section-label">
            THE ARTIST
          </span>


          <h2>
            Music that feels
            <em>right.</em>
          </h2>


          <p>
            Roushan is a singer and live performer
            bringing energy, emotion and a personal
            touch to every performance.
          </p>

        </div>


        <div class="intro-symbol">

          <span>R</span>

          <small>
            VOICE<br />
            MUSIC<br />
            LIVE
          </small>

        </div>

      </section>


      <!-- =========================
           FEATURED PERFORMANCE
      ========================== -->

      <section
        class="performance"
        id="performance"
      >

        <div class="performance-heading">

          <div>

            <span class="section-label">
              02 / FEATURED PERFORMANCE
            </span>

            <h2>
              Hear the
              <em>artist.</em>
            </h2>

          </div>


          <p>
            Watch Roushan perform live and
            experience the voice, energy and
            atmosphere of the performance.
          </p>

        </div>


        <div class="video-frame">

          <iframe
            src={VIDEO_URL}
            title="Roushan performance"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>


          <div class="video-label">
            <span>ROUSHAN</span>
            <span>LIVE PERFORMANCE</span>
          </div>

        </div>


        <div class="video-caption">

          <div>

            <span class="section-label">
              LIVE MUSIC
            </span>

            <h3>
              A performance is
              <em>an experience.</em>
            </h3>

          </div>


          <a
            href="#contact"
            class="text-link"
          >
            BOOK FOR YOUR EVENT
            <span>↗</span>
          </a>

        </div>

      </section>


      <!-- =========================
           EXPERIENCE
      ========================== -->

      <section class="experience">

        <div class="experience-title">

          <span class="section-label">
            THE EXPERIENCE
          </span>

          <h2>
            Voice.
            <span>Music.</span>
            Energy.
          </h2>

        </div>


        <div class="experience-grid">

          <div class="experience-item">

            <span>01</span>

            <div class="experience-icon">
              ♪
            </div>

            <strong>
              VOICE
            </strong>

            <p>
              The sound that brings people together.
            </p>

          </div>


          <div class="experience-item">

            <span>02</span>

            <div class="experience-icon">
              ♫
            </div>

            <strong>
              MUSIC
            </strong>

            <p>
              Songs chosen for the moment.
            </p>

          </div>


          <div class="experience-item">

            <span>03</span>

            <div class="experience-icon">
              ◉
            </div>

            <strong>
              ENERGY
            </strong>

            <p>
              A live presence your audience remembers.
            </p>

          </div>


          <div class="experience-item">

            <span>04</span>

            <div class="experience-icon">
              R
            </div>

            <strong>
              ROUSHAN
            </strong>

            <p>
              A performance shaped around your event.
            </p>

          </div>

        </div>

      </section>


      <!-- =========================
           PROFILE
      ========================== -->

      <section class="profile">

        <div class="profile-image">

          <img
            src="/images/roushan-portrait.jpg"
            alt="Roushan"
          />

          <span>
            03
          </span>

        </div>


        <div class="profile-copy">

          <span class="section-label">
            ABOUT ROUSHAN
          </span>


          <h2>
            The artist
            <em>behind the voice.</em>
          </h2>


          <p>
            Roushan performs across weddings,
            birthdays, private celebrations,
            corporate events and social gatherings.
          </p>


          <p>
            The focus is simple — good music,
            a strong live performance and an
            atmosphere people enjoy being part of.
          </p>


          <a
            href="#contact"
            class="text-link"
          >
            GET IN TOUCH
            <span>↗</span>
          </a>

        </div>

      </section>


      <!-- =========================
           LIVE SERVICES
      ========================== -->

      <section
        class="live"
        id="live"
      >

        <div class="live-heading">

          <div>

            <span class="section-label">
              04 / LIVE
            </span>

            <h2>
              Choose your
              <em>occasion.</em>
            </h2>

          </div>


          <p>
            Live performances for moments
            worth celebrating.
          </p>

        </div>


        <div class="service-grid">

          {services.map((service) => (

            <article class="service-card">

              <div class="service-top">

                <span>
                  {service.number}
                </span>

                <div class="service-logo">

                  <span class="service-note">
                    ♪
                  </span>

                  <span class="service-r">
                    R
                  </span>

                </div>

              </div>


              <div class="service-content">

                <h3>
                  {service.title}
                </h3>

                <p>
                  {service.text}
                </p>

              </div>


              <span class="service-arrow">
                ↗
              </span>

            </article>

          ))}

        </div>

      </section>


      <!-- =========================
           CALL TO ACTION
      ========================== -->

      <section
        class="contact"
        id="contact"
      >

        <div class="contact-content">

          <span class="section-label">
            05 / BOOKING
          </span>


          <h2>
            Make your event
            <br />
            <em>sound special.</em>
          </h2>


          <p>
            Tell us about your event, date and
            location and let's plan the performance.
          </p>


          <div class="contact-actions">

            <a
              href="tel:+910000000000"
              class="button button-primary"
            >
              CALL ROUSHAN
              <span>↗</span>
            </a>


            <a
              href="https://wa.me/910000000000"
              target="_blank"
              rel="noopener"
              class="button button-secondary"
            >
              WHATSAPP
              <span>↗</span>
            </a>

          </div>

        </div>


        <div class="contact-graphic">

          <div class="big-r">
            R
          </div>

          <div class="contact-circle">
            ♪
          </div>

        </div>

      </section>

    </main>


    <!-- =========================
         FOOTER
    ========================== -->

    <footer>

      <div class="footer-brand">

        <span class="logo-mark">
          R
        </span>

        <span>
          ROUSHAN
        </span>

      </div>


      <div class="footer-nav">

        <a href="#about">ABOUT</a>
        <a href="#performance">PERFORMANCES</a>
        <a href="#live">LIVE</a>
        <a href="#contact">CONTACT</a>

      </div>


      <div class="social">

        <a href="#">
          INSTAGRAM
        </a>

        <a href="#">
          YOUTUBE
        </a>

      </div>


      <div class="copyright">
        © 2026 ROUSHAN · ALL RIGHTS RESERVED
      </div>

    </footer>


    <!-- =========================
         JAVASCRIPT
    ========================== -->

    <script>

      /* Mobile navigation */

      const menuButton =
        document.querySelector(".menu-toggle");

      const mobileMenu =
        document.querySelector(".mobile-menu");


      menuButton?.addEventListener(
        "click",
        () => {

          document.body.classList.toggle(
            "menu-open"
          );

        }
      );


      mobileMenu
        ?.querySelectorAll("a")
        .forEach((link) => {

          link.addEventListener(
            "click",
            () => {

              document.body.classList.remove(
                "menu-open"
              );

            }
          );

        });


      /* Scroll reveal */

      const revealElements =
        document.querySelectorAll(
          ".intro, .performance, .experience, .profile, .live, .contact"
        );


      const observer =
        new IntersectionObserver(
          (entries) => {

            entries.forEach((entry) => {

              if (entry.isIntersecting) {

                entry.target.classList.add(
                  "visible"
                );

              }

            });

          },
          {
            threshold: 0.08
          }
        );


      revealElements.forEach(
        (element) =>
          observer.observe(element)
      );

    </script>

  </body>
</html>


<style>

  /* =====================================================
     DESIGN
  ===================================================== */

  :root {

    --paper: #eee7dc;
    --paper-light: #f5f0e8;

    --charcoal: #292521;
    --charcoal-soft: #403a34;

    --brown: #5a493a;

    --gold: #b78d60;
    --gold-light: #d0ad83;

    --muted: #756d65;

    --line:
      rgba(52, 46, 40, 0.16);

    --dark-line:
      rgba(238, 231, 220, 0.15);

    --serif:
      "Playfair Display",
      Georgia,
      serif;

    --sans:
      "DM Sans",
      Arial,
      sans-serif;

  }


  /* =====================================================
     RESET
  ===================================================== */

  * {
    box-sizing: border-box;
  }


  html {
    scroll-behavior: smooth;
  }


  body {

    margin: 0;

    background:
      var(--paper);

    color:
      var(--charcoal);

    font-family:
      var(--sans);

    overflow-x: hidden;

  }


  ::selection {

    background:
      var(--gold);

    color:
      white;

  }


  a {

    color: inherit;

    text-decoration: none;

  }


  img,
  iframe {

    display: block;

    max-width: 100%;

  }


  /* =====================================================
     GRAIN
  ===================================================== */

  .grain {

    position: fixed;

    inset: 0;

    z-index: 9999;

    pointer-events: none;

    opacity: .018;

    background-image:
      url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");

  }


  /* =====================================================
     HEADER
  ===================================================== */

  .header {

    position: absolute;

    top: 0;
    left: 0;
    right: 0;

    height: 90px;

    padding:
      0 5vw;

    display: flex;

    align-items: center;

    z-index: 100;

  }


  .logo {

    display: flex;

    align-items: center;

    gap: 11px;

  }


  .logo-mark {

    width: 34px;
    height: 34px;

    display: grid;

    place-items: center;

    border:
      1px solid
      var(--gold);

    color:
      var(--gold);

    font-family:
      var(--serif);

    font-size: 20px;

  }


  .logo-name {

    font-size: 10px;

    font-weight: 700;

    letter-spacing:
      .22em;

  }


  .desktop-nav {

    margin-left: auto;

    display: flex;

    gap: 32px;

    margin-right: 38px;

  }


  .desktop-nav a {

    font-size: 9px;

    font-weight: 600;

    letter-spacing:
      .14em;

    color:
      rgba(41, 37, 33, .72);

    transition:
      color .25s ease;

  }


  .desktop-nav a:hover {

    color:
      var(--gold);

  }


  .header-button {

    padding:
      12px 17px;

    border:
      1px solid
      rgba(90, 73, 58, .45);

    font-size: 9px;

    font-weight: 700;

    letter-spacing:
      .12em;

    transition:
      .3s ease;

  }


  .header-button:hover {

    background:
      var(--charcoal);

    color:
      var(--paper);

  }


  .menu-toggle {

    display: none;

    border: 0;

    background: transparent;

    cursor: pointer;

  }


  .menu-toggle span {

    display: block;

    width: 25px;

    height: 1px;

    margin: 6px;

    background:
      var(--charcoal);

  }


  /* =====================================================
     MOBILE MENU
  ===================================================== */

  .mobile-menu {

    position: fixed;

    inset: 0;

    z-index: 90;

    display: none;

    flex-direction: column;

    justify-content: center;

    align-items: center;

    gap: 28px;

    background:
      var(--paper);

  }


  .mobile-menu a {

    font-family:
      var(--serif);

    font-size:
      36px;

  }


  body.menu-open .mobile-menu {

    display: flex;

  }


  /* =====================================================
     HERO
  ===================================================== */

  .hero {

    position: relative;

    min-height: 100vh;

    display: grid;

    grid-template-columns:
      51% 49%;

    overflow: hidden;

    background:
      var(--paper);

  }


  .hero-copy {

    position: relative;

    z-index: 5;

    align-self: center;

    padding:
      145px 3vw 90px 9vw;

  }


  .eyebrow {

    display: flex;

    align-items: center;

    gap: 12px;

    color:
      var(--gold);

    font-size: 9px;

    font-weight: 700;

    letter-spacing:
      .17em;

    margin-bottom:
      30px;

  }


  .eyebrow span {

    width: 32px;

    height: 1px;

    background:
      var(--gold);

  }


  .hero h1 {

    margin: 0;

    font-family:
      var(--serif);

    font-size:
      clamp(68px, 8vw, 120px);

    line-height:
      .88;

    font-weight: 400;

    letter-spacing:
      -.06em;

  }


  .hero h1 em {

    color:
      var(--gold);

    font-style:
      italic;

  }


  .hero-copy > p {

    max-width: 430px;

    margin:
      38px 0 0;

    color:
      var(--muted);

    font-size: 14px;

    line-height:
      1.85;

  }


  .hero-actions {

    display: flex;

    gap: 11px;

    margin-top:
      32px;

  }


  .button {

    min-height:
      47px;

    padding:
      0 20px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 11px;

    font-size: 9px;

    font-weight: 700;

    letter-spacing:
      .11em;

    transition:
      all .3s ease;

  }


  .button-primary {

    background:
      var(--charcoal);

    color:
      var(--paper);

  }


  .button-primary:hover {

    background:
      var(--brown);

  }


  .button-secondary {

    border:
      1px solid
      rgba(41, 37, 33, .3);

  }


  .button-secondary:hover {

    border-color:
      var(--gold);

    color:
      var(--gold);

  }


  .hero-location {

    display: flex;

    align-items: center;

    gap: 8px;

    margin-top:
      45px;

    color:
      rgba(41, 37, 33, .48);

    font-size: 9px;

    letter-spacing:
      .06em;

  }


  .hero-location span {

    width: 5px;

    height: 5px;

    border-radius: 50%;

    background:
      var(--gold);

  }


  /* =====================================================
     HERO IMAGE
  ===================================================== */

  .hero-image {

    position: relative;

    height: 100vh;

    overflow: hidden;

    background:
      #d6c5b3;

  }


  .hero-image img {

    width: 100%;

    height: 100%;

    object-fit: cover;

    object-position:
      center center;

    filter:
      saturate(.78)
      contrast(1.02);

    transform:
      scale(1.025);

    animation:
      heroMove
      15s
      ease-in-out
      infinite
      alternate;

  }


  @keyframes heroMove {

    from {
      transform:
        scale(1.025);
    }

    to {
      transform:
        scale(1.055);
    }

  }


  .hero-image-shade {

    position: absolute;

    inset: 0;

    background:
      linear-gradient(
        90deg,
        rgba(41,37,33,.32),
        transparent 35%
      ),
      linear-gradient(
        0deg,
        rgba(41,37,33,.38),
        transparent 42%
      );

  }


  .hero-image-info {

    position: absolute;

    left: 30px;

    bottom: 35px;

    display: flex;

    flex-direction: column;

    gap: 5px;

    color:
      white;

  }


  .hero-image-info strong {

    font-size: 10px;

    letter-spacing:
      .18em;

  }


  .hero-image-info span {

    font-size: 7px;

    letter-spacing:
      .16em;

    color:
      #e4c8a5;

  }


  .hero-image-number {

    position: absolute;

    right: 27px;

    bottom: 15px;

    font-family:
      var(--serif);

    font-size:
      90px;

    color:
      rgba(255,255,255,.22);

  }


  /* =====================================================
     HERO GRAPHIC
  ===================================================== */

  .hero-graphic {

    position: absolute;

    z-index: 10;

    right: 40%;

    bottom: 12%;

    transform:
      translateX(50%);

    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 10px;

  }


  .graphic-ring {

    width: 90px;

    height: 90px;

    border:
      1px solid
      rgba(183,141,96,.75);

    border-radius: 50%;

    display: grid;

    place-items: center;

    position: relative;

    background:
      rgba(238,231,220,.75);

    backdrop-filter:
      blur(5px);

  }


  .graphic-r {

    font-family:
      var(--serif);

    font-size: 47px;

    color:
      var(--brown);

  }


  .graphic-note {

    position: absolute;

    right: 17px;

    top: 13px;

    color:
      var(--gold);

    font-size: 18px;

  }


  .graphic-text {

    font-size: 7px;

    letter-spacing:
      .16em;

    color:
      rgba(41,37,33,.58);

    white-space:
      nowrap;

  }


  /* =====================================================
     INTRO
  ===================================================== */

  .intro {

    min-height:
      620px;

    padding:
      130px 9vw;

    display: grid;

    grid-template-columns:
      18% 62% 20%;

    align-items:
      center;

    border-top:
      1px solid var(--line);

    border-bottom:
      1px solid var(--line);

    opacity: 0;

    transform:
      translateY(30px);

    transition:
      1s ease;

  }


  .intro.visible {

    opacity: 1;

    transform:
      none;

  }


  .section-number {

    color:
      var(--gold);

    font-size: 9px;

    letter-spacing:
      .14em;

  }


  .section-label {

    color:
      var(--gold);

    font-size: 9px;

    font-weight: 700;

    letter-spacing:
      .17em;

    text-transform:
      uppercase;

  }


  .intro-content h2 {

    margin:
      20px 0 30px;

    font-family:
      var(--serif);

    font-size:
      clamp(54px, 5.5vw, 88px);

    line-height:
      .96;

    font-weight:
      400;

    letter-spacing:
      -.05em;

  }


