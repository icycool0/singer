---
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="en">
<head>

	<BaseHead
		title="Roushan | Singer & Live Performer in Patna"
		description="Roushan is a singer and live performer in Patna, available for weddings, celebrations, private events and special occasions."
	/>

	<style>

		/* =====================================================
		   ROUSHAN — EDITORIAL ARTIST DESIGN
		   Warm ivory / charcoal / champagne
		===================================================== */

		:root {
			--ivory: #f4f0e8;
			--ivory-2: #ebe5da;
			--white: #fffdf9;

			--charcoal: #191919;
			--charcoal-2: #242321;

			--text: #20201e;
			--muted: #66635d;
			--muted-light: #89857d;

			--champagne: #a88b5c;
			--champagne-light: #c7ad7d;

			--line: rgba(25,25,25,.14);

			--max: 1280px;
		}


		/* =====================================================
		   RESET
		===================================================== */

		* {
			box-sizing: border-box;
		}

		html {
			scroll-behavior: smooth;
		}

		body {
			margin: 0;
			padding: 0;

			background: var(--ivory);

			color: var(--text);

			font-family:
				Inter,
				Arial,
				Helvetica,
				sans-serif;

			-webkit-font-smoothing: antialiased;

			overflow-x: hidden;
		}

		a {
			color: inherit;
		}

		img {
			display: block;
			max-width: 100%;
		}

		button,
		input,
		select,
		textarea {
			font-family: inherit;
		}

		em {
			font-family: Georgia, "Times New Roman", serif;
			font-weight: 400;
		}


		/* =====================================================
		   NAVIGATION
		===================================================== */

		.nav {
			position: absolute;
			z-index: 100;

			top: 0;
			left: 0;

			width: 100%;

			padding: 28px 5vw;

			color: white;
		}

		.nav-inner {
			width: min(var(--max), 100%);
			margin: auto;

			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		.logo {
			text-decoration: none;

			font-size: 18px;
			font-weight: 800;

			letter-spacing: .17em;
		}

		.logo span {
			color: var(--champagne-light);
		}

		.nav-links {
			display: flex;
			align-items: center;

			gap: 30px;
		}

		.nav-links a {
			text-decoration: none;

			font-size: 11px;
			font-weight: 700;

			letter-spacing: .13em;

			color: rgba(255,255,255,.9);

			transition: opacity .25s ease;
		}

		.nav-links a:hover {
			opacity: .6;
		}

		.nav-book {
			padding: 11px 17px;

			border: 1px solid rgba(255,255,255,.55);
		}


		/* =====================================================
		   HERO
		===================================================== */

		.hero {
			position: relative;

			min-height: 760px;
			height: 92vh;

			overflow: hidden;

			display: flex;
			align-items: flex-end;
		}

		.hero-image {
			position: absolute;

			inset: 0;

			width: 100%;
			height: 100%;

			object-fit: cover;

			object-position: center 28%;

			transform: scale(1.01);
		}

		.hero-overlay {
			position: absolute;

			inset: 0;

			background:
				linear-gradient(
					90deg,
					rgba(12,12,11,.76) 0%,
					rgba(12,12,11,.38) 42%,
					rgba(12,12,11,.08) 75%
				),

				linear-gradient(
					0deg,
					rgba(12,12,11,.72) 0%,
					rgba(12,12,11,.05) 60%
				);
		}

		.hero-content {
			position: relative;
			z-index: 3;

			width: min(var(--max), 90%);

			margin: 0 auto;

			padding-bottom: 95px;

			color: white;
		}

		.eyebrow {
			margin: 0 0 20px;

			color: #dbc79f;

			font-size: 11px;
			font-weight: 800;

			letter-spacing: .24em;
		}

		.hero h1 {
			margin: 0;

			font-size: clamp(86px, 13vw, 175px);

			line-height: .78;

			letter-spacing: -.075em;

			font-weight: 800;
		}

		.hero h1 em {
			color: #eee6d8;
		}

		.hero-subtitle {
			max-width: 610px;

			margin: 35px 0 0;

			color: rgba(255,255,255,.9);

			font-size: clamp(19px, 2vw, 25px);

			line-height: 1.55;
		}

		.hero-buttons {
			display: flex;

			gap: 12px;

			margin-top: 31px;
		}

		.button {
			display: inline-flex;

			align-items: center;
			justify-content: center;

			min-height: 50px;

			padding: 0 25px;

			text-decoration: none;

			font-size: 11px;
			font-weight: 800;

			letter-spacing: .13em;

			transition:
				transform .25s ease,
				background .25s ease,
				color .25s ease;
		}

		.button:hover {
			transform: translateY(-2px);
		}

		.button-primary {
			background: var(--champagne);

			color: white;
		}

		.button-primary:hover {
			background: var(--champagne-light);
		}

		.button-outline {
			border: 1px solid rgba(255,255,255,.65);

			color: white;
		}

		.button-outline:hover {
			background: white;

			color: var(--charcoal);
		}

		.hero-location {
			position: absolute;

			z-index: 5;

			right: 5vw;
			bottom: 28px;

			color: rgba(255,255,255,.68);

			font-size: 10px;

			letter-spacing: .18em;
		}


		/* =====================================================
		   COMMON SECTIONS
		===================================================== */

		.section {
			width: min(var(--max), 90%);

			margin: auto;

			padding: 135px 0;
		}

		.label {
			margin: 0 0 18px;

			color: var(--champagne);

			font-size: 10px;
			font-weight: 800;

			letter-spacing: .22em;

			text-transform: uppercase;
		}

		.section-title {
			margin: 0;

			max-width: 900px;

			color: var(--text);

			font-size: clamp(48px, 6vw, 78px);

			line-height: .94;

			letter-spacing: -.055em;

			font-weight: 750;
		}

		.section-title em {
			color: #625b50;
		}


		/* =====================================================
		   VIDEO
		===================================================== */

		.video-section {
			background: var(--ivory);
		}

		.video-header {
			width: min(var(--max), 90%);

			margin: auto;

			padding: 110px 0 45px;

			display: grid;

			grid-template-columns: 1.1fr .9fr;

			gap: 80px;

			align-items: end;
		}

		.video-note {
			max-width: 420px;

			margin: 0;

			color: var(--muted);

			font-size: 18px;

			line-height: 1.8;
		}

		/* Vertical YouTube Short */

		.youtube-frame {
			position: relative;

			width: min(430px, 90%);

			margin: auto;

			aspect-ratio: 9 / 16;

			overflow: hidden;

			background: #000;

			box-shadow:
				0 25px 70px rgba(0,0,0,.16);
		}

		.youtube-frame iframe {
			position: absolute;

			inset: 0;

			width: 100%;
			height: 100%;

			border: 0;
		}

		.video-caption {
			width: min(430px, 90%);

			margin: 18px auto 0;

			padding-bottom: 110px;

			color: var(--muted-light);

			font-size: 11px;

			letter-spacing: .08em;

			text-align: center;
		}


		/* =====================================================
		   ARTIST INTRO
		===================================================== */

		.artist {
			display: grid;

			grid-template-columns: 1fr 1fr;

			gap: 120px;

			align-items: start;
		}

		.artist-copy {
			max-width: 600px;

			padding-top: 10px;
		}

		.artist-copy p {
			margin: 0;

			color: var(--muted);

			font-size: 20px;

			line-height: 1.85;
		}

		.artist-line {
			width: 75px;

			height: 1px;

			margin: 35px 0;

			background: var(--champagne);
		}


		/* =====================================================
		   OCCASIONS
		===================================================== */

		.occasions-section {
			padding-top: 120px;
		}

		.occasions-intro {
			display: grid;

			grid-template-columns: 1.2fr .8fr;

			gap: 100px;

			align-items: end;

			margin-bottom: 55px;
		}

		.occasions-note {
			max-width: 410px;

			margin: 0;

			color: var(--muted);

			font-size: 18px;

			line-height: 1.8;
		}

		.occasion-grid {
			display: grid;

			grid-template-columns: 1fr 1fr;

			gap: 18px;
		}

		.occasion-card {
			position: relative;

			min-height: 470px;

			overflow: hidden;

			background: var(--white);
		}

		.occasion-card img {
			position: absolute;

			inset: 0;

			width: 100%;
			height: 100%;

			object-fit: cover;

			transition:
				transform .9s ease;
		}

		.occasion-card:hover img {
			transform: scale(1.045);
		}

		.occasion-card::after {
			content: "";

			position: absolute;

			inset: 0;

			background:
				linear-gradient(
					0deg,
					rgba(10,10,9,.82),
					rgba(10,10,9,.04) 70%
				);
		}

		.occasion-content {
			position: absolute;

			z-index: 3;

			left: 34px;
			right: 34px;
			bottom: 32px;

			color: white;
		}

		.occasion-number {
			display: block;

			margin-bottom: 13px;

			color: #ddc99e;

			font-size: 10px;
			font-weight: 800;

			letter-spacing: .2em;
		}

		.occasion-card h3 {
			margin: 0 0 9px;

			font-size: 34px;

			line-height: 1;

			letter-spacing: -.04em;
		}

		.occasion-card p {
			max-width: 440px;

			margin: 0;

			color: rgba(255,255,255,.82);

			font-size: 16px;

			line-height: 1.65;
		}


		/* =====================================================
		   FEATURE
		===================================================== */

		.feature {
			display: grid;

			grid-template-columns: 1.2fr .8fr;

			min-height: 700px;

			background: var(--charcoal);

			color: white;
		}

		.feature-image {
			width: 100%;
			height: 100%;

			min-height: 650px;

			object-fit: cover;
		}

		.feature-copy {
			display: flex;

			flex-direction: column;

			justify-content: center;

			padding: 90px;
		}

		.feature-copy .label {
			color: var(--champagne-light);
		}

		.feature-copy h2 {
			margin: 0 0 30px;

			color: white;

			font-size: clamp(46px, 5vw, 70px);

			line-height: .95;

			letter-spacing: -.055em;
		}

		.feature-copy h2 em {
			color: #ddd3c4;
		}

		.feature-copy p {
			max-width: 520px;

			margin: 0;

			color: #b8b5ae;

			font-size: 18px;

			line-height: 1.8;
		}

		.feature-link {
			margin-top: 32px;

			color: var(--champagne-light);

			font-size: 11px;
			font-weight: 800;

			letter-spacing: .13em;

			text-decoration: none;
		}


		/* =====================================================
		   GALLERY
		===================================================== */

		.gallery-heading {
			margin-bottom: 55px;
		}

		.gallery-grid {
			display: grid;

			grid-template-columns: 1.45fr 1fr 1fr;

			grid-template-rows: 330px 330px;

			gap: 12px;
		}

		.gallery-item {
			overflow: hidden;

			background: var(--ivory-2);
		}

		.gallery-item:first-child {
			grid-row: span 2;
		}

		.gallery-item img {
			width: 100%;
			height: 100%;

			object-fit: cover;

			transition: transform .8s ease;
		}

		.gallery-item:hover img {
			transform: scale(1.035);
		}


		/* =====================================================
		   MUSIC
		===================================================== */

		.music-section {
			background: var(--charcoal);

			color: white;
		}

		.music-wrap {
			width: min(var(--max), 90%);

			margin: auto;

			padding: 125px 0;

			display: grid;

			grid-template-columns: 1fr 1fr;

			gap: 110px;

			align-items: center;
		}

		.music-copy .label {
			color: var(--champagne-light);
		}

		.music-copy .section-title {
			color: white;
		}

		.music-copy .section-title em {
			color: #d8d0c3;
		}

		.music-copy p {
			max-width: 570px;

			margin: 30px 0 0;

			color: #b8b5ae;

			font-size: 18px;

			line-height: 1.8;
		}

		.genres {
			display: grid;

			grid-template-columns: 1fr 1fr;
		}

		.genre {
			padding: 26px 0;

			border-bottom: 1px solid rgba(255,255,255,.14);

			color: #e1ddd4;

			font-size: 14px;
			font-weight: 700;

			letter-spacing: .13em;
		}

		.genre::before {
			content: "—";

			margin-right: 12px;

			color: var(--champagne-light);
		}


		/* =====================================================
		   PROFILE
		===================================================== */

		.profile {
			display: grid;

			grid-template-columns: .8fr 1fr;

			gap: 110px;

			align-items: center;
		}

		.profile-photo {
			overflow: hidden;

			background: var(--ivory-2);
		}

		.profile-photo img {
			width: 100%;

			aspect-ratio: 4 / 5;

			object-fit: cover;
		}

		.profile-copy p:not(.label) {
			max-width: 620px;

			margin: 28px 0 0;

			color: var(--muted);

			font-size: 18px;

			line-height: 1.8;
		}


		/* =====================================================
		   BOOKING
		===================================================== */

		.booking-section {
			background: var(--white);

			border-top: 1px solid var(--line);
		}

		.booking {
			width: min(var(--max), 90%);

			margin: auto;

			padding: 135px 0 155px;
		}

		.booking-grid {
			display: grid;

			grid-template-columns: .85fr 1.15fr;

			gap: 100px;

			align-items: start;
		}

		.booking-copy h2 {
			margin: 0;

			color: var(--text);

			font-size: clamp(48px, 5.5vw, 74px);

			line-height: .95;

			letter-spacing: -.055em;
		}

		.booking-copy h2 em {
			color: #625b50;
		}

		.booking-copy > p {
			max-width: 540px;

			margin: 30px 0 0;

			color: var(--muted);

			font-size: 18px;

			line-height: 1.8;
		}

		.booking-actions {
			display: flex;

			gap: 12px;

			margin-top: 35px;
		}

		.booking-actions .button-outline {
			border-color: #8e887d;

			color: var(--text);
		}

		.booking-actions .button-outline:hover {
			background: var(--charcoal);

			color: white;
		}


		/* =====================================================
		   FORM
		===================================================== */

		.form {
			padding: 42px;

			background: var(--ivory);

			border: 1px solid var(--line);
		}

		.form-title {
			margin-bottom: 30px;

			font-size: 11px;
			font-weight: 800;

			letter-spacing: .15em;
		}

		.form-grid {
			display: grid;

			grid-template-columns: 1fr 1fr;

			gap: 24px;
		}

		.field {
			display: flex;

			flex-direction: column;

			gap: 8px;
		}

		.field.full {
			grid-column: span 2;
		}

		.field label {
			color: #77736c;

			font-size: 10px;
			font-weight: 800;

			letter-spacing: .12em;
		}

		.field input,
		.field select,
		.field textarea {
			width: 100%;

			padding: 13px 0;

			background: transparent;

			border: 0;

			border-bottom: 1px solid rgba(25,25,25,.2);

			outline: none;

			color: var(--text);

			font-size: 16px;
		}

		.field textarea {
			min-height: 105px;

			resize: vertical;
		}

		.form > .button {
			margin-top: 30px;

			border: 0;

			cursor: pointer;
		}

		.form-status {
			display: none;

			margin-top: 15px;

			color: var(--champagne);

			font-size: 13px;
		}


		/* =====================================================
		   FOOTER
		===================================================== */

		.footer {
			background: var(--ivory);

			border-top: 1px solid var(--line);

			padding: 32px 5vw;
		}

		.footer-inner {
			width: min(var(--max), 100%);

			margin: auto;

			display: flex;

			align-items: center;
			justify-content: space-between;

			gap: 25px;

			color: #858078;

			font-size: 10px;

			letter-spacing: .08em;
		}

		.footer-brand {
			color: var(--text);

			font-size: 14px;
			font-weight: 800;

			letter-spacing: .16em;
		}


		/* =====================================================
		   TABLET
		===================================================== */

		@media (max-width: 900px) {

			.video-header,
			.artist,
			.occasions-intro,
			.music-wrap,
			.profile,
			.booking-grid {
				grid-template-columns: 1fr;

				gap: 45px;
			}

			.video-header {
				padding-bottom: 35px;
			}

			.artist-copy {
				max-width: 700px;
			}

			.feature {
				grid-template-columns: 1fr;
			}

			.feature-image {
				min-height: 550px;
			}

			.feature-copy {
				padding: 75px 8%;
			}

			.booking-grid {
				gap: 60px;
			}
		}


		/* =====================================================
		   MOBILE
		===================================================== */

		@media (max-width: 650px) {

			.nav {
				padding: 20px 22px;
			}

			.nav-links {
				display: none;
			}

			.hero {
				height: 88vh;

				min-height: 650px;
			}

			.hero-image {
				object-position: 62% center;
			}

			.hero-overlay {
				background:
					linear-gradient(
						90deg,
						rgba(12,12,11,.72),
						rgba(12,12,11,.25)
					),

					linear-gradient(
						0deg,
						rgba(12,12,11,.75),
						transparent 65%
					);
			}

			.hero-content {
				width: calc(100% - 44px);

				padding-bottom: 72px;
			}

			.hero h1 {
				font-size: clamp(70px, 21vw, 115px);
			}

			.hero-subtitle {
				font-size: 18px;

				margin-top: 27px;
			}

			.hero-buttons {
				flex-direction: column;

				align-items: stretch;

				max-width: 250px;
			}

			.hero-location {
				right: 22px;

				bottom: 19px;

				font-size: 8px;
			}

			.section {
				width: calc(100% - 44px);

				padding: 90px 0;
			}

			.video-header {
				width: calc(100% - 44px);

				padding: 80px 0 35px;
			}

			.youtube-frame {
				width: min(430px, calc(100% - 44px));
			}

			.video-caption {
				width: min(430px, calc(100% - 44px));

				padding-bottom: 75px;
			}

			.artist-copy p {
				font-size: 18px;
			}

			.occasions-intro {
				margin-bottom: 35px;
			}

			.occasions-note {
				font-size: 17px;
			}

			.occasion-grid {
				grid-template-columns: 1fr;
			}

			.occasion-card {
				min-height: 390px;
			}

			.occasion-card h3 {
				font-size: 31px;
			}

			.occasion-card p {
				font-size: 15px;
			}

			.feature-copy {
				padding: 65px 22px;
			}

			.gallery-grid {
				grid-template-columns: 1fr 1fr;

				grid-template-rows:
					250px
					250px
					250px;
			}

			.gallery-item:first-child {
				grid-row: span 1;
			}

			.music-wrap {
				width: calc(100% - 44px);

				padding: 85px 0;
			}

			.genres {
				grid-template-columns: 1fr 1fr;
			}

			.genre {
				font-size: 12px;
			}

			.profile {
				gap: 40px;
			}

			.profile-copy p:not(.label) {
				font-size: 17px;
			}

			.booking {
				width: calc(100% - 44px);

				padding: 90px 0 110px;
			}

			.booking-copy > p {
				font-size: 17px;
			}

			.booking-actions {
				flex-direction: column;

				align-items: stretch;

				max-width: 270px;
			}

			.form {
				padding: 28px 22px;
			}

			.form-grid {
				grid-template-columns: 1fr;

				gap: 20px;
			}

			.field.full {
				grid-column: auto;
			}

