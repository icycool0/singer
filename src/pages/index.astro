---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead
		title={SITE_TITLE}
		description={SITE_DESCRIPTION}
	/>

	<style>
		:root {
			--cream: #f5f1e8;
			--cream-dark: #ebe4d7;
			--ink: #111318;
			--muted: #6d6a63;
			--gold: #b18b52;
			--gold-light: #d0b17b;
			--white: #ffffff;
			--line: rgba(17, 19, 24, 0.12);
		}

		* {
			box-sizing: border-box;
		}

		html {
			scroll-behavior: smooth;
		}

		body {
			margin: 0;
			background: var(--cream);
			color: var(--ink);
			font-family:
				Inter,
				Helvetica,
				Arial,
				sans-serif;
			-webkit-font-smoothing: antialiased;
		}

		a {
			color: inherit;
		}

		/* =========================================
		   NAVIGATION
		========================================= */

		.site-nav {
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			z-index: 20;

			display: flex;
			align-items: center;
			justify-content: space-between;

			padding: 28px 5vw;
			color: white;
		}

		.logo {
			font-size: 19px;
			font-weight: 800;
			letter-spacing: .18em;
			text-decoration: none;
		}

		.logo-dot {
			color: var(--gold-light);
		}

		.nav-links {
			display: flex;
			align-items: center;
			gap: 34px;
		}

		.nav-links a {
			color: white;
			text-decoration: none;
			font-size: 11px;
			font-weight: 700;
			letter-spacing: .18em;
			opacity: .92;
			transition: opacity .25s ease;
		}

		.nav-links a:hover {
			opacity: .6;
		}

		.nav-book {
			border: 1px solid rgba(255,255,255,.6);
			padding: 14px 20px;
		}

		/* =========================================
		   HERO
		========================================= */

		.hero {
			position: relative;
			min-height: 820px;
			overflow: hidden;

			background:
				linear-gradient(
					90deg,
					#f5f1e8 0%,
					#f5f1e8 39%,
					rgba(245,241,232,.88) 47%,
					rgba(245,241,232,0) 68%
				),
				#d8cbb7;
		}

		.hero-image {
			position: absolute;
			top: 0;
			right: 0;

			width: 68%;
			height: 100%;

			object-fit: cover;
			object-position: center;

			filter: saturate(.96);
		}

		.hero-image::after {
			content: "";
		}

		.hero-shade {
			position: absolute;
			inset: 0;

			background:
				linear-gradient(
					90deg,
					var(--cream) 0%,
					rgba(245,241,232,.96) 28%,
					rgba(245,241,232,.55) 47%,
					rgba(245,241,232,0) 67%
				);

			pointer-events: none;
		}

		.hero-content {
			position: relative;
			z-index: 5;

			width: 100%;
			max-width: 1500px;

			margin: 0 auto;
			padding: 210px 5vw 100px;
		}

		.hero-copy {
			width: min(610px, 48vw);
		}

		.eyebrow {
			margin: 0 0 28px;

			color: var(--gold);
			font-size: 12px;
			font-weight: 800;
			letter-spacing: .25em;
		}

		.hero-title {
			margin: 0;

			font-size: clamp(86px, 10vw, 155px);
			line-height: .78;
			letter-spacing: -.07em;
			font-weight: 900;
		}

		.hero-title .italic {
			display: block;

			margin-top: 8px;

			color: var(--gold);
			font-family: Georgia, "Times New Roman", serif;
			font-size: .78em;
			font-weight: 400;
			font-style: italic;
			letter-spacing: -.06em;
		}

		.hero-description {
			max-width: 510px;
			margin: 38px 0 30px;

			font-size: 19px;
			line-height: 1.6;
			color: #373833;
		}

		.hero-actions {
			display: flex;
			align-items: center;
			gap: 12px;
			flex-wrap: wrap;
		}

		.btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;

			min-height: 52px;
			padding: 0 27px;

			text-decoration: none;

			font-size: 11px;
			font-weight: 800;
			letter-spacing: .15em;

			transition:
				transform .25s ease,
				background .25s ease,
				color .25s ease;
		}

		.btn:hover {
			transform: translateY(-2px);
		}

		.btn-primary {
			background: var(--gold);
			color: white;
		}

		.btn-primary:hover {
			background: #9d793f;
		}

		.btn-outline {
			border: 1px solid rgba(17,19,24,.35);
			color: var(--ink);
		}

		.btn-outline:hover {
			background: var(--ink);
			color: white;
		}

		.hero-location {
			margin-top: 52px;

			font-size: 10px;
			font-weight: 700;
			letter-spacing: .18em;
			color: #777268;
		}

		/* Floating image frame */

		.hero-frame {
			position: absolute;
			z-index: 6;

			right: 6%;
			bottom: 70px;

			width: min(390px, 30vw);

			border: 1px solid rgba(255,255,255,.65);

			box-shadow:
				0 35px 80px rgba(42,31,17,.25);

			overflow: hidden;
		}

		.hero-frame img {
			display: block;
			width: 100%;
			height: auto;
		}

		.hero-frame-label {
			position: absolute;
			left: 0;
			bottom: 0;

			padding: 14px 18px;

			background: rgba(17,19,24,.78);
			backdrop-filter: blur(8px);

			color: white;
			font-size: 9px;
			font-weight: 800;
			letter-spacing: .18em;
		}

		/* Decorative number */

		.hero-number {
			position: absolute;
			z-index: 3;

			right: 4%;
			bottom: 20px;

			font-size: clamp(100px, 16vw, 250px);
			font-weight: 900;
			line-height: .8;
			letter-spacing: -.08em;

			color: rgba(255,255,255,.22);

			user-select: none;
		}

		/* =========================================
		   VIDEO
		========================================= */

		.video-section {
			padding: 130px 5vw;

			background: var(--ink);
			color: white;
		}

		.video-wrap {
			max-width: 1180px;
			margin: auto;

			display: grid;
			grid-template-columns: .75fr 1.25fr;
			gap: 90px;
			align-items: center;
		}

		.video-label {
			color: var(--gold-light);
			font-size: 11px;
			font-weight: 800;
			letter-spacing: .22em;
		}

		.video-heading {
			margin: 18px 0 25px;

			font-size: clamp(42px, 5vw, 72px);
			line-height: .95;
			letter-spacing: -.05em;
		}

		.video-copy {
			max-width: 400px;

			color: #aaa9a3;
			font-size: 17px;
			line-height: 1.7;
		}

		.video-box {
			display: flex;
			justify-content: center;

			padding: 22px;

			background: #191a1d;
			border: 1px solid rgba(255,255,255,.09);
		}

		.video-box iframe {
			display: block;

			width: 100%;
			max-width: 390px;
			aspect-ratio: 9 / 16;

			border: 0;
			background: black;
		}

		/* =========================================
		   EXPERIENCE
		========================================= */

		.experience {
			padding: 135px 5vw;

			background: var(--cream);
		}

		.experience-inner {
			max-width: 1250px;
			margin: auto;
		}

		.section-kicker {
			margin: 0 0 18px;

			color: var(--gold);
			font-size: 11px;
			font-weight: 800;
			letter-spacing: .22em;
		}

		.section-heading {
			max-width: 780px;

			margin: 0;

			font-size: clamp(46px, 6vw, 82px);
			line-height: .95;
			letter-spacing: -.055em;
		}

		.section-intro {
			max-width: 620px;
			margin: 28px 0 60px;

			color: var(--muted);
			font-size: 18px;
			line-height: 1.7;
		}

		/* =========================================
		   PERFORMANCE CARDS
		========================================= */

		.performance-grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);

			border-top: 1px solid var(--line);
			border-bottom: 1px solid var(--line);
		}

		.performance-card {
			position: relative;

			min-height: 320px;
			padding: 32px 28px 30px;

			border-right: 1px solid var(--line);

			transition:
				background .3s ease,
				transform .3s ease;
		}

		.performance-card:last-child {
			border-right: 0;
		}

		.performance-card:hover {
			background: white;
			transform: translateY(-5px);
		}

		.card-number {
			font-size: 11px;
			font-weight: 800;
			letter-spacing: .15em;
			color: var(--gold);
		}

		.card-icon {
			width: 55px;
			height: 55px;

			display: flex;
			align-items: center;
			justify-content: center;

			margin: 42px 0 28px;

			border: 1px solid rgba(177,139,82,.4);
			border-radius: 50%;

			color: var(--gold);

			font-family: Georgia, serif;
			font-size: 22px;
		}

		.performance-card h3 {
			margin: 0 0 13px;

			font-size: 25px;
			letter-spacing: -.025em;
		}

		.performance-card p {
			margin: 0;

			color: var(--muted);
			font-size: 14px;
			line-height: 1.65;
		}

		/* =========================================
		   FEATURE IMAGE
		========================================= */

		.feature {
			max-width: 1400px;
			margin: 0 auto;

			padding: 0 5vw 135px;

			background: var(--cream);
		}

		.feature-grid {
			display: grid;
			grid-template-columns: 1.25fr .75fr;

			min-height: 620px;
		}

		.feature-image {
			overflow: hidden;
		}

		.feature-image img {
			display: block;

			width: 100%;
			height: 100%;

			object-fit: cover;
			object-position: center;
		}

		.feature-copy {
			display: flex;
			flex-direction: column;
			justify-content: center;

			padding: 70px;

			background: #17181b;
			color: white;
		}

		.feature-copy h2 {
			margin: 15px 0 25px;

			font-size: clamp(42px, 5vw, 68px);
			line-height: .98;
			letter-spacing: -.05em;
		}

		.feature-copy p {
			color: #a8a7a2;
			font-size: 16px;
			line-height: 1.75;
		}

		.feature-link {
			margin-top: 25px;

			color: var(--gold-light);
			text-decoration: none;

			font-size: 11px;
			font-weight: 800;
			letter-spacing: .16em;
		}

		/* =========================================
		   GALLERY
		========================================= */

		.gallery {
			padding: 130px 5vw;

			background: #eae3d7;
		}

		.gallery-inner {
			max-width: 1250px;
			margin: auto;
		}

		.gallery-grid {
			display: grid;
			grid-template-columns: 1.3fr .7fr .7fr;
			grid-template-rows: 300px 300px;

			gap: 12px;

			margin-top: 55px;
		}

		.gallery-grid img {
			width: 100%;
			height: 100%;

			object-fit: cover;

			display: block;

			transition: transform .5s ease;
		}

		.gallery-item {
			overflow: hidden;
		}

		.gallery-item:hover img {
			transform: scale(1.04);
		}

		.gallery-item:first-child {
			grid-row: span 2;
		}

		/* =========================================
		   BOOKING
		========================================= */

		.booking {
			padding: 150px 5vw;

			background: var(--ink);
			color: white;

			text-align: center;
		}

		.booking-inner {
			max-width: 850px;
			margin: auto;
		}

		.booking h2 {
			margin: 15px 0 25px;

			font-size: clamp(55px, 8vw, 105px);
			line-height: .85;
			letter-spacing: -.065em;
		}

		.booking p {
			max-width: 570px;
			margin: 0 auto 38px;

			color: #a7a6a1;
			font-size: 17px;
			line-height: 1.7;
		}

		.booking .btn-outline {
			border-color: rgba(255,255,255,.4);
			color: white;
		}

		/* =========================================
		   MOBILE
		========================================= */

		@media (max-width: 1000px) {

			.nav-links {
				gap: 18px;
			}

			.hero {
				min-height: 850px;
				background: var(--cream);
			}

			.hero-image {
				width: 100%;
				height: 58%;

				top: 0;
				right: 0;

				object-position: center top;
			}

			.hero-shade {
				background:
					linear-gradient(
						180deg,
						rgba(245,241,232,0) 25%,
						rgba(245,241,232,.7) 50%,
						var(--cream) 68%
					);
			}

			.hero-content {
				padding-top: 490px;
			}

			.hero-copy {
				width: 100%;
			}

			.hero-frame {
				display: none;
			}

			.hero-number {
				display: none;
			}

			.video-wrap {
				grid-template-columns: 1fr;
				gap: 50px;
			}

			.performance-grid {
				grid-template-columns: 1fr 1fr;
			}

			.performance-card:nth-child(2) {
				border-right: 0;
			}

			.performance-card:nth-child(-n+2) {
				border-bottom: 1px solid var(--line);
			}

			.feature-grid {
				grid-template-columns: 1fr;
			}

			.feature-image {
				min-height: 500px;
			}
		}

		@media (max-width: 650px) {

			.site-nav {
				padding: 22px 20px;
			}

			.nav-links a:not(.nav-book) {
				display: none;
			}

			.nav-book {
				padding: 11px 14px;
			}

			.hero {
				min-height: 790px;
			}

			.hero-image {
				height: 52%;
			}

			.hero-content {
				padding:
					420px
					20px
					70px;
			}

			.hero-title {
				font-size: clamp(70px, 19vw, 110px);
			}

			.hero-description {
				font-size: 16px;
				margin-top: 28px;
			}

			.hero-location {
				margin-top: 35px;
			}

			.video-section,
			.experience,
			.gallery {
				padding: 85px 20px;
			}

			.feature {
				padding: 0 20px 85px;
			}

			.video-box {
				padding: 10px;
			}

			.video-box iframe {
				max-width: 100%;
			}

			.performance-grid {
				grid-template-columns: 1fr;
			}

			.performance-card {
				min-height: 270px;

				border-right: 0;
				border-bottom: 1px solid var(--line);
			}

			.performance-card:last-child {
				border-bottom: 0;
			}

			.card-icon {
				margin-top: 30px;
			}

			.feature-image {
				min-height: 390px;
			}

			.feature-copy {
				padding: 50px 28px;
			}

			.gallery-grid {
				grid-template-columns: 1fr 1fr;
				grid-template-rows: 240px 240px 240px;
			}

			.gallery-item:first-child {
				grid-column: span 2;
				grid-row: span 1;
			}

			.booking {
				padding: 100px 20px;
			}
		}
	</style>
</head>

<body>

	<!-- =========================================
	     PREMIUM NAV
	========================================= -->

	<header class="site-nav">

		<a href="/" class="logo">
			ROUSHAN<span class="logo-dot">.</span>
		</a>

		<nav class="nav-links">
			<a href="#experience">ABOUT</a>
			<a href="#live">LIVE</a>
			<a href="#gallery">GALLERY</a>
			<a href="#music">MUSIC</a>
			<a href="#booking" class="nav-book">BOOK NOW</a>
		</nav>

	</header>


	<main>

		<!-- =========================================
		     HERO
		========================================= -->

		<section class="hero">

			<img
				class="hero-image"
				src="/hero_holding_mic.png"
				alt="Roushan performing live in Patna"
			/>

			<div class="hero-shade"></div>

			<div class="hero-number">01</div>

			<div class="hero-content">

				<div class="hero-copy">

					<p class="eyebrow">
						SINGER • LIVE PERFORMER • PATNA
					</p>

					<h1 class="hero-title">
						Bring
						<span class="italic">the music.</span>
					</h1>

					<p class="hero-description">
						Live music for weddings, celebrations,
						private events and unforgettable occasions.
					</p>

					<div class="hero-actions">

						<a
							href="#live"
							class="btn btn-primary"
						>
							▶ &nbsp; WATCH ROUSHAN LIVE
						</a>

						<a
							href="#booking"
							class="btn btn-outline"
						>
							BOOK ROUSHAN ↗
						</a>

					</div>

					<p class="hero-location">
						PATNA, BIHAR • AVAILABLE FOR EVENTS
					</p>

				</div>

			</div>

			<div class="hero-frame">

				<img
					src="/hero_holding_mic.png"
					alt="Roushan singing"
				/>

				<div class="hero-frame-label">
					LIVE PERFORMANCE • ROUSHAN
				</div>

			</div>

		</section>


		<!-- =========================================
		     VIDEO
		========================================= -->

		<section class="video-section" id="live">

			<div class="video-wrap">

				<div>

					<p class="video-label">
						LIVE PERFORMANCE
					</p>

					<h2 class="video-heading">
						Hear the voice.<br />
						Feel the moment.
					</h2>

					<p class="video-copy">
						A glimpse of Roushan performing live.
						For weddings, celebrations and events
						where the music needs to become part
						of the memory.
					</p>

				</div>

				<div class="video-box">

					<iframe
						src="https://www.youtube.com/embed/VweCAaReLpo?rel=0"
						title="Roushan live performance"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						allowfullscreen
					></iframe>

				</div>

			</div>

		</section>


		<!-- =========================================
		     EXPERIENCE
		========================================= -->

		<section
			class="experience"
			id="experience"
		>

			<div class="experience-inner">

				<p class="section-kicker">
					AVAILABLE FOR
				</p>

				<h2 class="section-heading">
					Available for your special moments.
				</h2>

				<p class="section-intro">
					Choose the kind of occasion and we'll shape
					the performance around the atmosphere you want.
				</p>


				<div class="performance-grid">

					<!-- CARD 01 -->

					<article class="performance-card">

						<div class="card-number">
							01
						</div>

						<div class="card-icon">
							♢
						</div>

						<h3>Weddings</h3>

						<p>
							Live music for wedding celebrations,
							sangeet and memorable moments.
						</p>

					</article>


					<!-- CARD 02 -->

					<article class="performance-card">

						<div class="card-number">
							02
						</div>

						<div class="card-icon">
							♪ 
						</div>

						<h3>Events</h3>

						<p>
							Live performances for private,
							social and special events.
						</p>

					</article>


					<!-- CARD 03 -->

					<article class="performance-card">

						<div class="card-number">
							03
						</div>

						<div class="card-icon">
							✦
						</div>

						<h3>Birthdays</h3>

						<p>
							Make birthdays and celebrations
							more memorable with live music.
						</p>

					</article>


					<!-- CARD 04 -->

					<article class="performance-card">

						<div class="card-number">
							04
						</div>

						<div class="card-icon">
							◉
						</div>

						<h3>Corporate</h3>

						<p>
							Professional live entertainment
							for corporate events and gatherings.
						</p>

					</article>

				</div>

			</div>

		</section>


		<!-- =========================================
		     FEATURE
		========================================= -->

		<section class="feature" id="music">

			<div class="feature-grid">

				<div class="feature-image">

					<img
						src="/hero_event_standing.jpeg"
						alt="Roushan performing at an event"
						loading="lazy"
					/>

				</div>

				<div class="feature-copy">

					<p class="section-kicker">
						THE LIVE EXPERIENCE
					</p>

					<h2>
						Every event deserves its own soundtrack.
					</h2>

					<p>
						From intimate celebrations to energetic
						live events, Roushan brings a versatile
						performance experience to every occasion.
					</p>

					<a
						href="#booking"
						class="feature-link"
					>
						PLAN YOUR EVENT →
					</a>

				</div>

			</div>

