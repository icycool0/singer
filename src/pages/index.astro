---
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="en">
<head>

	<BaseHead
		title="Roushan | Singer & Live Performer in Patna"
		description="Roushan is a singer and live performer in Patna, available for weddings, events, birthdays, corporate occasions and private celebrations."
	/>

	<style>

		/* =====================================================
		   DESIGN SYSTEM
		===================================================== */

		:root {
			--bg: #08090b;
			--surface: #101114;
			--surface-light: #15161a;

			--white: #f5f2eb;
			--muted: #b8b5ae;
			--muted-bright: #d0cdc5;

			--gold: #d5b16f;
			--gold-light: #e5ca91;

			--line: rgba(255,255,255,.11);

			--max: 1280px;
		}


		/* =====================================================
		   RESET
		===================================================== */

		* {
			box-sizing: border-box;
		}

		html {
			scroll-behavior: smooth;
		}

		body {
			margin: 0;
			padding: 0;
			background: var(--bg);
			color: var(--white);

			font-family:
				Inter,
				Arial,
				Helvetica,
				sans-serif;

			-webkit-font-smoothing: antialiased;
		}

		a {
			color: inherit;
		}

		img {
			display: block;
			max-width: 100%;
		}


		/* =====================================================
		   NAVIGATION
		===================================================== */

		.nav {
			position: absolute;
			z-index: 50;

			top: 0;
			left: 0;

			width: 100%;

			padding: 28px 5vw;
		}

		.nav-inner {
			width: min(var(--max), 100%);
			margin: auto;

			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		.logo {
			text-decoration: none;

			font-size: 19px;
			font-weight: 800;

			letter-spacing: .15em;
		}

		.logo span {
			color: var(--gold);
		}

		.nav-links {
			display: flex;
			align-items: center;
			gap: 30px;
		}

		.nav-links a {
			text-decoration: none;

			font-size: 11px;
			font-weight: 700;

			letter-spacing: .14em;

			color: rgba(255,255,255,.86);

			transition: opacity .25s ease;
		}

		.nav-links a:hover {
			opacity: .55;
		}

		.nav-book {
			padding: 12px 18px;

			border: 1px solid rgba(255,255,255,.4);
		}


		/* =====================================================
		   HERO
		===================================================== */

		.hero {
			position: relative;

			height: 90vh;
			min-height: 680px;

			overflow: hidden;

			display: flex;
			align-items: center;
		}

		.hero-image {
			position: absolute;

			inset: 0;

			width: 100%;
			height: 100%;

			object-fit: cover;

			object-position: center 30%;

			transform: scale(1.015);
		}

		.hero-overlay {
			position: absolute;

			inset: 0;

			background:
				linear-gradient(
					90deg,
					rgba(4,5,7,.94) 0%,
					rgba(4,5,7,.72) 35%,
					rgba(4,5,7,.30) 72%,
					rgba(4,5,7,.34) 100%
				),

				linear-gradient(
					0deg,
					rgba(4,5,7,.88),
					transparent 62%
				);
		}

		.hero-content {
			position: relative;
			z-index: 5;

			width: min(var(--max), 90%);

			margin: 20px auto 0;
		}

		.eyebrow {
			margin: 0 0 21px;

			color: var(--gold);

			font-size: 11px;
			font-weight: 800;

			letter-spacing: .25em;
		}

		.hero h1 {
			margin: 0;

			max-width: 800px;

			font-size: clamp(78px, 12vw, 175px);

			line-height: .78;

			letter-spacing: -.075em;

			font-weight: 850;
		}

		.hero-subtitle {
			max-width: 600px;

			margin: 38px 0 0;

			color: var(--muted-bright);

			font-size: clamp(19px, 2vw, 25px);

			line-height: 1.55;
		}

		.hero-buttons {
			display: flex;

			gap: 12px;

			margin-top: 32px;
		}

		.button {
			display: inline-flex;

			align-items: center;
			justify-content: center;

			min-height: 50px;

			padding: 0 25px;

			text-decoration: none;

			font-size: 11px;
			font-weight: 800;

			letter-spacing: .15em;

			transition:
				transform .25s ease,
				background .25s ease,
				color .25s ease;
		}

		.button:hover {
			transform: translateY(-2px);
		}

		.button-primary {
			background: var(--gold);

			color: #111;
		}

		.button-primary:hover {
			background: var(--gold-light);
		}

		.button-outline {
			border: 1px solid rgba(255,255,255,.55);

			color: white;
		}

		.button-outline:hover {
			background: white;
			color: #111;
		}

		.hero-location {
			position: absolute;

			right: 5vw;
			bottom: 28px;

			z-index: 5;

			color: rgba(255,255,255,.58);

			font-size: 10px;

			letter-spacing: .2em;
		}


		/* =====================================================
		   COMMON
		===================================================== */

		.section {
			width: min(var(--max), 90%);

			margin: auto;

			padding: 125px 0;
		}

		.label {
			margin: 0 0 17px;

			color: var(--gold);

			font-size: 10px;
			font-weight: 800;

			letter-spacing: .25em;

			text-transform: uppercase;
		}

		.section-title {
			margin: 0;

			max-width: 900px;

			font-size: clamp(44px, 6vw, 78px);

			line-height: .95;

			letter-spacing: -.055em;

			font-weight: 750;
		}


		/* =====================================================
		   VIDEO
		===================================================== */

		.cinematic {
			width: min(1180px, 90%);

			margin: auto;

			padding: 105px 0 125px;
		}

		.cinematic-header {
			display: flex;

			align-items: flex-end;
			justify-content: space-between;

			gap: 50px;

			margin-bottom: 35px;
		}

		.cinematic-note {
			max-width: 380px;

			margin: 0;

			color: var(--muted);

			font-size: 17px;

			line-height: 1.75;
		}

		.youtube-frame {
			position: relative;

			width: 100%;

			aspect-ratio: 16 / 9;

			overflow: hidden;

			background: #000;

			box-shadow:
				0 30px 90px rgba(0,0,0,.4);
		}

		.youtube-frame iframe {
			position: absolute;

			inset: 0;

			width: 100%;
			height: 100%;

			border: 0;
		}


		/* =====================================================
		   ARTIST
		===================================================== */

		.artist {
			display: grid;

			grid-template-columns: 1fr 1fr;

			gap: 100px;

			align-items: start;
		}

		.artist-copy {
			max-width: 600px;

			margin-left: auto;

			padding-top: 15px;
		}

		.artist-copy p {
			margin: 0;

			color: var(--muted);

			font-size: 19px;

			line-height: 1.85;
		}

		.artist-line {
			width: 75px;
			height: 1px;

			margin: 32px 0;

			background: var(--gold);
		}


		/* =====================================================
		   EXPERIENCE / OCCASIONS
		===================================================== */

		.experience-intro {
			display: grid;

			grid-template-columns: 1.3fr .7fr;

			gap: 80px;

			align-items: end;

			margin-bottom: 58px;
		}

		.experience-note {
			margin: 0;

			color: var(--muted);

			font-size: 17px;

			line-height: 1.75;
		}

		.performance-grid {
			display: grid;

			grid-template-columns: 1fr 1fr;

			gap: 2px;

			background: var(--line);
		}

		.performance-card {
			position: relative;

			min-height: 400px;

			overflow: hidden;

			background: var(--surface);
		}

		.performance-card img {
			position: absolute;

			inset: 0;

			width: 100%;
			height: 100%;

			object-fit: cover;

			opacity: .62;

			transition:
				transform .8s ease,
				opacity .6s ease;
		}

		.performance-card:hover img {
			transform: scale(1.045);

			opacity: .73;
		}

		.performance-card::after {
			content: "";

			position: absolute;

			inset: 0;

			background:
				linear-gradient(
					0deg,
					rgba(5,5,6,.96),
					rgba(5,5,6,.08) 75%
				);
		}

		.performance-content {
			position: absolute;

			z-index: 3;

			left: 32px;
			right: 32px;
			bottom: 30px;
		}

		.performance-number {
			display: block;

			margin-bottom: 15px;

			color: var(--gold);

			font-size: 11px;
			font-weight: 800;

			letter-spacing: .2em;
		}

		.performance-icon {
			position: absolute;

			z-index: 4;

			top: 25px;
			right: 27px;

			width: 46px;
			height: 46px;

			border: 1px solid rgba(255,255,255,.35);

			border-radius: 50%;

			display: grid;
			place-items: center;

			color: white;

			font-size: 18px;
		}

		.performance-card h3 {
			margin: 0 0 10px;

			font-size: 32px;

			letter-spacing: -.035em;
		}

		.performance-card p {
			max-width: 430px;

			margin: 0;

			color: rgba(255,255,255,.76);

			font-size: 16px;

			line-height: 1.7;
		}


		/* =====================================================
		   LIVE EXPERIENCE
		===================================================== */

		.feature {
			display: grid;

			grid-template-columns: 1.2fr .8fr;

			min-height: 680px;
		}

		.feature-image {
			width: 100%;
			height: 100%;

			min-height: 620px;

			object-fit: cover;
		}

		.feature-copy {
			display: flex;

			flex-direction: column;

			justify-content: center;

			padding: 80px;
			
			background: var(--surface-light);
		}

		.feature-copy h2 {
			margin: 0 0 30px;

			font-size: clamp(44px, 5vw, 68px);

			line-height: .95;

			letter-spacing: -.055em;
		}

		.feature-copy p {
			margin: 0;

			color: var(--muted);

			font-size: 18px;

			line-height: 1.8;
		}

		.feature-link {
			margin-top: 32px;

			color: var(--gold);

			font-size: 11px;
			font-weight: 800;

			letter-spacing: .12em;

			text-decoration: none;
		}


		/* =====================================================
		   GALLERY
		===================================================== */

		.gallery-heading {
			margin-bottom: 48px;
		}

		.gallery-grid {
			display: grid;

			grid-template-columns: 1.5fr 1fr 1fr;

			grid-template-rows: 310px 310px;

			gap: 10px;
		}

		.gallery-item {
			overflow: hidden;

			background: var(--surface);
		}

		.gallery-item:first-child {
			grid-row: span 2;
		}

		.gallery-item img {
			width: 100%;
			height: 100%;

			object-fit: cover;

			transition: transform .8s ease;
		}

		.gallery-item:hover img {
			transform: scale(1.04);
		}


		/* =====================================================
		   MUSIC
		===================================================== */

		.music-section {
			border-top: 1px solid var(--line);
			border-bottom: 1px solid var(--line);
		}

		.music-wrap {
			display: grid;

			grid-template-columns: 1fr 1fr;

			gap: 100px;

			align-items: center;
		}

		.music-copy p {
			max-width: 560px;

			margin: 30px 0 0;

			color: var(--muted);

			font-size: 18px;

			line-height: 1.8;
		}

		.genres {
			display: grid;

			grid-template-columns: 1fr 1fr;

			border-top: 1px solid var(--line);
		}

		.genre {
			padding: 25px 0;

			border-bottom: 1px solid var(--line);

			color: var(--muted-bright);

			font-size: 13px;
			font-weight: 700;

			letter-spacing: .13em;
		}


		/* =====================================================
		   ABOUT PROFILE
		===================================================== */

		.profile {
			display: grid;

			grid-template-columns: .85fr 1fr;

			gap: 100px;

			align-items: center;
		}

		.profile-photo {
			overflow: hidden;

			background: var(--surface);
		}

		.profile-photo img {
			width: 100%;

			aspect-ratio: 4 / 5;

			object-fit: cover;
		}

		.profile-copy p {
			max-width: 620px;

			margin: 28px 0 0;

			color: var(--muted);

			font-size: 18px;

			line-height: 1.8;
		}


		/* =====================================================
		   BOOKING
		===================================================== */

		.booking {
			padding: 145px 0 165px;

			border-top: 1px solid var(--line);
		}

		.booking-grid {
			display: grid;

			grid-template-columns: .85fr 1.15fr;

			gap: 100px;

			align-items: start;
		}

		.booking-copy h2 {
			margin: 0;

			font-size: clamp(46px, 5.5vw, 74px);

			line-height: .95;

			letter-spacing: -.055em;
		}

		.booking-copy > p {
			max-width: 530px;

			margin: 30px 0 0;

			color: var(--muted);

			font-size: 18px;

			line-height: 1.8;
		}

		.booking-actions {
			display: flex;

			gap: 12px;

			margin-top: 35px;
		}


		/* =====================================================
		   FORM
		===================================================== */

		.form {
			padding: 38px;

			background: var(--surface);

			border: 1px solid var(--line);
		}

		.form-title {
			margin-bottom: 28px;

			font-size: 11px;
			font-weight: 800;

			letter-spacing: .16em;
		}

		.form-grid {
			display: grid;

			grid-template-columns: 1fr 1fr;

			gap: 22px;
		}

		.field {
			display: flex;

			flex-direction: column;

			gap: 9px;
		}

		.field.full {
			grid-column: span 2;
		}

		.field label {
			color: #85858a;

			font-size: 10px;
			font-weight: 800;

			letter-spacing: .13em;
		}

		.field input,
		.field select,
		.field textarea {
			width: 100%;

			padding: 14px 0;

			background: transparent;

			border: 0;
			border-bottom: 1px solid rgba(255,255,255,.17);

			outline: none;

			color: white;

			font-family: inherit;

			font-size: 16px;
		}

		.field select {
			color: white;
		}

		.field select option {
			background: #111;
			color: white;
		}

		.field textarea {
			min-height: 100px;

			resize: vertical;
		}

		.form > .button {
			margin-top: 28px;

			border: 0;

			cursor: pointer;
		}


		/* =====================================================
		   FOOTER
		===================================================== */

		.footer {
			border-top: 1px solid var(--line);

			padding: 32px 5vw;
		}

		.footer-inner {
			width: min(var(--max), 100%);

			margin: auto;

			display: flex;

			align-items: center;
			justify-content: space-between;

			gap: 25px;

			color: #707176;

			font-size: 10px;

			letter-spacing: .08em;
		}

		.footer-brand {
			color: white;

			font-size: 14px;
			font-weight: 800;

			letter-spacing: .16em;
		}


		/* =====================================================
		   MOBILE
		===================================================== */

		@media (max-width: 800px) {

			.nav {
				padding: 20px 22px;
			}

			.nav-links {
				display: none;
			}

			.hero {
				height: 87vh;
				min-height: 650px;
			}

			.hero-content {
				width: calc(100% - 44px);
			}

			.hero h1 {
				font-size: clamp(72px, 21vw, 120px);
			}

			.hero-subtitle {
				margin-top: 28px;

				font-size: 18px;
			}

			.hero-location {
				right: 22px;
				bottom: 20px;
			}

			.section {
				width: calc(100% - 44px);

				padding: 88px 0;
			}

			.cinematic {
				width: calc(100% - 44px);

				padding: 75px 0 90px;
			}

			.cinematic-header {
				display: block;
			}

			.cinematic-note {
				margin-top: 20px;

				font-size: 17px;
			}

			.youtube-frame {
				aspect-ratio: 16 / 9;
			}

			.artist {
				grid-template-columns: 1fr;

				gap: 35px;
			}

			.artist-copy {
				margin: 0;
			}

			.artist-copy p {
				font-size: 18px;
			}

			.experience-intro {
				grid-template-columns: 1fr;

				gap: 25px;
			}

			.experience-note {
				font-size: 17px;
			}

			.performance-grid {
				grid-template-columns: 1fr;
			}

			.performance-card {
				min-height: 350px;
			}

			.performance-card p {
				font-size: 16px;
			}

			.feature {
				grid-template-columns: 1fr;
			}

			.feature-image {
				min-height: 480px;
			}

			.feature-copy {
				padding: 65px 25px;
			}

			.feature-copy p {
				font-size: 17px;
			}

			.gallery-grid {
				grid-template-columns: 1fr 1fr;

				grid-template-rows:
					250px
					250px
					250px;
			}

			.gallery-item:first-child {
				grid-row: span 1;
			}

			.music-wrap {
				grid-template-columns: 1fr;

				gap: 55px;
			}

			.profile {
				grid-template-columns: 1fr;

				gap: 45px;
			}

			.profile-copy p {
				font-size: 17px;
			}

			.booking {
				padding: 100px 22px 120px;
			}

			.booking-grid {
				grid-template-columns: 1fr;

				gap: 55px;
			}

			.booking-copy > p {
				font-size: 17px;
			}

			.booking-actions {
				flex-direction: column;

				align-items: stretch;

				max-width: 270px;
			}

			.form-grid {
				grid-template-columns: 1fr;
			}

			.field.full {
				grid-column: auto;
			}

			.form {
				padding: 27px 22px;
			}

			.footer-inner {
				flex-direction: column;

				align-items: flex-start;

				gap: 12px;
			}
		}


		/* =====================================================
		   SMALL MOBILE
		===================================================== */

		@media (max-width: 500px) {

			.hero-buttons {
				flex-direction: column;

				align-items: stretch;

				max-width: 235px;
			}

			.button {
				width: 100%;
			}

			.performance-card {
				min-height: 330px;
			}

			.gallery-grid {
				grid-template-columns: 1fr;

				grid-template-rows:
					repeat(5, 320px);
			}

		}

	</style>

</head>


<body>


	<!-- =====================================================
	     NAVIGATION
	===================================================== -->

	<header class="nav">

		<div class="nav-inner">

			<a
				href="/"
				class="logo"
			>
				ROUSHAN<span>.</span>
			</a>

			<nav class="nav-links">

				<a href="#about">
					ABOUT
				</a>

				<a href="#performance">
					LIVE
				</a>

				<a href="#gallery">
					GALLERY
				</a>

				<a href="#music">
					MUSIC
				</a>

				<a
					href="#contact"
					class="nav-book"
				>
					BOOK NOW
				</a>

			</nav>

		</div>

	</header>



	<main>


		<!-- =================================================
		     HERO
		================================================= -->

		<section class="hero">

			<img
				class="hero-image"
				src="/hero_live3.jpg"
				alt="Roushan performing live on stage in Patna"
				fetchpriority="high"
				decoding="async"
			/>

			<div class="hero-overlay"></div>


			<div class="hero-content">

				<p class="eyebrow">
					SINGER · LIVE PERFORMER · PATNA
				</p>

				<h1>
					Bring the
					<br />
					<em>music.</em>
				</h1>

				<p class="hero-subtitle">
					Live music for weddings, celebrations,
					private events and special occasions.
				</p>


				<div class="hero-buttons">

					<a
						href="#performance"
						class="button button-primary"
					>
						▶ &nbsp; WATCH LIVE
					</a>

					<a
						href="#contact"
						class="button button-outline"
					>
						BOOK ROUSHAN ↗
					</a>

				</div>

			</div>


			<div class="hero-location">
				PATNA, BIHAR · AVAILABLE FOR EVENTS
			</div>

		</section>



		<!-- =================================================
		     YOUTUBE PERFORMANCE
		================================================= -->

		<section
			class="cinematic"
			id="performance"
		>

			<div class="cinematic-header">

				<div>

					<p class="label">
						01 / FEATURED PERFORMANCE
					</p>

					<h2 class="section-title">
						See Roushan
						<br />
						<em>Live.</em>
