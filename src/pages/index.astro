---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead
		title={SITE_TITLE}
		description={SITE_DESCRIPTION}
	/>

	<style>
		:root {
			--ivory: #f4f0e8;
			--ivory-2: #ebe5da;
			--white: #fffdf9;
			--charcoal: #191919;
			--text: #20201e;
			--muted: #66635d;
			--muted-light: #89857d;
			--champagne: #a88b5c;
			--champagne-light: #c7ad7d;
			--line: rgba(25,25,25,.14);
			--max: 1280px;
		}

		* {
			box-sizing: border-box;
		}

		html {
			scroll-behavior: smooth;
		}

		body {
			margin: 0;
			background: var(--ivory);
			color: var(--text);
			font-family:
				Inter,
				Arial,
				Helvetica,
				sans-serif;
			-webkit-font-smoothing: antialiased;
			overflow-x: hidden;
		}

		a {
			color: inherit;
		}

		img {
			display: block;
			max-width: 100%;
		}

		button,
		input,
		select,
		textarea {
			font-family: inherit;
		}

		em {
			font-family: Georgia, "Times New Roman", serif;
			font-weight: 400;
		}


		/* =====================================================
		   NAVIGATION
		===================================================== */

		.nav {
			position: absolute;
			z-index: 100;
			top: 0;
			left: 0;
			width: 100%;
			padding: 28px 5vw;
			color: white;
		}

		.nav-inner {
			width: min(var(--max), 100%);
			margin: auto;

			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		.logo {
			text-decoration: none;
			font-size: 18px;
			font-weight: 800;
			letter-spacing: .17em;
		}

		.logo span {
			color: var(--champagne-light);
		}

		.nav-links {
			display: flex;
			align-items: center;
			gap: 30px;
		}

		.nav-links a {
			text-decoration: none;
			font-size: 11px;
			font-weight: 700;
			letter-spacing: .13em;
			color: rgba(255,255,255,.9);
			transition: opacity .25s ease;
		}

		.nav-links a:hover {
			opacity: .6;
		}

		.nav-book {
			padding: 11px 17px;
			border: 1px solid rgba(255,255,255,.55);
		}


		/* =====================================================
		   HERO
		===================================================== */

		.hero {
			position: relative;
			min-height: 820px;
			height: 90vh;
			overflow: hidden;

			background: var(--ivory);
			color: var(--text);
		}

		.hero-image {
			position: absolute;
			z-index: 1;

			top: 0;
			right: 0;

			width: 67%;
			height: 100%;

			object-fit: cover;
			object-position: center center;

			transform: scale(1.01);
		}

		.hero-overlay {
			position: absolute;
			z-index: 2;

			inset: 0;

			background:
				linear-gradient(
					90deg,
					#f4f0e8 0%,
					#f4f0e8 28%,
					rgba(244,240,232,.98) 38%,
					rgba(244,240,232,.78) 48%,
					rgba(244,240,232,.25) 61%,
					rgba(244,240,232,0) 72%
				);
		}

		.hero-content {
			position: relative;
			z-index: 5;

			width: min(var(--max), 100%);

			margin: auto;

			padding:
				205px
				5vw
				90px;
		}

		.hero-copy {
			width: min(590px, 48vw);
		}

		.eyebrow {
			margin: 0 0 24px;

			color: var(--champagne);

			font-size: 11px;
			font-weight: 800;

			letter-spacing: .24em;
		}

		.hero h1 {
			margin: 0;

			font-size: clamp(82px, 10vw, 150px);

			line-height: .78;

			letter-spacing: -.075em;

			font-weight: 900;
		}

		.hero h1 span {
			display: block;

			margin-top: 9px;

			color: var(--champagne);

			font-family:
				Georgia,
				"Times New Roman",
				serif;

			font-size: .78em;

			font-weight: 400;

			font-style: italic;

			letter-spacing: -.065em;
		}

		.hero-subtitle {
			max-width: 520px;

			margin: 38px 0 30px;

			color: #393933;

			font-size: 19px;

			line-height: 1.6;
		}

		.hero-buttons {
			display: flex;
			align-items: center;
			gap: 12px;
			flex-wrap: wrap;
		}

		.button {
			display: inline-flex;

			align-items: center;
			justify-content: center;

			min-height: 51px;

			padding: 0 24px;

			text-decoration: none;

			font-size: 11px;
			font-weight: 800;

			letter-spacing: .14em;

			transition:
				transform .25s ease,
				background .25s ease,
				color .25s ease;
		}

		.button:hover {
			transform: translateY(-2px);
		}

		.primary {
			background: var(--champagne);
			color: white;
		}

		.primary:hover {
			background: #967a4e;
		}

		.secondary {
			border: 1px solid rgba(25,25,25,.35);
			color: var(--text);
		}

		.secondary:hover {
			background: var(--charcoal);
			color: white;
		}

		.hero-location {
			margin-top: 43px;

			color: #7d786f;

			font-size: 10px;
			font-weight: 700;

			letter-spacing: .18em;
		}


		/* =====================================================
		   VIDEO
		===================================================== */

		.video-section {
			background: var(--ivory);
		}

		.video-header {
			width: min(var(--max), 90%);

			margin: auto;

			padding: 110px 0 45px;

			display: grid;

			grid-template-columns: 1.1fr .9fr;

			gap: 80px;

			align-items: end;
		}

		.video-label {
			margin: 0 0 18px;

			color: var(--champagne);

			font-size: 10px;
			font-weight: 800;

			letter-spacing: .22em;
		}

		.video-heading {
			margin: 0;

			font-size: clamp(48px, 6vw, 78px);

			line-height: .94;

			letter-spacing: -.055em;
		}

		.video-heading em {
			color: #625b50;
		}

		.video-note {
			max-width: 420px;

			margin: 0;

			color: var(--muted);

			font-size: 18px;

			line-height: 1.8;
		}

		.youtube-frame {
			position: relative;

			width: min(430px, 90%);

			margin: auto;

			aspect-ratio: 9 / 16;

			overflow: hidden;

			background: #000;

			box-shadow:
				0 25px 70px rgba(0,0,0,.16);
		}

		.youtube-frame iframe {
			position: absolute;

			inset: 0;

			width: 100%;
			height: 100%;

			border: 0;
		}

		.video-caption {
			width: min(430px, 90%);

			margin: 18px auto 0;

			padding-bottom: 110px;

			color: var(--muted-light);

			font-size: 11px;

			letter-spacing: .08em;

			text-align: center;
		}


		/* =====================================================
		   ARTIST INTRO
		===================================================== */

		.intro {
			width: min(var(--max), 90%);

			margin: auto;

			padding: 135px 0;

			display: grid;

			grid-template-columns: 1fr 1fr;

			gap: 120px;

			align-items: start;
		}

		.section-label {
			margin: 0 0 18px;

			color: var(--champagne);

			font-size: 10px;

			font-weight: 800;

			letter-spacing: .22em;
		}

		.intro h2 {
			max-width: 720px;

			margin: 0;

			font-size: clamp(48px, 6vw, 78px);

			line-height: .94;

			letter-spacing: -.055em;
		}

		.intro h2 em {
			color: #625b50;
		}

		.intro-text {
			max-width: 600px;

			margin: 10px 0 0;

			color: var(--muted);

			font-size: 20px;

			line-height: 1.85;
		}

		.intro-line {
			width: 75px;

			height: 1px;

			margin: 35px 0;

			background: var(--champagne);
		}


		/* =====================================================
		   PERFORMANCE / OCCASIONS
		===================================================== */

		.services {
			width: min(var(--max), 90%);

			margin: auto;

			padding: 20px 0 135px;
		}

		.services-intro {
			display: grid;

			grid-template-columns: 1.2fr .8fr;

			gap: 100px;

			align-items: end;

			margin-bottom: 55px;
		}

		.services h2 {
			max-width: 850px;

			margin: 0;

			font-size: clamp(48px, 6vw, 78px);

			line-height: .94;

			letter-spacing: -.055em;
		}

		.services h2 em {
			color: #625b50;
		}

		.services-description {
			max-width: 410px;

			margin: 0;

			color: var(--muted);

			font-size: 18px;

			line-height: 1.8;
		}

		.service-grid {
			display: grid;

			grid-template-columns: repeat(4, 1fr);

			border-top: 1px solid var(--line);

			border-bottom: 1px solid var(--line);
		}

		.service-card {
			min-height: 310px;

			padding: 32px 28px;

			border-right: 1px solid var(--line);

			transition:
				background .3s ease,
				transform .3s ease;
		}

		.service-card:last-child {
			border-right: 0;
		}

		.service-card:hover {
			background: var(--white);

			transform: translateY(-4px);
		}

		.service-number {
			color: var(--champagne);

			font-size: 11px;

			font-weight: 800;

			letter-spacing: .15em;
		}

		.service-icon {
			width: 56px;
			height: 56px;

			display: flex;

			align-items: center;
			justify-content: center;

			margin: 40px 0 27px;

			border: 1px solid rgba(168,139,92,.42);

			border-radius: 50%;

			color: var(--champagne);

			font-family: Georgia, serif;

			font-size: 22px;
		}

		.service-card h3 {
			margin: 0 0 12px;

			font-size: 25px;

			letter-spacing: -.025em;
		}

		.service-card p {
			margin: 0;

			color: var(--muted);

			font-size: 15px;

			line-height: 1.65;
		}


		/* =====================================================
		   FEATURE
		===================================================== */

		.photo-feature {
			display: grid;

			grid-template-columns: 1.2fr .8fr;

			min-height: 680px;

			background: var(--charcoal);

			color: white;
		}

		.photo-large {
			overflow: hidden;
		}

		.photo-large img {
			width: 100%;
			height: 100%;

			min-height: 600px;

			object-fit: cover;
		}

		.photo-text {
			display: flex;

			flex-direction: column;

			justify-content: center;

			padding: 85px;
		}

		.photo-text .section-label {
			color: var(--champagne-light);
		}

		.photo-text h2 {
			margin: 0 0 28px;

			font-size: clamp(45px, 5vw, 70px);

			line-height: .95;

			letter-spacing: -.055em;
		}

		.photo-text h2 em {
			color: #ddd3c4;
		}

		.photo-text p {
			max-width: 520px;

			margin: 0;

			color: #bcb9b2;

			font-size: 18px;

			line-height: 1.8;
		}

		.text-link {
			margin-top: 28px;

			color: var(--champagne-light);

			text-decoration: none;

			font-size: 11px;

			font-weight: 800;

			letter-spacing: .14em;
		}


		/* =====================================================
		   GALLERY
		===================================================== */

		.gallery {
			width: min(var(--max), 90%);

			margin: auto;

			padding: 135px 0;
		}

		.gallery-heading {
			margin-bottom: 55px;
		}

		.gallery-heading h2 {
			max-width: 850px;

			margin: 0;

			font-size: clamp(48px, 6vw, 78px);

			line-height: .94;

			letter-spacing: -.055em;
		}

		.gallery-heading h2 em {
			color: #625b50;
		}

		.gallery-grid {
			display: grid;

			grid-template-columns: 1.45fr 1fr 1fr;

			grid-template-rows: 330px 330px;

			gap: 12px;
		}

		.gallery-item {
			overflow: hidden;

			background: var(--ivory-2);
		}

		.gallery-item:first-child {
			grid-row: span 2;
		}

		.gallery-item img {
			width: 100%;
			height: 100%;

			object-fit: cover;

			transition: transform .8s ease;
		}

		.gallery-item:hover img {
			transform: scale(1.035);
		}


		/* =====================================================
		   MUSIC
		===================================================== */

		.music-section {
			background: var(--charcoal);

			color: white;
		}

		.music-wrap {
			width: min(var(--max), 90%);

			margin: auto;

			padding: 125px 0;

			display: grid;

			grid-template-columns: 1fr 1fr;

			gap: 110px;

			align-items: center;
		}

		.music-wrap .section-label {
			color: var(--champagne-light);
		}

		.music-wrap h2 {
			margin: 0;

			font-size: clamp(48px, 6vw, 78px);

			line-height: .94;

			letter-spacing: -.055em;
		}

		.music-wrap h2 em {
			color: #d8d0c3;
		}

		.music-copy p {
			max-width: 570px;

			margin: 30px 0 0;

			color: #b8b5ae;

			font-size: 18px;

			line-height: 1.8;
		}

		.genres {
			display: grid;

			grid-template-columns: 1fr 1fr;
		}

		.genre {
			padding: 26px 0;

			border-bottom: 1px solid rgba(255,255,255,.14);

			color: #e1ddd4;

			font-size: 14px;

			font-weight: 700;

			letter-spacing: .13em;
		}

		.genre::before {
			content: "—";

			margin-right: 12px;

			color: var(--champagne-light);
		}


		/* =====================================================
		   ABOUT PROFILE
		===================================================== */

		.profile {
			width: min(var(--max), 90%);

			margin: auto;

			padding: 135px 0;

			display: grid;

			grid-template-columns: .8fr 1fr;

			gap: 110px;

			align-items: center;
		}

		.profile-photo {
			overflow: hidden;

			background: var(--ivory-2);
		}

		.profile-photo img {
			width: 100%;

			aspect-ratio: 4 / 5;

			object-fit: cover;
		}

		.profile-copy h2 {
			margin: 0;

			font-size: clamp(48px, 6vw, 78px);

			line-height: .94;

			letter-spacing: -.055em;
		}

		.profile-copy h2 em {
			color: #625b50;
		}

		.profile-copy p:not(.section-label) {
			max-width: 620px;

			margin: 28px 0 0;

			color: var(--muted);

			font-size: 18px;

			line-height: 1.8;
		}


		/* =====================================================
		   BOOKING
		===================================================== */

		.booking {
			background: var(--white);

			border-top: 1px solid var(--line);

			text-align: center;

			padding: 135px 5vw 155px;
		}

		.booking-inner {
			max-width: 850px;

			margin: auto;
		}

		.booking h2 {
			margin: 0 0 25px;

			font-size: clamp(52px, 7vw, 92px);

			line-height: .88;

			letter-spacing: -.06em;
		}

		.booking h2 em {
			color: #625b50;
		}

		.booking p {
			max-width: 600px;

			margin: 0 auto 38px;

			color: var(--muted);

			font-size: 18px;

			line-height: 1.8;
		}

		.booking-actions {
			display: flex;

			justify-content: center;

			gap: 12px;
		}


		/* =====================================================
		   FOOTER
		===================================================== */

		.footer {
			background: var(--ivory);

			border-top: 1px solid var(--line);

			padding: 32px 5vw;
		}

		.footer-inner {
			width: min(var(--max), 100%);

			margin: auto;

			display: flex;

			align-items: center;

			justify-content: space-between;

			gap: 25px;

			color: #858078;

			font-size: 10px;

			letter-spacing: .08em;
		}

		.footer-brand {
			color: var(--text);

			font-size: 14px;

			font-weight: 800;

			letter-spacing: .16em;
		}


		/* =====================================================
		   TABLET
		===================================================== */

		@media (max-width: 900px) {

			.video-header,
			.intro,
			.services-intro,
			.music-wrap,
			.profile {
				grid-template-columns: 1fr;

				gap: 45px;
			}

			.hero {
				min-height: 850px;
			}

			.hero-image {
				width: 100%;
				height: 62%;
			}

			.hero-overlay {
				background:
					linear-gradient(
						180deg,
						transparent 20%,
						rgba(244,240,232,.20) 38%,
						rgba(244,240,232,.90) 61%,
						#f4f0e8 73%
					);
			}

			.hero-content {
				padding:
					500px
					6vw
					70px;
			}

			.hero-copy {
				width: 100%;
			}

			.service-grid {
				grid-template-columns: 1fr 1fr;
			}

			.service-card:nth-child(2) {
				border-right: 0;
			}

			.service-card:nth-child(-n+2) {
				border-bottom: 1px solid var(--line);
			}

			.photo-feature {
				grid-template-columns: 1fr;
			}

			.photo-large img {
				min-height: 520px;
			}

			.photo-text {
				padding: 75px 8%;
			}
		}


		/* =====================================================
		   MOBILE
		===================================================== */

		@media (max-width: 650px) {

			.nav {
				padding: 20px 22px;
			}

			.nav-links {
				display: none;
			}

			.hero {
				height: auto;

				min-height: 760px;
			}

			.hero-image {
				height: 52%;

				object-position: center top;
			}

			.hero-content {
				padding:
					395px
					22px
					65px;
			}

			.hero h1 {
				font-size: clamp(
					70px,
					19vw,
					108px
				);
			}

			.hero-subtitle {
				font-size: 17px;

				margin-top: 28px;
			}

			.hero-buttons {
				flex-direction: column;

				align-items: flex-start;
			}

			.hero-location {
				margin-top: 30px;

				font-size: 8px;
			}

			.video-header,
			.intro,
			.services,
			.gallery,
			.profile {
				width: calc(100% - 44px);
			}

			.video-header {
				padding: 80px 0 35px;
			}

			.video-note {
				font-size: 17px;
			}

			.youtube-frame {
				width: calc(100% - 44px);
			}

			.video-caption {
				width: calc(100% - 44px);

				padding-bottom: 75px;
			}

			.intro {
				padding: 90px 0;
			}

			.intro-text {
				font-size: 18px;
			}

			.services {
				padding: 10px 0 90px;
			}

			.services-description {
				font-size: 17px;
			}

			.service-grid {
				grid-template-columns: 1fr;
			}

			.service-card {
				min-height: 270px;

				border-right: 0;

				border-bottom: 1px solid var(--line);
			}

			.service-card:last-child {
				border-bottom: 0;
			}

			.service-icon {
				margin-top: 30px;
			}

			.photo-feature {
				min-height: 0;
			}

			.photo-large img {
				min-height: 390px;
			}

			.photo-text {
				padding: 60px 22px;
			}

			.gallery {
				padding: 90px 0;
			}

			.gallery-grid {
				grid-template-columns: 1fr 1fr;

				grid-template-rows:
					250px
					250px
					250px;
			}

			.gallery-item:first-child {
				grid-column: span 2;

				grid-row: span 1;
			}

			.music-wrap {
				width: calc(100% - 44px);

				padding: 85px 0;
			}

			.genres {
				grid-template-columns: 1fr 1fr;
			}

			.genre {
				font-size: 12px;
			}

			.profile {
				padding: 90px 0;
			}

			.profile-copy p:not(.section-label) {
				font-size: 17px;
			}

			.booking {
				padding: 90px 22px 110px;
			}

			.booking p {
				font-size: 17px;
			}

			.booking-actions {
				flex-direction: column;

				align-items: center;
			}

			.footer-inner {
				flex-direction: column;

