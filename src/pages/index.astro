---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>

			<!-- HERO -->
			<section class="hero">
				<img
					src="/images/hero live 3.jpg"
					alt="Roushan performing live on stage"
					class="hero-image"
				/>

				<div class="hero-overlay"></div>

				<div class="hero-content">
					<p class="eyebrow">SINGER • LIVE PERFORMER • ENTERTAINMENT</p>

					<h1>ROUSHAN</h1>

					<p class="hero-subtitle">
						Live music for weddings, celebrations & special events.
					</p>

					<div class="hero-buttons">
						<a href="#booking" class="button primary">
							BOOK ROUSHAN
						</a>

						<a href="#about" class="button secondary">
							EXPLORE
						</a>
					</div>
				</div>
			</section>


			<!-- INTRO -->
			<section class="intro" id="about">
				<div>
					<p class="section-label">THE ARTIST</p>
					<h2>Music that makes the moment.</h2>
				</div>

				<p class="intro-text">
					Roushan is a singer and live performer based in Patna,
					bringing music, energy and a personal touch to weddings,
					events, celebrations and private occasions.
				</p>
			</section>


			<!-- SERVICES -->
			<section class="services">
				<p class="section-label">PERFORMANCES</p>

				<h2>Available for your special moments.</h2>

				<div class="service-grid">

					<div class="service-card">
						<span>01</span>
						<h3>Weddings</h3>
						<p>
							Live music for wedding celebrations,
							sangeet and special moments.
						</p>
					</div>

					<div class="service-card">
						<span>02</span>
						<h3>Events</h3>
						<p>
							Live performances for social and private events.
						</p>
					</div>

					<div class="service-card">
						<span>03</span>
						<h3>Birthdays</h3>
						<p>
							Make birthdays and celebrations more memorable
							with live music.
						</p>
					</div>

					<div class="service-card">
						<span>04</span>
						<h3>Corporate</h3>
						<p>
							Professional live entertainment for corporate
							events and gatherings.
						</p>
					</div>

				</div>
			</section>


			<!-- PHOTO FEATURE -->
			<section class="photo-feature">

				<div class="photo-large">
					<img
						src="/images/hero live2.jpg"
						alt="Roushan performing at an event"
					/>
				</div>

				<div class="photo-text">
					<p class="section-label">LIVE EXPERIENCE</p>
					<h2>Every event deserves its own soundtrack.</h2>
					<p>
						From intimate celebrations to energetic live events,
						Roushan brings a versatile performance experience
						to every occasion.
					</p>

					<a href="#booking" class="text-link">
						Plan your event →
					</a>
				</div>

			</section>


			<!-- GALLERY -->
			<section class="gallery">

				<div class="gallery-heading">
					<div>
						<p class="section-label">GALLERY</p>
						<h2>Moments on stage & beyond.</h2>
					</div>
				</div>

				<div class="gallery-grid">

					<img
						src="/images/hero event.jpeg"
						alt="Roushan performing at an event"
					/>

					<img
						src="/images/hero live2.jpg"
						alt="Roushan live performance"
					/>

					<img
						src="/images/hero sitting sofa.jpg"
						alt="Roushan portrait"
					/>

					<img
						src="/images/hero standinf close.jpg"
						alt="Roushan portrait"
					/>

				</div>

			</section>


			<!-- BOOKING -->
			<section class="booking" id="booking">
				<p class="section-label">BOOKING</p>

				<h2>Planning an event?</h2>

				<p>
					Tell us about your event and we'll help you plan
					the right performance.
				</p>

				<a href="tel:+91955275669" class="button primary">
					CONTACT ROUSHAN
				</a>
			</section>

		</main>

		<Footer />
	</body>
</html>


<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		background: #0b0b0d;
		color: #f5f3ef;
		font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
	}

	.hero {
		position: relative;
		height: min(820px, 90vh);
		min-height: 600px;
		overflow: hidden;
		display: flex;
		align-items: flex-end;
	}

	.hero-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				90deg,
				rgba(0,0,0,.82) 0%,
				rgba(0,0,0,.48) 45%,
				rgba(0,0,0,.12) 100%
			),
			linear-gradient(
				0deg,
				rgba(0,0,0,.65),
				transparent 55%
			);
	}

	.hero-content {
		position: relative;
		z-index: 2;
		max-width: 1200px;
		width: 100%;
		margin: 0 auto;
		padding: 80px 32px;
	}

	.eyebrow,
	.section-label {
		font-size: 12px;
		letter-spacing: .22em;
		font-weight: 700;
		color: #d6b477;
	}

	h1 {
		font-size: clamp(72px, 12vw, 170px);
		line-height: .85;
		margin: 18px 0 28px;
		letter-spacing: -.05em;
		font-weight: 800;
	}

	.hero-subtitle {
		font-size: clamp(18px, 2vw, 25px);
		max-width: 560px;
		line-height: 1.5;
		color: #e4e1dc;
	}

	.hero-buttons {
		display: flex;
		gap: 14px;
		margin-top: 32px;
	}

	.button {
		display: inline-block;
		padding: 15px 25px;
		text-decoration: none;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: .08em;
		transition: .25s ease;
	}

	.primary {
		background: #d6b477;
		color: #111;
	}

	.primary:hover {
		background: #f0d49d;
		transform: translateY(-2px);
	}

	.secondary {
		border: 1px solid rgba(255,255,255,.5);
		color: white;
	}

	.secondary:hover {
		background: white;
		color: #111;
	}

	.intro,
	.services,
	.gallery,
	.booking {
		max-width: 1200px;
		margin: auto;
		padding: 110px 32px;
	}

	.intro {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 80px;
	}

	h2 {
		font-size: clamp(38px, 5vw, 68px);
		line-height: 1;
		letter-spacing: -.035em;
		margin: 15px 0 25px;
	}

	.intro-text,
	.photo-text p,
	.booking p {
		font-size: 18px;
		line-height: 1.7;
		color: #aaa7a1;
	}

	.service-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1px;
		background: #29292c;
		margin-top: 55px;
	}

	.service-card {
		background: #101012;
		padding: 35px;
		min-height: 240px;
	}

	.service-card span {
		color: #d6b477;
		font-size: 12px;
	}

	.service-card h3 {
		font-size: 25px;
		margin-top: 65px;
	}

	.service-card p {
		color: #999;
		line-height: 1.6;
	}

	.photo-feature {
		display: grid;
		grid-template-columns: 1.2fr .8fr;
		min-height: 650px;
	}

	.photo-large img {
		width: 100%;
		height: 100%;
		min-height: 600px;
		object-fit: cover;
	}

	.photo-text {
		background: #151518;
		padding: 80px;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.text-link {
		color: #d6b477;
		text-decoration: none;
		font-weight: 700;
		margin-top: 20px;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		grid-template-rows: 280px 280px;
		gap: 12px;
		margin-top: 50px;
	}

	.gallery-grid img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.gallery-grid img:first-child {
		grid-row: span 2;
	}

	.booking {
		text-align: center;
		padding-bottom: 150px;
	}

	.booking p {
		max-width: 600px;
		margin: 0 auto 35px;
	}

	@media (max-width: 800px) {
		.hero {
			min-height: 650px;
		}

		.hero-content {
			padding: 50px 22px;
		}

		.intro,
		.photo-feature {
			grid-template-columns: 1fr;
		}

		.intro,
		.services,
		.gallery,
		.booking {
			padding: 75px 22px;
		}

		.service-grid {
			grid-template-columns: 1fr 1fr;
		}

		.photo-text {
			padding: 50px 25px;
		}

		.gallery-grid {
			grid-template-columns: 1fr 1fr;
			grid-template-rows: 250px 250px 250px;
		}

		.gallery-grid img:first-child {
			grid-row: span 1;
		}
	}

	@media (max-width: 500px) {
		.service-grid {
			grid-template-columns: 1fr;
		}

		.gallery-grid {
			grid-template-columns: 1fr;
			grid-template-rows: repeat(4, 300px);
		}

		.hero-buttons {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
