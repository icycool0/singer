<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Roushan — Singer & Live Performer</title>

  <meta
    name="description"
    content="Roushan — singer and live performer for weddings, events, celebrations and special occasions."
  />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --bg: #fbf9f5;
      --cream: #f4eee5;
      --white: #ffffff;

      --ink: #20252b;
      --muted: #706d68;

      --gold: #bd8a4b;
      --gold-light: #d7b27e;

      --line: #e4ddd3;

      --dark: #202831;

      --serif: "Playfair Display", Georgia, serif;
      --sans: "DM Sans", Arial, sans-serif;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--sans);
      overflow-x: hidden;
    }

    body.menu-open {
      overflow: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      display: block;
      width: 100%;
    }

    button {
      font: inherit;
    }

    ::selection {
      background: var(--gold);
      color: white;
    }


    /* ========================================
       HEADER
    ======================================== */

    .header {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;

      height: 90px;

      padding: 0 5vw;

      display: flex;
      align-items: center;

      z-index: 50;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
    }

    .brand-logo {
      position: relative;

      width: 43px;
      height: 43px;

      display: grid;
      place-items: center;

      font-family: var(--serif);
      font-size: 32px;

      color: var(--ink);
    }

    .brand-logo::after {
      content: "♪";

      position: absolute;

      right: -2px;
      bottom: 1px;

      font-family: var(--sans);
      font-size: 13px;

      color: var(--gold);
    }

    .brand-text strong {
      display: block;

      font-family: var(--serif);
      font-size: 17px;

      letter-spacing: .18em;
      font-weight: 500;
    }

    .brand-text span {
      display: block;

      margin-top: 2px;

      font-size: 6px;
      letter-spacing: .24em;

      color: var(--muted);
    }

    .nav {
      margin-left: auto;

      display: flex;
      align-items: center;

      gap: 34px;
    }

    .nav a {
      position: relative;

      font-size: 9px;
      font-weight: 700;

      letter-spacing: .13em;

      color: #5d5a56;
    }

    .nav a::after {
      content: "";

      position: absolute;

      left: 0;
      bottom: -7px;

      width: 0;
      height: 1px;

      background: var(--gold);

      transition: width .25s ease;
    }

    .nav a:hover::after {
      width: 100%;
    }

    .nav a:hover {
      color: var(--gold);
    }

    .header-book {
      margin-left: 32px;

      padding: 13px 18px;

      background: var(--gold);
      color: white;

      font-size: 8px;
      font-weight: 700;

      letter-spacing: .12em;

      transition: .25s ease;
    }

    .header-book:hover {
      background: var(--ink);
    }

    .menu-button {
      display: none;

      margin-left: auto;

      border: 0;
      background: transparent;

      cursor: pointer;
    }

    .menu-button span {
      display: block;

      width: 26px;
      height: 1px;

      background: var(--ink);

      margin: 6px;
    }


    /* ========================================
       MOBILE MENU
    ======================================== */

    .mobile-menu {
      display: none;

      position: fixed;
      inset: 0;

      z-index: 40;

      background: var(--bg);

      align-items: center;
      justify-content: center;

      flex-direction: column;

      gap: 30px;
    }

    .mobile-menu a {
      font-family: var(--serif);
      font-size: 40px;
    }

    body.menu-open .mobile-menu {
      display: flex;
    }


    /* ========================================
       HERO
    ======================================== */

    .hero {
      min-height: 100vh;

      display: grid;

      grid-template-columns: 48% 52%;

      position: relative;

      overflow: hidden;

      background: var(--white);
    }

    .hero-content {
      position: relative;
      z-index: 5;

      align-self: center;

      padding:
        145px 5vw
        90px 8vw;
    }

    .eyebrow {
      display: flex;
      align-items: center;

      gap: 10px;

      color: var(--gold);

      font-size: 9px;
      font-weight: 700;

      letter-spacing: .17em;
    }

    .eyebrow span {
      width: 30px;
      height: 1px;

      background: var(--gold);
    }

    .hero h1 {
      margin: 26px 0 0;

      font-family: var(--serif);

      font-size:
        clamp(70px, 8vw, 118px);

      font-weight: 400;

      line-height: .84;

      letter-spacing: -.065em;
    }

    .hero h1 em {
      color: var(--gold);

      font-style: italic;
    }

    .hero-description {
      max-width: 420px;

      margin-top: 35px;

      color: var(--muted);

      font-size: 14px;

      line-height: 1.85;
    }

    .hero-actions {
      display: flex;

      gap: 10px;

      margin-top: 30px;
    }

    .button {
      min-height: 47px;

      padding: 0 20px;

      display: inline-flex;

      align-items: center;
      justify-content: center;

      gap: 9px;

      font-size: 8px;
      font-weight: 700;

      letter-spacing: .12em;

      transition: .25s ease;
    }

    .button-primary {
      background: var(--gold);
      color: white;
    }

    .button-primary:hover {
      background: var(--ink);
    }

    .button-outline {
      border: 1px solid #bfb4a7;

      color: var(--ink);
    }

    .button-outline:hover {
      border-color: var(--gold);
      color: var(--gold);
    }

    .hero-location {
      margin-top: 40px;

      color: #999188;

      font-size: 8px;

      letter-spacing: .08em;
    }

    .hero-location i {
      display: inline-block;

      width: 5px;
      height: 5px;

      margin-right: 8px;

      border-radius: 50%;

      background: var(--gold);
    }


    /* HERO PHOTO */

    .hero-photo {
      position: relative;

      min-height: 100vh;

      overflow: hidden;

      background: #ddd1c2;
    }

    .hero-photo img {
      width: 100%;
      height: 100%;

      object-fit: cover;

      object-position: center center;

      transform: scale(1.01);

      transition: transform 8s ease;
    }

    .hero:hover .hero-photo img {
      transform: scale(1.045);
    }

    .hero-photo::after {
      content: "";

      position: absolute;

      inset: 0;

      background:
        linear-gradient(
          90deg,
          rgba(255,255,255,.12),
          transparent 35%
        ),
        linear-gradient(
          0deg,
          rgba(25,28,30,.25),
          transparent 50%
        );
    }

    .hero-photo-caption {
      position: absolute;

      left: 28px;
      bottom: 27px;

      z-index: 3;

      color: white;
    }

    .hero-photo-caption strong {
      display: block;

      font-size: 10px;

      letter-spacing: .18em;
    }

    .hero-photo-caption small {
      display: block;

      margin-top: 5px;

      font-size: 7px;

      color: #e7c99e;

      letter-spacing: .16em;
    }

    .hero-photo-number {
      position: absolute;

      right: 24px;
      bottom: 2px;

      z-index: 2;

      font-family: var(--serif);

      font-size: 90px;

      color: rgba(255,255,255,.25);
    }

    .hero-symbol {
      position: absolute;

      right: 38%;
      bottom: 9%;

      z-index: 8;

      width: 82px;
      height: 82px;

      border:
        1px solid
        rgba(189,138,75,.8);

      border-radius: 50%;

      display: grid;
      place-items: center;

      background: rgba(255,255,255,.9);

      backdrop-filter: blur(5px);
    }

    .hero-symbol::before {
      content: "R";

      font-family: var(--serif);

      font-size: 42px;

      color: var(--gold);
    }

    .hero-symbol::after {
      content: "♪";

      position: absolute;

      right: 13px;
      top: 9px;

      color: var(--gold);

      font-size: 14px;
    }


    /* ========================================
       COMMON
    ======================================== */

    .section {
      padding: 125px 8vw;
    }

    .section-label {
      color: var(--gold);

      font-size: 8px;

      font-weight: 700;

      letter-spacing: .18em;
    }

    .section-heading {
      font-family: var(--serif);

      font-size:
        clamp(52px, 5.5vw, 82px);

      line-height: .95;

      font-weight: 400;

      letter-spacing: -.055em;
    }

    .section-heading em {
      color: var(--gold);
      font-style: italic;
    }


    /* ========================================
       ABOUT
    ======================================== */

    .about {
      display: grid;

      grid-template-columns: 16% 1fr 18%;

      align-items: center;

      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }

    .about h2 {
      margin: 20px 0 28px;
    }

    .about p {
      max-width: 550px;

      margin: 0;

      color: var(--muted);

      font-size: 13px;

      line-height: 1.9;
    }

    .about-mark {
      justify-self: end;

      width: 145px;
      height: 145px;

      border: 1px solid var(--line);

      border-radius: 50%;

      display: grid;
      place-items: center;

      position: relative;
    }

    .about-mark strong {
      font-family: var(--serif);

      font-size: 70px;

      color: var(--gold);
    }

    .about-mark::after {
      content: "♪";

      position: absolute;

      right: 36px;
      top: 32px;

      font-size: 15px;

      color: var(--gold);
    }

    .about-mark small {
      position: absolute;

      bottom: 24px;

      font-size: 6px;

      letter-spacing: .18em;

      color: #8c8379;
    }


    /* ========================================
       VIDEO
    ======================================== */

    .featured {
      background: var(--white);
    }

    .featured-head {
      display: grid;

      grid-template-columns: 1fr .55fr;

      gap: 80px;

      align-items: end;

      margin-bottom: 45px;
    }

    .featured-head h2 {
      margin: 18px 0 0;
    }

    .featured-head p {
      max-width: 400px;

      margin: 0;

      color: var(--muted);

      font-size: 13px;

      line-height: 1.85;
    }

    .video-wrapper {
      position: relative;

      width: 100%;

      aspect-ratio: 16 / 8.8;

      overflow: hidden;

      background: #20252a;

      box-shadow:
        0 22px 55px
        rgba(40,35,30,.13);
    }

    .video-wrapper iframe {
      width: 100%;
      height: 100%;

      border: 0;
    }

    .video-info {
      position: absolute;

      left: 20px;
      right: 20px;
      bottom: 16px;

      display: flex;

      justify-content: space-between;

      pointer-events: none;

      color: rgba(255,255,255,.72);

      font-size: 7px;

      letter-spacing: .15em;
    }

    .video-bottom {
      display: flex;

      align-items: flex-end;
      justify-content: space-between;

      padding-top: 25px;
    }

    .video-bottom h3 {
      margin: 8px 0 0;

      font-family: var(--serif);

      font-size: 28px;

      font-weight: 400;
    }

    .video-bottom h3 em {
      color: var(--gold);

      font-style: italic;
    }

    .text-link {
      color: var(--gold);

      font-size: 8px;

      font-weight: 700;

      letter-spacing: .13em;
    }

    .text-link span {
      margin-left: 9px;
    }


    /* ========================================
       SERVICES
    ======================================== */

    .services {
      background: var(--cream);

      text-align: center;

      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }

    .services h2 {
      margin:
        18px auto
        65px;

      max-width: 800px;
    }

    .services h2 span {
      color: var(--gold);
    }

    .service-grid {
      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      text-align: center;

      border-top: 1px solid var(--line);
      border-left: 1px solid var(--line);
    }

    .service {
      min-height: 255px;

      padding: 28px 22px;

      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);

      background: rgba(255,255,255,.28);

      transition:
        background .25s ease,
        transform .25s ease;
    }

    .service:hover {
      background: white;

      transform: translateY(-3px);
    }

    .service-icon {
      width: 50px;
      height: 50px;

      margin: 0 auto 22px;

      border:
        1px solid
        #cbbba8;

      border-radius: 50%;

      display: grid;
      place-items: center;

      color: var(--gold);

      font-family: var(--serif);

      font-size: 23px;
    }

    .service h3 {
      margin: 0 0 12px;

      font-family: var(--serif);

      font-size: 27px;

      font-weight: 400;
    }

    .service p {
      max-width: 205px;

      margin: 0 auto;

      color: var(--muted);

      font-size: 10px;

      line-height: 1.7;
    }

    .service-link {
      display: inline-block;

      margin-top: 22px;

      color: var(--gold);

      font-size: 7px;

      font-weight: 700;

      letter-spacing: .13em;
    }


    /* ========================================
       GALLERY
    ======================================== */

    .gallery {
      background: var(--white);

      text-align: center;
    }

    .gallery h2 {
      margin:
        18px auto
        48px;
    }

    .gallery h2 em {
      color: var(--gold);
    }

    .gallery-grid {
      display: grid;

      grid-template-columns:
        repeat(5, 1fr);

      gap: 9px;

      text-align: left;
    }

    .gallery-item {
      position: relative;

      aspect-ratio: 1.25 / 1;

      overflow: hidden;

      background: #ddd2c5;

      cursor: pointer;
    }

    .gallery-item img {
      width: 100%;
      height: 100%;

      object-fit: cover;

      transition:
        transform .55s ease;
    }

    .gallery-item:hover img {
      transform: scale(1.06);
    }

    .gallery-item::after {
      content: "";

      position: absolute;

      inset: 0;

      background:
        linear-gradient(
          0deg,
          rgba(20,22,24,.25),
          transparent 55%
        );

      pointer-events: none;
    }

    .gallery-number {
      position: absolute;

      left: 12px;
      bottom: 10px;

      z-index: 2;

      color: white;

      font-size: 7px;

      letter-spacing: .12em;
    }

    .gallery-dots {
      display: flex;

      justify-content: center;

      gap: 8px;

      margin-top: 22px;
    }

    .gallery-dots span {
      width: 6px;
      height: 6px;

      border-radius: 50%;

      background: #d6cdc2;
    }

    .gallery-dots span:first-child {
      background: var(--gold);
    }


    /* ========================================
       REVIEWS
    ======================================== */

    .reviews {
      background: var(--bg);

      text-align: center;

      border-top: 1px solid var(--line);
    }

    .reviews h2 {
      margin:
        18px auto
        48px;
    }

    .review-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 18px;

      text-align: left;
    }

    .review {
      padding: 30px;

      background: white;

      border: 1px solid var(--line);

      box-shadow:
        0 10px 30px
        rgba(50,40,30,.04);
    }

    .stars {
      color: var(--gold);

      font-size: 12px;

      letter-spacing: 2px;
    }

    .review p {
      margin:
        20px 0
        25px;

      color: #5f5b56;

      font-size: 12px;

      line-height: 1.75;
    }

    .review strong {
      display: block;

      font-size: 9px;

      letter-spacing: .08em;
    }

    .review small {
      display: block;

      margin-top: 5px;

      color: #9a9289;

      font-size: 8px;
    }


    /* ========================================
       BOOKING
    ======================================== */

    .booking {
      position: relative;

      overflow: hidden;

      background: var(--dark);

      color: white;

      min-height: 390px;

      display: flex;

      align-items: center;
    }

    .booking-content {
      position: relative;

      z-index: 3;
    }

    .booking .section-label {
      color: var(--gold-light);
    }

    .booking h2 {
      margin: 18px 0 25px;

      font-family: var(--serif);

      font-size:
        clamp(50px, 6vw, 85px);

      font-weight: 400;

      line-height: .95;

      letter-spacing: -.05em;
    }

    .booking h2 em {
      color: var(--gold-light);

      font-style: italic;
    }

    .booking p {
      max-width: 460px;

      margin: 0;

      color: rgba(255,255,255,.62);

      font-size: 12px;

      line-height: 1.8;
    }

    .booking-actions {
      display: flex;

      gap: 10px;

      margin-top: 28px;
    }

    .booking .button-outline {
      color: white;

      border-color:
        rgba(255,255,255,.3);
    }

    .booking .button-outline:hover {
      color: var(--gold-light);

      border-color:
        var(--gold-light);
    }

    .booking-r {
      position: absolute;

      right: 9vw;
      bottom: -70px;

      font-family: var(--serif);

      font-size: 350px;

      line-height: 1;

      color: rgba(215,178,126,.07);
    }

    .booking-note {
      position: absolute;

      right: 18vw;
      bottom: 95px;

      width: 95px;
      height: 95px;

      border:
        1px solid
        rgba(215,178,126,.45);

      border-radius: 50%;

      display: grid;
      place-items: center;

      color: var(--gold-light);

      font-family: var(--serif);

      font-size: 28px;
    }


    /* ========================================
       FOOTER
    ======================================== */

    footer {
      position: relative;

      padding:
        32px 5vw
        55px;

      display: grid;

      grid-template-columns:
        1.2fr 1fr 1fr 1fr;

      gap: 40px;

      background: var(--white);

      border-top: 1px solid var(--line);
    }

    .footer-brand {
      display: flex;

      align-items: center;

      gap: 10px;
    }

    .footer-logo {
      font-family: var(--serif);

      font-size: 35px;

      color: var(--ink);
    }

    .footer-brand span {
      font-family: var(--serif);

      font-size: 14px;

      letter-spacing: .18em;
    }

    .footer-column strong {
      display: block;

      margin-bottom: 14px;

      font-size: 8px;

      letter-spacing: .14em;
    }

    .footer-column a,
    .footer-column p {
      display: block;

      margin: 7px 0;

      color: var(--muted);

      font-size: 9px;

      line-height: 1.6;
    }

    .footer-column a:hover {
      color: var(--gold);
    }

    .copyright {
      position: absolute;

      left: 5vw;
      right: 5vw;
      bottom: 15px;

      padding-top: 14px;

      border-top: 1px solid var(--line);

      color: #9b9288;

      font-size: 7px;

      letter-spacing: .1em;
    }


    /* ========================================
       REVEAL
    ======================================== */

    .reveal {
      opacity: 0;

      transform:
        translateY(25px);

      transition:
        opacity .9s ease,
        transform .9s ease;
    }

    .reveal.visible {
      opacity: 1;

      transform: none;
    }


    /* ========================================
       TABLET
    ======================================== */

    @media (max-width: 950px) {

      .nav,
      .header-book {
        display: none;
      }

      .menu-button {
        display: block;
      }

      .hero {
        display: flex;

        flex-direction: column-reverse;
      }

      .hero-photo {
        height: 65vh;
        min-height: 470px;
      }

      .hero-content {
        padding:
          80px 7vw;
      }

      .hero h1 {
        font-size:
          clamp(65px, 14vw, 95px);
      }

      .hero-symbol {
        right: 8%;
        bottom: 5%;
      }

      .about {
        display: block;
      }

      .about-mark {
        margin-top: 50px;
      }

      .featured-head {
        display: block;
      }

      .featured-head p {
        margin-top: 25px;
      }

      .service-grid {
        grid-template-columns:
          repeat(2, 1fr);
      }

      .gallery-grid {
        grid-template-columns:
          repeat(3, 1fr);
      }

      .review-grid {
        grid-template-columns:
          1fr;
      }

      .profile {
        display: block;
      }

      footer {
        grid-template-columns:
          repeat(2,1fr);
      }
    }


    /* ========================================
       MOBILE
    ======================================== */

    @media (max-width: 560px) {

      .header {
        height: 75px;

        padding:
          0 6vw;
      }

      .brand-text strong {
        font-size: 14px;
      }

      .hero-photo {
        height: 61vh;

        min-height: 430px;
      }

      .hero-content {
        padding:
          75px 7vw;
      }

      .hero h1 {
        font-size: 58px;
      }

      .hero-description {
        font-size: 13px;
      }

      .hero-actions,
      .booking-actions {
        flex-direction: column;
      }

      .button {
        width: 100%;
      }

      .hero-symbol {
        transform: scale(.7);

        transform-origin:
          bottom right;
      }

      .section {
        padding:
          90px 7vw;
      }

      .section-heading {
        font-size: 51px;
      }

      .about-mark {
        width: 120px;
        height: 120px;
      }

      .about-mark strong {
