---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>

			<!-- =========================
			     HERO
			========================= -->
			<section class="hero">
				<img
					src="/hero live 3.jpg"
					alt="Roushan performing live on stage"
					class="hero-image"
				/>

				<div class="hero-overlay"></div>

				<div class="hero-content">
					<p class="eyebrow">
						SINGER • LIVE PERFORMER • ENTERTAINMENT
					</p>

					<h1>ROUSHAN</h1>

					<p class="hero-subtitle">
						Live music for weddings, celebrations,
						private events & special occasions.
					</p>

					<div class="hero-buttons">
						<a href="#booking" class="button primary">
							BOOK ROUSHAN
						</a>

						<a href="#about" class="button secondary">
							EXPLORE
						</a>
					</div>
				</div>

				<div class="hero-location">
					<span>BASED IN PATNA</span>
					<span class="dot">•</span>
					<span>AVAILABLE FOR EVENTS</span>
				</div>
			</section>


			<!-- =========================
			     INTRO
			========================= -->
			<section class="intro" id="about">

				<div class="intro-heading">
					<p class="section-label">THE ARTIST</p>

					<h2>
						More than music.
						<br />
						It's the moment.
					</h2>
				</div>

				<div class="intro-copy">
					<p>
						Roushan is a singer and live performer based in
						Patna, bringing music, energy and a personal touch
						to weddings, celebrations, events and private
						occasions.
					</p>

					<p>
						Whether it's an intimate gathering or a large
						celebration, the performance is shaped around
						the atmosphere and audience.
					</p>
				</div>

			</section>


			<!-- =========================
			     FEATURE IMAGE
			========================= -->
			<section class="feature">

				<div class="feature-image">
					<img
						src="/hero live2.jpg"
						alt="Roushan performing live"
					/>
				</div>

				<div class="feature-content">

					<p class="section-label">
						THE LIVE EXPERIENCE
					</p>

					<h2>
						Every event
						deserves its
						own soundtrack.
					</h2>

					<p>
						From wedding celebrations and sangeet nights
						to birthdays, private parties and corporate
						events, Roushan brings a versatile live
						performance to the occasion.
					</p>

					<a href="#booking" class="text-link">
						Plan your event →
					</a>

				</div>

			</section>


			<!-- =========================
			     SERVICES
			========================= -->
			<section class="services">

				<div class="services-heading">
					<div>
						<p class="section-label">
							PERFORMANCES
						</p>

						<h2>
							For moments
							worth remembering.
						</h2>
					</div>

					<p class="services-intro">
						Choose the experience that fits your
						celebration.
					</p>
				</div>


				<div class="service-grid">

					<div class="service-card">
						<span>01</span>

						<h3>Weddings</h3>

						<p>
							Live music for weddings, sangeet,
							receptions and special moments.
						</p>

						<a href="#booking">
							ENQUIRE →
						</a>
					</div>


					<div class="service-card">
						<span>02</span>

						<h3>Private Events</h3>

						<p>
							Personalised live entertainment for
							private celebrations and gatherings.
						</p>

						<a href="#booking">
							ENQUIRE →
						</a>
					</div>


					<div class="service-card">
						<span>03</span>

						<h3>Birthdays</h3>

						<p>
							Make birthdays and celebrations more
							memorable with live music.
						</p>

						<a href="#booking">
							ENQUIRE →
						</a>
					</div>


					<div class="service-card">
						<span>04</span>

						<h3>Corporate</h3>

						<p>
							Professional live entertainment for
							corporate events and gatherings.
						</p>

						<a href="#booking">
							ENQUIRE →
						</a>
					</div>

				</div>

			</section>


			<!-- =========================
			     VISUAL SPLIT
			========================= -->
			<section class="visual-split">

				<div class="visual-panel">

					<img
						src="/hero event.jpeg"
						alt="Roushan performing at an event"
					/>

					<div class="visual-caption">
						LIVE PERFORMANCE
					</div>

				</div>


				<div class="visual-panel">

					<img
						src="/hero sitting sofa.jpg"
						alt="Roushan portrait"
					/>

					<div class="visual-caption">
						THE ARTIST
					</div>

				</div>

			</section>


			<!-- =========================
			     GALLERY
			========================= -->
			<section class="gallery">

				<div class="gallery-heading">

					<div>
						<p class="section-label">
							GALLERY
						</p>

						<h2>
							On stage.
							<br />
							In the moment.
						</h2>
					</div>

					<p>
						A glimpse into Roushan's performances
						and journey as an artist.
					</p>

				</div>


				<div class="gallery-grid">

					<div class="gallery-item large">
						<img
							src="/hero event standing.jpeg"
							alt="Roushan performing on stage"
						/>
					</div>

					<div class="gallery-item">
						<img
							src="/hero standinf close.jpg"
							alt="Roushan portrait"
						/>
					</div>

					<div class="gallery-item">
						<img
							src="/hero standing 2.jpg"
							alt="Roushan outdoors"
						/>
					</div>

					<div class="gallery-item">
						<img
							src="/hero casula standing.jpeg"
							alt="Roushan portrait"
						/>
					</div>

				</div>

			</section>


			<!-- =========================
			     VIDEO PLACEHOLDER
			     You can add YouTube later
			========================= -->
			<section class="video-section">

				<div class="video-placeholder">

					<div class="video-icon">
						▶
					</div>

					<p class="section-label">
						WATCH ROUSHAN
					</p>

					<h2>
						Live performance videos
					</h2>

					<p>
						Performance videos will be added here.
					</p>

				</div>

			</section>


			<!-- =========================
			     BOOKING
			========================= -->
			<section class="booking" id="booking">

				<div class="booking-inner">

					<p class="section-label">
						BOOKING
					</p>

					<h2>
						Have an event?
						<br />
						Let's make it memorable.
					</h2>

					<p class="booking-description">
						Tell us about your event, date and location.
						We'll help you plan the right performance
						for your occasion.
					</p>

					<div class="booking-buttons">

						<a
							href="tel:+91955275669"
							class="button primary"
						>
							CALL ROUSHAN
						</a>

						<a
							href="https://wa.me/91955275669"
							class="button whatsapp"
						>
							WHATSAPP
						</a>

					</div>

				</div>

			</section>

		</main>

		<Footer />

	</body>
</html>


<style>

	/* =========================
	   GLOBAL
	========================= */

	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		background: #0a0a0b;
		color: #f5f3ef;
		font-family:
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			sans-serif;
	}

	:global(a) {
		color: inherit;
	}

	/* =========================
	   HERO
	========================= */

	.hero {
		position: relative;
		min-height: 760px;
		height: 92vh;
		overflow: hidden;
		display: flex;
		align-items: flex-end;
	}

	.hero-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 30%;
		transform: scale(1.01);
	}

	.hero-overlay {
		position: absolute;
		inset: 0;

		background:
			linear-gradient(
				90deg,
				rgba(0,0,0,.88) 0%,
				rgba(0,0,0,.55) 40%,
				rgba(0,0,0,.12) 100%
			),
			linear-gradient(
				0deg,
				rgba(0,0,0,.75) 0%,
				transparent 60%
			);
	}

	.hero-content {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: 1300px;
		margin: auto;
		padding: 70px 45px;
	}

	.eyebrow,
	.section-label {
		font-size: 11px;
		letter-spacing: .24em;
		font-weight: 700;
		color: #d8b77a;
		margin: 0 0 20px;
	}

	h1 {
		font-size: clamp(76px, 12vw, 180px);
		line-height: .82;
		letter-spacing: -.065em;
		font-weight: 800;
		margin: 0 0 32px;
	}

	.hero-subtitle {
		font-size: clamp(18px, 2vw, 25px);
		line-height: 1.5;
		max-width: 600px;
		color: #e5e1da;
		margin: 0;
	}

	.hero-buttons {
		display: flex;
		gap: 12px;
		margin-top: 35px;
	}

	.hero-location {
		position: absolute;
		z-index: 3;
		right: 40px;
		bottom: 35px;

		display: flex;
		gap: 10px;

		font-size: 10px;
		letter-spacing: .16em;
		color: rgba(255,255,255,.65);
	}

	.dot {
		color: #d8b77a;
	}

	/* =========================
	   BUTTONS
	========================= */

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;

		padding: 16px 26px;

		text-decoration: none;
		font-size: 12px;
		font-weight: 800;
		letter-spacing: .1em;

		transition:
			transform .25s ease,
			background .25s ease,
			color .25s ease;
	}

	.primary {
		background: #d8b77a;
		color: #111;
	}

	.primary:hover {
		background: #f0d49d;
		transform: translateY(-2px);
	}

	.secondary {
		border: 1px solid rgba(255,255,255,.45);
		color: #fff;
	}

	.secondary:hover {
		background: #fff;
		color: #111;
		transform: translateY(-2px);
	}

	.whatsapp {
		border: 1px solid rgba(255,255,255,.25);
	}

	.whatsapp:hover {
		background: #fff;
		color: #111;
	}

	/* =========================
	   INTRO
	========================= */

	.intro {
		max-width: 1250px;
		margin: auto;

		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 100px;

		padding: 140px 45px;
	}

	h2 {
		font-size: clamp(42px, 5vw, 72px);
		line-height: .98;
		letter-spacing: -.045em;
		margin: 0;
	}

	.intro-copy {
		align-self: center;
		max-width: 570px;
	}

	.intro-copy p {
		font-size: 19px;
		line-height: 1.75;
		color: #aaa7a1;
		margin: 0 0 25px;
	}

	/* =========================
	   FEATURE
	========================= */

	.feature {
		display: grid;
		grid-template-columns: 1.25fr .75fr;
		min-height: 720px;
	}

	.feature-image {
		min-height: 650px;
		overflow: hidden;
	}

	.feature-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		transition: transform .8s ease;
	}

	.feature:hover .feature-image img {
		transform: scale(1.03);
	}

	.feature-content {
		background: #141416;
		padding: 80px;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.feature-content h2 {
		max-width: 520px;
		margin-bottom: 35px;
	}

	.feature-content > p:not(.section-label) {
		max-width: 520px;
		font-size: 18px;
		line-height: 1.75;
		color: #aaa7a1;
	}

	.text-link {
		display: inline-block;
		color: #d8b77a;
		text-decoration: none;
		font-weight: 700;
		margin-top: 25px;
	}

	/* =========================
	   SERVICES
	========================= */

	.services {
		max-width: 1250px;
		margin: auto;
		padding: 140px 45px;
	}

	.services-heading {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 50px;
	}

	.services-heading h2 {
		max-width: 650px;
	}

	.services-intro {
		max-width: 320px;
		color: #8f8d89;
		line-height: 1.7;
	}

	.service-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1px;
		background: #2a2a2d;
		margin-top: 65px;
	}

	.service-card {
		background: #101012;
		min-height: 330px;
		padding: 35px;

		display: flex;
		flex-direction: column;
	}

	.service-card > span {
		color: #d8b77a;
		font-size: 11px;
		letter-spacing: .12em;
	}

	.service-card h3 {
		font-size: 27px;
		margin: auto 0 18px;
		letter-spacing: -.02em;
	}

	.service-card p {
		color: #92908b;
		line-height: 1.6;
		margin: 0 0 25px;
	}

	.service-card a {
		color: #d8b77a;
		text-decoration: none;
		font-size: 11px;
		font-weight: 800;
		letter-spacing: .12em;
	}

	/* =========================
	   VISUAL SPLIT
	========================= */

	.visual-split {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px;
		padding: 0 10px;
	}

	.visual-panel {
		height: 650px;
		position: relative;
		overflow: hidden;
		background: #111;
	}

	.visual-panel img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform .8s ease;
	}

	.visual-panel:hover img {
		transform: scale(1.035);
	}

	.visual-caption {
		position: absolute;
		left: 25px;
		bottom: 25px;

		font-size: 10px;
		font-weight: 800;
		letter-spacing: .18em;

		background: rgba(0,0,0,.55);
		padding: 10px 14px;
		backdrop-filter: blur(8px);
	}

	/* =========================
	   GALLERY
	========================= */

	.gallery {
		max-width: 1250px;
		margin: auto;
		padding: 150px 45px;
	}

	.gallery-heading {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 50px;
		margin-bottom: 60px;
	}

	.gallery-heading > p {
		max-width: 320px;
		color: #8f8d89;
		line-height: 1.7;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		grid-template-rows: 300px 300px;
		gap: 10px;
	}

	.gallery-item {
		overflow: hidden;
		background: #111;
	}

	.gallery-item.large {
		grid-row: span 2;
	}

	.gallery-item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform .7s ease;
	}

	.gallery-item:hover img {
		transform: scale(1.04);
	}

	/* =========================
	   VIDEO
	========================= */

	.video-section {
		padding: 0 45px 140px;
		max-width: 1250px;
		margin: auto;
	}

	.video-placeholder {
		min-height: 500px;

		border: 1px solid #29292c;
		background:
			radial-gradient(
				circle at center,
				#242428 0%,
				#111113 65%
			);

		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;

		text-align: center;
	}

	.video-placeholder h2 {
		margin-bottom: 20px;
	}

	.video-placeholder > p:not(.section-label) {
		color: #888;
	}

	.video-icon {
		width: 68px;
		height: 68px;

		border: 1px solid rgba(255,255,255,.35);
		border-radius: 50%;

		display: flex;
		align-items: center;
		justify-content: center;

		margin-bottom: 30px;
		padding-left: 4px;

		font-size: 18px;
	}

	/* =========================
	   BOOKING
	========================= */

	.booking {
		padding: 160px 45px;
		background: #151517;
		text-align: center;
	}

	.booking-inner {
		max-width: 800px;
		margin: auto;
	}

	.booking h2 {
		font-size: clamp(48px, 7vw, 88px);
	}

	.booking-description {
		max-width: 600px;
		margin: 35px auto;
		color: #999;
		font-size: 18px;
		line-height: 1.7;
	}

	.booking-buttons {
		display: flex;
		justify-content: center;
		gap: 12px;
	}

	/* =========================
	   MOBILE
	========================= */

	@media (max-width: 900px) {

		.hero {
			min-height: 680px;
			height: 85vh;
		}

		.hero-content {
			padding: 45px 25px;
		}

		.hero-location {
			display: none;
		}

		.intro,
		.feature {
			grid-template-columns: 1fr;
		}

		.intro {
			padding: 90px 25px;
			gap: 45px;
		}

		.feature-content {
			padding: 70px 30px;
		}

		.service-grid {
			grid-template-columns: 1fr 1fr;
		}

		.services {
			padding: 90px 25px;
		}

		.services-heading,
		.gallery-heading {
			display: block;
		}

		.services-intro,
		.gallery-heading > p {
			margin-top: 25px;
		}

		.visual-split {
			grid-template-columns: 1fr;
		}

		.visual-panel {
			height: 550px;
		}

		.gallery {
			padding: 100px 25px;
		}

		.gallery-grid {
			grid-template-columns: 1fr 1fr;
			grid-template-rows: 300px 300px 300px;
		}

		.gallery-item.large {
			grid-row: span 1;
		}

		.video-section {
			padding: 0 25px 100px;
		}

		.booking {
			padding: 110px 25px;
		}
	}

	@media (max-width: 550px) {

		.hero {
			min-height: 620px;
		}

		h1 {
			font-size: 70px;
		}

		.hero-buttons {
			flex-direction: column;
			align-items: stretch;
			max-width: 240px;
		}

		.service-grid {
			grid-template-columns: 1fr;
		}

		.gallery-grid {
			grid-template-columns: 1fr;
			grid-template-rows: repeat(4, 360px);
		}

		.booking-buttons {
			flex-direction: column;
			align-items: stretch;
			max-width: 300px;
			margin: auto;
		}

		.visual-panel {
			height: 500px;
		}
	}

</style>
