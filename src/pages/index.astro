---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead
		title="Roushan | Singer & Live Performer in Patna"
		description="Roushan is a singer and live performer in Patna, available for weddings, events, birthdays, corporate occasions and private celebrations."
	/>

	<style>
		:root {
			--bg: #08090b;
			--surface: #101114;
			--surface-2: #15161a;
			--text: #f4f1ea;
			--muted: #aaa8a2;
			--gold: #d5b16f;
			--line: rgba(255,255,255,.11);
			--max: 1280px;
		}

		* {
			box-sizing: border-box;
		}

		html {
			scroll-behavior: smooth;
		}

		body {
			margin: 0;
			background: var(--bg);
			color: var(--text);
			font-family:
				Inter,
				Arial,
				Helvetica,
				sans-serif;
			-webkit-font-smoothing: antialiased;
		}

		a {
			color: inherit;
		}

		img {
			display: block;
			max-width: 100%;
		}

		/* =========================
		   NAV
		========================= */

		.nav {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			z-index: 20;
			padding: 28px 5vw;
		}

		.nav-inner {
			max-width: var(--max);
			margin: auto;
			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		.logo {
			text-decoration: none;
			font-size: 18px;
			font-weight: 800;
			letter-spacing: .14em;
		}

		.logo span {
			color: var(--gold);
		}

		.nav-links {
			display: flex;
			align-items: center;
			gap: 28px;
		}

		.nav-links a {
			text-decoration: none;
			font-size: 12px;
			font-weight: 600;
			letter-spacing: .12em;
			color: rgba(255,255,255,.82);
			transition: opacity .25s ease;
		}

		.nav-links a:hover {
			opacity: .55;
		}

		.nav-book {
			border: 1px solid rgba(255,255,255,.35);
			padding: 11px 16px;
		}

		/* =========================
		   HERO
		========================= */

		.hero {
			position: relative;
			min-height: 760px;
			height: 92vh;
			overflow: hidden;
			display: flex;
			align-items: center;
		}

		.hero-image {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: center 28%;
			transform: scale(1.015);
		}

		.hero-shade {
			position: absolute;
			inset: 0;
			background:
				linear-gradient(
					90deg,
					rgba(4,5,7,.92) 0%,
					rgba(4,5,7,.68) 38%,
					rgba(4,5,7,.18) 78%,
					rgba(4,5,7,.28) 100%
				),
				linear-gradient(
					0deg,
					rgba(4,5,7,.8) 0%,
					transparent 55%
				);
		}

		.hero-content {
			position: relative;
			z-index: 2;
			width: min(var(--max), 90%);
			margin: 42px auto 0;
		}

		.eyebrow {
			margin: 0 0 20px;
			font-size: 11px;
			font-weight: 800;
			letter-spacing: .25em;
			color: var(--gold);
		}

		.hero h1 {
			margin: 0;
			max-width: 720px;
			font-size: clamp(76px, 12vw, 170px);
			line-height: .78;
			letter-spacing: -.075em;
			font-weight: 850;
		}

		.hero-subtitle {
			max-width: 560px;
			margin: 38px 0 0;
			font-size: clamp(18px, 2vw, 24px);
			line-height: 1.45;
			color: rgba(255,255,255,.82);
		}

		.hero-actions {
			display: flex;
			gap: 12px;
			margin-top: 30px;
		}

		.button {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-height: 48px;
			padding: 0 23px;
			text-decoration: none;
			font-size: 11px;
			font-weight: 800;
			letter-spacing: .14em;
			transition:
				transform .25s ease,
				background .25s ease,
				color .25s ease;
		}

		.button:hover {
			transform: translateY(-2px);
		}

		.button-primary {
			background: var(--gold);
			color: #111;
		}

		.button-primary:hover {
			background: #e4c98f;
		}

		.button-outline {
			border: 1px solid rgba(255,255,255,.5);
			color: white;
		}

		.button-outline:hover {
			background: white;
			color: #111;
		}

		.hero-location {
			position: absolute;
			z-index: 2;
			right: 5vw;
			bottom: 32px;
			font-size: 10px;
			letter-spacing: .18em;
			text-transform: uppercase;
			color: rgba(255,255,255,.55);
		}

		/* =========================
		   COMMON
		========================= */

		.section {
			width: min(var(--max), 90%);
			margin: auto;
			padding: 125px 0;
		}

		.label {
			margin: 0 0 16px;
			color: var(--gold);
			font-size: 10px;
			font-weight: 800;
			letter-spacing: .25em;
			text-transform: uppercase;
		}

		.section-title {
			margin: 0;
			max-width: 850px;
			font-size: clamp(42px, 6vw, 78px);
			line-height: .95;
			letter-spacing: -.055em;
			font-weight: 750;
		}

		/* =========================
		   VIDEO
		========================= */

		.cinematic {
			width: min(1180px, 90%);
			margin: 0 auto;
			padding: 95px 0 120px;
		}

		.cinematic-header {
			display: flex;
			justify-content: space-between;
			align-items: end;
			gap: 40px;
			margin-bottom: 30px;
		}

		.cinematic-note {
			max-width: 330px;
			margin: 0;
			color: var(--muted);
			font-size: 14px;
			line-height: 1.6;
		}

		.video-frame {
			position: relative;
			aspect-ratio: 16 / 7;
			overflow: hidden;
			background: #111;
		}

		.video-frame img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: center;
			filter: brightness(.62);
			transition: transform 1s ease;
		}

		.video-frame:hover img {
			transform: scale(1.025);
		}

		.video-overlay {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.play {
			width: 76px;
			height: 76px;
			border: 1px solid rgba(255,255,255,.7);
			border-radius: 50%;
			display: grid;
			place-items: center;
			color: white;
			font-size: 22px;
			padding-left: 4px;
		}

		.video-caption {
			position: absolute;
			left: 25px;
			bottom: 22px;
			font-size: 10px;
			font-weight: 800;
			letter-spacing: .2em;
			color: white;
		}

		/* =========================
		   ARTIST
		========================= */

		.artist {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 100px;
			align-items: start;
		}

		.artist-copy {
			max-width: 560px;
			margin-left: auto;
			padding-top: 15px;
		}

		.artist-copy p {
			margin: 0;
			color: var(--muted);
			font-size: 18px;
			line-height: 1.75;
		}

		.artist-line {
			width: 70px;
			height: 1px;
			background: var(--gold);
			margin: 30px 0;
		}

		/* =========================
		   EXPERIENCE
		========================= */

		.experience-intro {
			display: grid;
			grid-template-columns: 1.3fr .7fr;
			gap: 80px;
			align-items: end;
			margin-bottom: 55px;
		}

		.experience-note {
			margin: 0;
			color: var(--muted);
			line-height: 1.7;
			font-size: 15px;
		}

		.performance-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 2px;
			background: var(--line);
		}

		.performance-card {
			position: relative;
			min-height: 390px;
			overflow: hidden;
			background: var(--surface);
		}

		.performance-card img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
			opacity: .58;
			transition:
				transform .7s ease,
				opacity .5s ease;
		}

		.performance-card:hover img {
			transform: scale(1.045);
			opacity: .7;
		}

		.performance-card::after {
			content: "";
			position: absolute;
			inset: 0;
			background:
				linear-gradient(
					0deg,
					rgba(5,5,6,.94),
					rgba(5,5,6,.08) 75%
				);
		}

		.performance-content {
			position: absolute;
			z-index: 2;
			left: 30px;
			right: 30px;
			bottom: 28px;
		}

		.performance-number {
			display: block;
			margin-bottom: 15px;
			font-size: 10px;
			font-weight: 800;
			letter-spacing: .18em;
			color: var(--gold);
		}

		.performance-icon {
			position: absolute;
			top: 25px;
			right: 27px;
			width: 42px;
			height: 42px;
			border: 1px solid rgba(255,255,255,.3);
			border-radius: 50%;
			display: grid;
			place-items: center;
			font-size: 16px;
			color: white;
			z-index: 3;
		}

		.performance-card h3 {
			margin: 0 0 8px;
			font-size: 30px;
			letter-spacing: -.03em;
		}

		.performance-card p {
			max-width: 390px;
			margin: 0;
			color: rgba(255,255,255,.68);
			font-size: 14px;
			line-height: 1.6;
		}

		/* =========================
		   FEATURE
		========================= */

		.feature {
			display: grid;
			grid-template-columns: 1.2fr .8fr;
			min-height: 680px;
		}

		.feature-image {
			width: 100%;
			height: 100%;
			min-height: 620px;
			object-fit: cover;
		}

		.feature-copy {
			background: var(--surface-2);
			padding: 80px;
			display: flex;
			flex-direction: column;
			justify-content: center;
		}

		.feature-copy h2 {
			margin: 0 0 28px;
			font-size: clamp(42px, 5vw, 68px);
			line-height: .95;
			letter-spacing: -.05em;
		}

		.feature-copy p {
			margin: 0;
			color: var(--muted);
			font-size: 16px;
			line-height: 1.75;
		}

		.feature-link {
			margin-top: 30px;
			color: var(--gold);
			font-size: 12px;
			font-weight: 800;
			text-decoration: none;
			letter-spacing: .1em;
		}

		/* =========================
		   GALLERY
		========================= */

		.gallery-heading {
			display: flex;
			justify-content: space-between;
			align-items: end;
			margin-bottom: 45px;
		}

		.gallery-grid {
			display: grid;
			grid-template-columns: 1.5fr 1fr 1fr;
			grid-template-rows: 300px 300px;
			gap: 10px;
		}

		.gallery-item {
			overflow: hidden;
			background: var(--surface);
		}

		.gallery-item:first-child {
			grid-row: span 2;
		}

		.gallery-item img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			transition: transform .7s ease;
		}

		.gallery-item:hover img {
			transform: scale(1.04);
		}

		/* =========================
		   BOOKING
		========================= */

		.booking {
			text-align: center;
			padding: 150px 20px 170px;
			border-top: 1px solid var(--line);
		}

		.booking .section-title {
			margin: auto;
		}

		.booking-text {
			max-width: 580px;
			margin: 28px auto 35px;
			color: var(--muted);
			font-size: 17px;
			line-height: 1.7;
		}

		.booking-actions {
			display: flex;
			justify-content: center;
			gap: 12px;
		}

		/* =========================
		   FOOTER
		========================= */

		.footer {
			border-top: 1px solid var(--line);
			padding: 30px 5vw;
		}

		.footer-inner {
			max-width: var(--max);
			margin: auto;
			display: flex;
			justify-content: space-between;
			gap: 30px;
			color: #777;
			font-size: 11px;
			letter-spacing: .08em;
		}

		.footer-brand {
			color: white;
			font-weight: 800;
			letter-spacing: .15em;
		}

		/* =========================
		   MOBILE
		========================= */

		@media (max-width: 800px) {

			.nav {
				padding: 20px 22px;
			}

			.nav-links {
				display: none;
			}

			.hero {
				min-height: 680px;
				height: 88vh;
			}

			.hero-content {
				width: calc(100% - 44px);
				margin-top: 40px;
			}

			.hero h1 {
				font-size: clamp(70px, 21vw, 120px);
				max-width: 100%;
				word-break: break-word;
			}

			.hero-subtitle {
				font-size: 17px;
				max-width: 380px;
				margin-top: 28px;
			}

			.hero-location {
				right: 22px;
				bottom: 22px;
			}

			.section {
				width: calc(100% - 44px);
				padding: 85px 0;
			}

			.cinematic {
				width: calc(100% - 44px);
				padding: 70px 0 85px;
			}

			.cinematic-header {
				display: block;
			}

			.cinematic-note {
				margin-top: 20px;
			}

			.video-frame {
				aspect-ratio: 16 / 10;
			}

			.artist {
				grid-template-columns: 1fr;
				gap: 35px;
			}

			.artist-copy {
				margin: 0;
			}

			.experience-intro {
				grid-template-columns: 1fr;
				gap: 25px;
			}

			.performance-grid {
				grid-template-columns: 1fr;
			}

			.performance-card {
				min-height: 350px;
			}

			.feature {
				grid-template-columns: 1fr;
			}

			.feature-image {
				min-height: 480px;
			}

			.feature-copy {
				padding: 60px 25px;
			}

			.gallery-grid {
				grid-template-columns: 1fr 1fr;
				grid-template-rows: 250px 250px 250px;
			}

			.gallery-item:first-child {
				grid-row: span 1;
			}

			.gallery-item:last-child {
				grid-column: span 2;
			}

			.booking {
				padding: 100px 22px 120px;
			}

			.booking-actions {
				flex-direction: column;
				align-items: stretch;
			}

			.footer-inner {
				flex-direction: column;
				gap: 12px;
			}
		}

		@media (max-width: 500px) {

			.hero-actions {
				flex-direction: column;
				align-items: stretch;
				max-width: 230px;
			}

			.button {
				width: 100%;
			}

			.gallery-grid {
				grid-template-columns: 1fr;
				grid-template-rows: repeat(5, 320px);
			}

			.gallery-item:last-child {
				grid-column: auto;
			}

			.play {
				width: 62px;
				height: 62px;
			}
		}
	</style>
</head>

<body>

	<!-- =========================
	     NAVIGATION
	========================= -->

	<header class="nav">
		<div class="nav-inner">
			<a class="logo" href="/">
				ROUSHAN<span>.</span>
			</a>

			<nav class="nav-links">
				<a href="#about">ABOUT</a>
				<a href="#experience">EXPERIENCE</a>
				<a href="#gallery">GALLERY</a>
				<a href="#booking" class="nav-book">BOOK NOW</a>
			</nav>
		</div>
	</header>


	<main>

		<!-- =========================
		     HERO
		========================= -->

		<section class="hero">

			<img
				class="hero-image"
				src="/hero_live3.jpg"
				alt="Roushan performing live on stage in Patna"
				fetchpriority="high"
			/>

			<div class="hero-shade"></div>

			<div class="hero-content">

				<p class="eyebrow">
					SINGER • LIVE PERFORMER • PATNA
				</p>

				<h1>ROUSHAN</h1>

				<p class="hero-subtitle">
					Live music for weddings, celebrations
					and unforgettable events.
				</p>

				<div class="hero-actions">
					<a
						href="#booking"
						class="button button-primary"
					>
						BOOK ROUSHAN
					</a>

					<a
						href="#experience"
						class="button button-outline"
					>
						EXPLORE
					</a>
				</div>

			</div>

			<div class="hero-location">
				PATNA · BIHAR · INDIA
			</div>

		</section>


		<!-- =========================
		     CINEMATIC VIDEO
		========================= -->

		<section class="cinematic" id="video">

			<div class="cinematic-header">

				<div>
					<p class="label">ROUSHAN LIVE</p>

					<h2 class="section-title">
						Feel the performance.
					</h2>
				</div>

				<p class="cinematic-note">
					A short cinematic introduction to
					Roushan's live performance experience.
				</p>

			</div>

			<!--
				VIDEO PLACEHOLDER

				Later, replace this image block with
				your actual 10-second MP4 or YouTube video.
			-->

			<div class="video-frame">

				<img
					src="/hero_event_standing.jpeg"
					alt="Roushan live performance"
					loading="lazy"
				/>

				<div class="video-overlay">
					<div class="play">
						▶
					</div>
				</div>

				<div class="video-caption">
					10 SECOND CINEMATIC
				</div>

			</div>

		</section>


		<!-- =========================
		     ARTIST
		========================= -->

		<section class="section artist" id="about">

			<div>

				<p class="label">
					THE ARTIST
				</p>

				<h2 class="section-title">
					Music that makes
					the moment.
				</h2>

			</div>

			<div class="artist-copy">

				<p>
					Roushan is a singer and live performer
					based in Patna, bringing music, energy
					and a personal touch to weddings,
					events, birthdays, celebrations and
					private occasions.
				</p>

				<div class="artist-line"></div>

				<p>
					From intimate gatherings to energetic
					live events, every performance is shaped
					around the atmosphere of the occasion.
				</p>

			</div>

		</section>


		<!-- =========================
		     EXPERIENCE
		========================= -->

		<section class="section" id="experience">

			<div class="experience-intro">

				<div>

					<p class="label">
						PERFORMANCES
					</p>

					<h2 class="section-title">
						Available for
						your special moments.
					</h2>

				</div>

				<p class="experience-note">
					Choose the kind of occasion and we'll
					shape the performance around the
					atmosphere you want.
				</p>

			</div>


			<div class="performance-grid">

				<!-- WEDDINGS -->

				<article class="performance-card">

					<img
						src="/hero_casula_standing.jpg"
						alt="Roushan for wedding performance"
						loading="lazy"
					/>

					<div class="performance-icon">
						♡
					</div>

					<div class="performance-content">

						<span class="performance-number">
							01
						</span>

						<h3>
							Weddings
						</h3>

						<p>
							Live music for wedding celebrations,
							sangeet and unforgettable moments.
						</p>

					</div>

				</article>


				<!-- EVENTS -->

				<article class="performance-card">

					<img
						src="/hero_event.jpeg"
						alt="Roushan performing at an event"
						loading="lazy"
					/>

					<div class="performance-icon">
						♪ 
					</div>

					<div class="performance-content">

						<span class="performance-number">
							02
						</span>

						<h3>
							Events
						</h3>

						<p>
							Live performances for private,
							social and special events.
						</p>

					</div>

				</article>


				<!-- BIRTHDAYS -->

				<article class="performance-card">

					<img
						src="/hero_sitting_sofa.jpg"
						alt="Roushan portrait"
						loading="lazy"
					/>

					<div class="performance-icon">
						✦
					</div>

					<div class="performance-content">

						<span class="performance-number">
							03
						</span>

						<h3>
							Birthdays
						</h3>

						<p>
							Make birthdays and celebrations
							more memorable with live music.
						</p>

					</div>

				</article>


				<!-- CORPORATE -->

				<article class="performance-card">

					<img
						src="/hero_standinf_close.jpg"
						alt="Roushan available for professional events"
						loading="lazy"
					/>

					<div class="performance-icon">
						◇
					</div>

					<div class="performance-content">

						<span class="performance-number">
							04
						</span>

						<h3>
							Corporate
						</h3>

						<p>
							Professional live entertainment
							for corporate events and gatherings.
						</p>

