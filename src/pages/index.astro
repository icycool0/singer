---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead
		title={SITE_TITLE}
		description={SITE_DESCRIPTION}
	/>

	<style>
		/* =========================================================
		   RESET
		========================================================= */

		:root {
			--black: #080809;
			--black-soft: #101012;
			--white: #f5f3ee;
			--muted: #969493;
			--gold: #d6b477;
			--line: rgba(255,255,255,.10);
		}

		*,
		*::before,
		*::after {
			box-sizing: border-box;
		}

		html {
			scroll-behavior: smooth;
			background: var(--black);
		}

		body {
			margin: 0 !important;
			padding: 0 !important;
			background: var(--black) !important;
			color: var(--white);
			font-family:
				Inter,
				-apple-system,
				BlinkMacSystemFont,
				"Segoe UI",
				Roboto,
				Arial,
				sans-serif;
			overflow-x: hidden;
		}

		/* IMPORTANT:
		   Override Astro starter CSS */
		main {
			width: 100% !important;
			max-width: none !important;
			margin: 0 !important;
			padding: 0 !important;
		}

		img {
			display: block;
			max-width: 100%;
		}

		a {
			color: inherit;
		}


		/* =========================================================
		   NAVIGATION
		========================================================= */

		.site-nav {
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			z-index: 50;

			border-bottom: 1px solid rgba(255,255,255,.10);
			background: linear-gradient(
				to bottom,
				rgba(0,0,0,.45),
				transparent
			);
		}

		.nav-inner {
			width: min(1380px, calc(100% - 70px));
			height: 86px;
			margin: auto;

			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		.logo {
			text-decoration: none;
			font-size: 21px;
			font-weight: 800;
			letter-spacing: .08em;
		}

		.logo span {
			color: var(--gold);
		}

		.nav-links {
			display: flex;
			align-items: center;
			gap: 34px;
		}

		.nav-links a {
			text-decoration: none;
			font-size: 11px;
			font-weight: 600;
			letter-spacing: .14em;
			color: rgba(255,255,255,.78);
			transition: color .25s ease;
		}

		.nav-links a:hover {
			color: white;
		}

		.nav-book {
			padding: 13px 19px;
			border: 1px solid rgba(214,180,119,.7);
			color: var(--gold) !important;
		}

		.nav-book:hover {
			background: var(--gold);
			color: #111 !important;
		}


		/* =========================================================
		   HERO
		========================================================= */

		.hero {
			position: relative;
			width: 100%;
			height: min(900px, 100vh);
			min-height: 680px;
			overflow: hidden;

			display: flex;
			align-items: flex-end;
		}

		.hero-image {
			position: absolute;
			inset: 0;

			width: 100%;
			height: 100%;

			object-fit: cover;
			object-position: center 30%;

			transform: scale(1.01);
		}

		.hero-overlay {
			position: absolute;
			inset: 0;

			background:
				linear-gradient(
					90deg,
					rgba(0,0,0,.82) 0%,
					rgba(0,0,0,.48) 42%,
					rgba(0,0,0,.12) 100%
				),
				linear-gradient(
					0deg,
					rgba(0,0,0,.85) 0%,
					rgba(0,0,0,.12) 55%,
					rgba(0,0,0,.20) 100%
				);
		}

		.hero-content {
			position: relative;
			z-index: 2;

			width: min(1380px, calc(100% - 70px));
			margin: auto;

			padding-bottom: 100px;
		}

		.eyebrow,
		.section-label {
			margin: 0;

			font-size: 10px;
			font-weight: 700;
			letter-spacing: .25em;
			text-transform: uppercase;

			color: var(--gold);
		}

		.hero h1 {
			margin: 18px 0 25px;

			max-width: 900px;

			font-size: clamp(76px, 12vw, 175px);
			line-height: .80;
			letter-spacing: -.065em;
			font-weight: 850;
		}

		.hero-subtitle {
			max-width: 560px;

			margin: 0;

			font-size: clamp(17px, 2vw, 23px);
			line-height: 1.5;

			color: rgba(255,255,255,.82);
		}

		.hero-actions {
			display: flex;
			gap: 13px;
			margin-top: 34px;
		}

		.button {
			display: inline-flex;
			align-items: center;
			justify-content: center;

			min-height: 48px;
			padding: 0 23px;

			text-decoration: none;

			font-size: 10px;
			font-weight: 800;
			letter-spacing: .16em;

			transition:
				transform .25s ease,
				background .25s ease,
				color .25s ease;
		}

		.button-primary {
			background: var(--gold);
			color: #111;
		}

		.button-primary:hover {
			background: #ecd29b;
			transform: translateY(-2px);
		}

		.button-outline {
			border: 1px solid rgba(255,255,255,.55);
			color: white;
		}

		.button-outline:hover {
			background: white;
			color: #111;
			transform: translateY(-2px);
		}

		.hero-location {
			position: absolute;
			right: 35px;
			bottom: 35px;

			z-index: 3;

			font-size: 9px;
			font-weight: 700;
			letter-spacing: .18em;
			text-transform: uppercase;

			color: rgba(255,255,255,.55);
		}


		/* =========================================================
		   COMMON SECTIONS
		========================================================= */

		.section {
			width: min(1380px, calc(100% - 70px));
			margin: auto;
			padding: 135px 0;
		}

		.section-title {
			margin: 16px 0 0;

			font-size: clamp(42px, 5vw, 72px);
			line-height: .98;
			letter-spacing: -.045em;
			font-weight: 750;
		}


		/* =========================================================
		   ABOUT
		========================================================= */

		.intro {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 110px;
			align-items: start;
		}

		.intro-text {
			margin: 37px 0 0;

			max-width: 560px;

			font-size: 19px;
			line-height: 1.8;
			color: var(--muted);
		}


		/* =========================================================
		   PERFORMANCE CARDS
		========================================================= */

		.services-header {
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			gap: 70px;

			margin-bottom: 58px;
		}

		.services-header > div {
			max-width: 700px;
		}

		.services-note {
			max-width: 400px;
			margin: 0;

			font-size: 15px;
			line-height: 1.7;

			color: var(--muted);
		}

		.service-grid {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 18px;
		}

		.service-card {
			position: relative;

			display: block;

			height: 520px;

			overflow: hidden;

			background: #111;

			border: 1px solid var(--line);

			text-decoration: none;
		}

		.service-card img {
			position: absolute;
			inset: 0;

			width: 100%;
			height: 100%;

			object-fit: cover;

			transition:
				transform .8s cubic-bezier(.2,.7,.2,1),
				filter .8s ease;
		}

		.service-overlay {
			position: absolute;
			inset: 0;

			background:
				linear-gradient(
					180deg,
					rgba(0,0,0,.08) 0%,
					rgba(0,0,0,.10) 30%,
					rgba(0,0,0,.90) 100%
				);
		}

		.service-content {
			position: absolute;
			inset: 0;

			z-index: 2;

			padding: 34px;

			display: flex;
			flex-direction: column;
			justify-content: flex-end;
		}

		.service-number {
			position: absolute;
			top: 31px;
			left: 34px;

			font-size: 10px;
			font-weight: 700;
			letter-spacing: .20em;

			color: var(--gold);
		}

		.service-icon {
			width: 39px;
			height: 39px;

			display: flex;
			align-items: center;
			justify-content: center;

			margin-bottom: 15px;

			border: 1px solid rgba(214,180,119,.75);
			border-radius: 50%;

			color: var(--gold);

			font-size: 17px;

			transition:
				background .3s ease,
				color .3s ease;
		}

		.service-card h3 {
			margin: 0 0 12px;

			font-size: clamp(32px, 3vw, 46px);
			line-height: 1;
			letter-spacing: -.04em;

			color: white;
		}

		.service-card p {
			max-width: 390px;

			margin: 0 0 20px;

			font-size: 15px;
			line-height: 1.6;

			color: rgba(255,255,255,.72);
		}

		.service-link {
			font-size: 9px;
			font-weight: 800;
			letter-spacing: .18em;

			color: var(--gold);
		}

		.service-card:hover img {
			transform: scale(1.07);
		}

		.service-card:hover .service-icon {
			background: var(--gold);
			color: #111;
		}


		/* =========================================================
		   FEATURE
		========================================================= */

		.feature {
			width: 100%;

			display: grid;
			grid-template-columns: 1.15fr .85fr;

			background: #111113;
		}

		.feature-image-wrap {
			min-height: 720px;
			overflow: hidden;
		}

		.feature-image {
			width: 100%;
			height: 100%;

			min-height: 720px;

			object-fit: cover;
		}

		.feature-content {
			padding: 100px 80px;

			display: flex;
			flex-direction: column;
			justify-content: center;
		}

		.feature-content h2 {
			margin: 18px 0 25px;

			font-size: clamp(42px, 5vw, 70px);
			line-height: .98;
			letter-spacing: -.045em;
		}

		.feature-content p:not(.section-label) {
			max-width: 500px;

			margin: 0;

			font-size: 17px;
			line-height: 1.75;

			color: var(--muted);
		}

		.feature-link {
			margin-top: 30px;

			font-size: 10px;
			font-weight: 800;
			letter-spacing: .17em;

			color: var(--gold);

			text-decoration: none;
		}


		/* =========================================================
		   GALLERY
		========================================================= */

		.gallery-heading {
			margin-bottom: 55px;
		}

		.gallery-grid {
			display: grid;

			grid-template-columns: 1.35fr .8fr .8fr;

			grid-template-rows: 300px 300px;

			gap: 12px;
		}

		.gallery-item {
			position: relative;
			overflow: hidden;
			background: #111;
		}

		.gallery-item:first-child {
			grid-row: span 2;
		}

		.gallery-item img {
			width: 100%;
			height: 100%;

			object-fit: cover;

			transition: transform .7s ease;
		}

		.gallery-item:hover img {
			transform: scale(1.04);
		}


		/* =========================================================
		   VIDEO
		========================================================= */

		.video-section {
			padding-top: 80px;
		}

		.video-box {
			position: relative;

			width: 100%;
			aspect-ratio: 16 / 9;

			margin-top: 50px;

			overflow: hidden;

			background: #111;
		}

		.video-box img {
			width: 100%;
			height: 100%;

			object-fit: cover;

			filter: brightness(.62);
		}

		.video-overlay {
			position: absolute;
			inset: 0;

			display: flex;
			align-items: center;
			justify-content: center;
		}

		.play-button {
			width: 78px;
			height: 78px;

			display: flex;
			align-items: center;
			justify-content: center;

			border: 1px solid rgba(255,255,255,.8);
			border-radius: 50%;

			color: white;

			font-size: 18px;
			padding-left: 4px;
		}

		.video-caption {
			position: absolute;
			left: 30px;
			bottom: 25px;

			font-size: 9px;
			font-weight: 700;
			letter-spacing: .18em;

			color: white;
		}


		/* =========================================================
		   BOOKING
		========================================================= */

		.booking {
			text-align: center;
			padding-top: 150px;
			padding-bottom: 170px;
		}

		.booking .section-title {
			margin-top: 18px;
		}

		.booking-text {
			max-width: 600px;

			margin: 28px auto 35px;

			font-size: 17px;
			line-height: 1.75;

			color: var(--muted);
		}

		.booking-actions {
			display: flex;
			justify-content: center;
			gap: 12px;
		}


		/* =========================================================
		   FOOTER
		========================================================= */

		.site-footer {
			border-top: 1px solid var(--line);
			background: #080809;
		}

		.footer-inner {
			width: min(1380px, calc(100% - 70px));
			margin: auto;

			min-height: 130px;

			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 30px;
		}

		.footer-brand {
			font-size: 18px;
			font-weight: 800;
			letter-spacing: .08em;
		}

		.footer-info {
			margin: 0;

			font-size: 10px;
			letter-spacing: .08em;

			color: var(--muted);
		}


		/* =========================================================
		   TABLET
		========================================================= */

		@media (max-width: 900px) {

			.nav-inner,
			.hero-content,
			.section,
			.footer-inner {
				width: min(100% - 44px, 700px);
			}

			.nav-links {
				gap: 16px;
			}

			.nav-links a:not(.nav-book) {
				display: none;
			}

			.hero {
				min-height: 700px;
			}

			.hero-content {
				padding-bottom: 70px;
			}

			.hero-location {
				right: 22px;
				bottom: 22px;
			}

			.intro {
				grid-template-columns: 1fr;
				gap: 25px;
			}

			.intro-text {
				margin-top: 0;
			}

			.services-header {
				display: block;
			}

			.services-note {
				margin-top: 25px;
			}

			.feature {
				grid-template-columns: 1fr;
			}

			.feature-image-wrap,
			.feature-image {
				min-height: 550px;
			}

			.feature-content {
				padding: 70px 35px;
			}
		}


		/* =========================================================
		   MOBILE
		========================================================= */

		@media (max-width: 600px) {

			.nav-inner,
			.hero-content,
			.section,
			.footer-inner {
				width: calc(100% - 36px);
			}

			.site-nav {
				background: rgba(0,0,0,.35);
			}

			.nav-inner {
				height: 72px;
			}

			.logo {
				font-size: 18px;
			}

			.nav-book {
				padding: 10px 13px;
				font-size: 9px !important;
			}

			.hero {
				height: 760px;
				min-height: 760px;
			}

			.hero-image {
				object-position: 58% center;
			}

			.hero-content {
				padding-bottom: 62px;
			}

			.hero h1 {
				font-size: clamp(64px, 19vw, 105px);
				max-width: 100%;
				margin-bottom: 20px;
			}

			.hero-subtitle {
				font-size: 16px;
				max-width: 330px;
			}

			.hero-actions {
				flex-direction: column;
				align-items: flex-start;
			}

			.button {
				width: auto;
				min-width: 155px;
			}

			.hero-location {
				display: none;
			}

			.section {
				padding: 90px 0;
			}

			.section-title {
				font-size: 43px;
			}

			.service-grid {
				grid-template-columns: 1fr;
			}

			.service-card {
				height: 450px;
			}

			.service-content {
				padding: 26px;
			}

			.service-number {
				left: 26px;
				top: 26px;
			}

			.feature-image-wrap,
			.feature-image {
				min-height: 460px;
			}

			.feature-content {
				padding: 60px 22px;
			}

			.feature-content h2 {
				font-size: 43px;
			}

			.gallery-grid {
				grid-template-columns: 1fr 1fr;
				grid-template-rows: 250px 250px 250px;
			}

			.gallery-item:first-child {
				grid-row: span 1;
			}

			.gallery-item:last-child {
				grid-column: span 2;
			}

			.video-box {
				margin-top: 35px;
			}

			.play-button {
				width: 62px;
				height: 62px;
			}

			.booking {
				padding-top: 100px;
				padding-bottom: 110px;
			}

			.booking-actions {
				flex-direction: column;
				align-items: center;
			}

			.footer-inner {
				min-height: 160px;

				flex-direction: column;
				justify-content: center;

				text-align: center;
			}
		}
	</style>
</head>


<body>

	<!-- =====================================================
	     NAVIGATION
	===================================================== -->

	<header class="site-nav">
		<div class="nav-inner">

			<a href="/" class="logo">
				ROUSHAN<span>.</span>
			</a>

			<nav class="nav-links">
				<a href="#about">ABOUT</a>
				<a href="#experience">EXPERIENCE</a>
				<a href="#gallery">GALLERY</a>
				<a href="#video">VIDEOS</a>

				<a href="#booking" class="nav-book">
					BOOK NOW
				</a>
			</nav>

		</div>
	</header>


	<main>

		<!-- =====================================================
		     HERO
		===================================================== -->

		<section class="hero">

			<img
				class="hero-image"
				src="/hero_live3.jpg"
				alt="Roushan performing live on stage"
				fetchpriority="high"
			/>

			<div class="hero-overlay"></div>

			<div class="hero-content">

				<p class="eyebrow">
					SINGER • LIVE PERFORMER • PATNA
				</p>

				<h1>
					ROUSHAN
				</h1>

				<p class="hero-subtitle">
					Live music for weddings, celebrations
					and unforgettable events.
				</p>

				<div class="hero-actions">

					<a
						href="#booking"
						class="button button-primary"
					>
						BOOK ROUSHAN
					</a>

					<a
						href="#experience"
						class="button button-outline"
					>
						EXPLORE
					</a>

				</div>

			</div>

			<div class="hero-location">
				PATNA · BIHAR · INDIA
			</div>

		</section>


		<!-- =====================================================
		     ABOUT
		===================================================== -->

		<section class="section intro" id="about">

			<div>

				<p class="section-label">
					THE ARTIST
				</p>

				<h2 class="section-title">
					Music that makes the moment.
				</h2>

			</div>

			<p class="intro-text">
				Roushan is a singer and live performer based in Patna,
				bringing music, energy and a personal touch to weddings,
				events, birthdays, celebrations and private occasions.
			</p>

		</section>


		<!-- =====================================================
		     PERFORMANCES
		===================================================== -->

		<section
			class="section"
			id="experience"
		>

			<div class="services-header">

				<div>

					<p class="section-label">
						PERFORMANCES
					</p>

					<h2 class="section-title">
						Available for your special moments.
					</h2>

				</div>

				<p class="services-note">
					From intimate celebrations to energetic live events,
					Roushan brings music and presence to every occasion.
				</p>

			</div>


			<div class="service-grid">


				<!-- WEDDINGS -->

				<a
					href="#booking"
					class="service-card"
				>

					<img
						src="/hero_event_standing.jpeg"
						alt="Roushan performing at a wedding event"
						loading="lazy"
					/>

					<div class="service-overlay"></div>

					<div class="service-content">

						<span class="service-number">
							01
						</span>

						<div class="service-icon">
							✦
						</div>

						<h3>
							Weddings
						</h3>

						<p>
							Live music for weddings, sangeet
							and unforgettable celebrations.
						</p>

						<span class="service-link">
							PLAN YOUR WEDDING →
						</span>

					</div>

				</a>


				<!-- EVENTS -->

				<a
					href="#booking"
					class="service-card"
				>

					<img
						src="/hero_event.jpeg"
						alt="Roushan performing live at an event"
						loading="lazy"
					/>

					<div class="service-overlay"></div>

					<div class="service-content">

						<span class="service-number">
							02
						</span>

						<div class="service-icon">
							♪
						</div>

						<h3>
							Events
						</h3>

						<p>
							Live performances for private,
							social and special events.
						</p>

						<span class="service-link">
							BOOK FOR YOUR EVENT →
						</span>

					</div>

				</a>


				<!-- BIRTHDAYS -->

				<a
